        </form>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
</dialog>

<!-- Edit Row Modal -->
<dialog id="editRowModal" class="modal">
    <div class="modal-box max-w-2xl bg-base-100 border border-base-300 rounded-2xl shadow-2xl">
        <h3 class="font-bold text-lg flex items-center gap-2 border-b border-base-300 pb-3">
            <i class="fas fa-edit text-info"></i> Edit Record in <span class="font-mono text-info">{{ selected_table }}</span>
        </h3>
        
        <form id="editRowForm" onsubmit="submitEditRow(event)" class="space-y-4 mt-4 max-h-[60vh] overflow-y-auto pr-1">
            <input type="hidden" name="table" value="{{ selected_table }}">
            <div id="editFieldsContainer" class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <!-- Dynamically populated -->
            </div>

            <div class="modal-action border-t border-base-300 pt-3">
                <button type="button" onclick="document.getElementById('editRowModal').close()" class="btn btn-ghost btn-sm">Cancel</button>
                <button type="submit" class="btn btn-info btn-sm gap-2" id="saveEditRowBtn">
                    <i class="fas fa-check"></i> Update Record
                </button>
            </div>
        </form>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
</dialog>

<!-- Toast Container for Notifications -->
<div id="toastContainer" class="toast toast-bottom toast-end z-[9999] p-4 pointer-events-none"></div>

<script>
let currentColumns = {{ table_data.columns|json_encode|raw }};
let tableRows = {{ table_data.rows|json_encode|raw }};
let selectedTable = "{{ selected_table }}";
let activeInspectRow = null;
let activeEditPk = {};
let isDbEditingUnlocked = false;

// ── View Switching ──────────────────────────────────────────────────────────
function switchDbView(mode) {
    const gridView = document.getElementById('dbGridView');
    const cardView = document.getElementById('dbCardView');
    const kanbanView = document.getElementById('dbKanbanView');
    const btnGrid = document.getElementById('btnViewGrid');
    const btnCard = document.getElementById('btnViewCard');
    const btnKanban = document.getElementById('btnViewKanban');

    [btnGrid, btnCard, btnKanban].forEach(b => {
        b.classList.remove('btn-active', 'btn-primary');
        b.classList.add('btn-ghost');
    });

    gridView.classList.add('hidden');
    cardView.classList.add('hidden');
    kanbanView.classList.add('hidden');

    if (mode === 'card') {
        cardView.classList.remove('hidden');
        btnCard.classList.add('btn-active', 'btn-primary');
        btnCard.classList.remove('btn-ghost');
    } else if (mode === 'kanban') {
        kanbanView.classList.remove('hidden');
        btnKanban.classList.add('btn-active', 'btn-primary');
        btnKanban.classList.remove('btn-ghost');
        renderKanbanBoard();
    } else {
        gridView.classList.remove('hidden');
        btnGrid.classList.add('btn-active', 'btn-primary');
        btnGrid.classList.remove('btn-ghost');
    }
}

// ── Kanban Board Rendering ──────────────────────────────────────────────────
function renderKanbanBoard() {
    const board = document.getElementById('kanbanBoard');
    if (!board) return;
    board.innerHTML = '';

    // Determine grouping column (Func, Type, Status, or fallback)
    let groupCol = 'Func';
    const colNames = currentColumns.map(c => c.column_name);
    if (colNames.includes('Func')) groupCol = 'Func';
    else if (colNames.includes('Type')) groupCol = 'Type';
    else if (colNames.includes('status')) groupCol = 'status';
    else if (colNames.length > 0) groupCol = colNames[0];

    const groups = {};
    tableRows.forEach(row => {
        const val = row[groupCol] !== null ? String(row[groupCol]) : 'Empty';
        if (!groups[val]) groups[val] = [];
        groups[val].push(row);
    });

    Object.keys(groups).forEach(gName => {
        const colDiv = document.createElement('div');
        colDiv.className = 'kanban-col bg-base-200 border border-base-300 rounded-2xl p-3 flex flex-col shrink-0 space-y-3';
        
        const count = groups[gName].length;
        colDiv.innerHTML = `
            <div class="flex items-center justify-between border-b border-base-300 pb-2 px-1">
                <span class="font-bold text-xs uppercase tracking-wider text-base-content/80 flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-primary"></span>
                    ${escapeHtml(gName)}
                </span>
                <span class="badge badge-sm badge-neutral font-mono text-[10px]">${count}</span>
            </div>
            <div class="space-y-2.5 flex-1 overflow-y-auto max-h-[600px] pr-1">
                ${groups[gName].map(row => {
                    const rowKey = row.Code || row.id || 'Row';
                    return `
                        <div class="bg-base-100 border border-base-300 rounded-xl p-3 shadow-xs hover:border-primary/40 transition-all cursor-pointer"
                             onclick='openInspectRowModal(${JSON.stringify(row).replace(/'/g, "&#39;")})'>
                            <div class="font-mono font-bold text-xs text-primary mb-1">#${escapeHtml(String(rowKey))}</div>
                            <div class="text-[11px] text-base-content/70 space-y-0.5">
                                ${Object.keys(row).slice(0, 4).map(k => `
                                    <div class="flex justify-between gap-1">
                                        <span class="text-base-content/40">${escapeHtml(k)}:</span>
                                        <span class="truncate text-right font-mono">${escapeHtml(formatDateUser(row[k]))}</span>
                                    </div>
                                `).join('')}
                            </div>
                        </div>
                    `;
                }).join('')}
            </div>
        `;
        board.appendChild(colDiv);
    });
}

// ── Column Visibility ───────────────────────────────────────────────────────
function toggleColumnVisibility(colName, isVisible) {
    const cells = document.querySelectorAll(`[data-col="${colName}"]`);
    cells.forEach(el => {
        if (isVisible) el.classList.remove('hidden');
        else el.classList.add('hidden');
    });
}

function toggleAllColumns(show) {
    document.querySelectorAll('[data-col-toggle]').forEach(cb => {
        cb.checked = show;
        toggleColumnVisibility(cb.dataset.colToggle, show);
    });
}

// ── Row Density ─────────────────────────────────────────────────────────────
let isCompact = false;
function toggleDensity() {
    isCompact = !isCompact;
    const table = document.getElementById('mainDbTable');
    const label = document.getElementById('densityLabel');
    if (isCompact) {
        table.classList.add('table-compact');
        label.textContent = 'Normal';
    } else {
        table.classList.remove('table-compact');
        label.textContent = 'Compact';
    }
}

// ── Cell Click & Direct Inline Edit ─────────────────────────────────────────
function handleCellClick(cellEl, rowData, colName, colType) {
    if (!isDbEditingUnlocked) {
        return;
    }
    makeCellEditable(cellEl, rowData, colName, colType);
}

function formatCellHtml(val, colName, colTypeLower) {
    if (val === null || val === undefined || val === '') {
        return '<span class="text-base-content/20 italic font-sans text-[11px]">NULL</span>';
    }
    const strVal = String(val);
    const colLower = (colName || '').toLowerCase();
    
    if (val === true || val === 't' || val === 'true') {
        return '<span class="badge badge-xs badge-success gap-1 font-bold text-[10px]"><i class="fas fa-check text-[9px]"></i> TRUE</span>';
    }
    if (val === false || val === 'f' || val === 'false') {
        return '<span class="badge badge-xs badge-ghost text-[10px]">FALSE</span>';
    }
    if (['code', 'client_id', 'client_code', 'ext_client_code'].includes(colLower) && strVal !== '') {
        return `<a href="/finances?client=${encodeURIComponent(strVal)}" title="Open client in Finances" onclick="event.stopPropagation()" class="inline-flex items-center gap-1 font-mono font-bold text-primary hover:underline bg-primary/10 hover:bg-primary/20 px-2 py-0.5 rounded transition-colors text-xs"><i class="fas fa-user-circle text-[11px] opacity-70"></i>${escapeHtml(strVal)}</a>`;
    }
    if (['tgid', 'telegram_id'].includes(colLower) && strVal !== '') {
        return `<a href="https://t.me/${encodeURIComponent(strVal.replace('@',''))}" target="_blank" onclick="event.stopPropagation()" class="inline-flex items-center gap-1 font-mono font-medium text-info hover:underline bg-info/10 hover:bg-info/20 px-2 py-0.5 rounded transition-colors text-xs"><i class="fab fa-telegram-plane text-[11px]"></i>${escapeHtml(strVal)}</a>`;
    }
    if (['vless_id', 'uuid'].includes(colLower) && strVal !== '') {
        return `<span onclick="event.stopPropagation(); copyToClipboard('${escapeHtml(strVal)}', 'UUID copied!')" title="Click to copy full UUID" class="cursor-pointer font-mono text-[11px] text-base-content/80 inline-flex items-center gap-1 bg-base-200 hover:bg-base-300 px-1.5 py-0.5 rounded border border-base-300 transition-colors"><span>${escapeHtml(strVal.substring(0, 8))}…</span><i class="far fa-copy text-[10px] opacity-40"></i></span>`;
    }
    if (['func', 'status', 'type'].includes(colLower)) {
        const valUpper = strVal.toUpperCase();
        if (['WORK', 'INCOME', 'ACTIVE', 'COMPLETED', 'PAID'].includes(valUpper)) {
            return `<span class="badge badge-xs badge-success gap-1 font-bold text-[10px]"><i class="fas fa-circle text-[6px]"></i>${escapeHtml(strVal)}</span>`;
        } else if (['PAUSE', 'EXPENSE', 'EXPIRED', 'CANCELLED', 'FAILED'].includes(valUpper)) {
            return `<span class="badge badge-xs badge-warning gap-1 font-bold text-[10px]"><i class="fas fa-circle text-[6px]"></i>${escapeHtml(strVal)}</span>`;
        } else {
            return `<span class="badge badge-xs badge-neutral text-[10px]">${escapeHtml(strVal)}</span>`;
        }
    }
    if (['amount', 'price', 'cost', 'total_income', 'total_expense'].includes(colLower)) {
        const num = parseFloat(strVal);
        const formatted = !isNaN(num) ? num.toLocaleString('ru-RU', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : strVal;
        const colorClass = num > 0 ? 'text-emerald-400' : num < 0 ? 'text-amber-400' : '';
        return `<span class="font-mono font-semibold ${colorClass}">₽${formatted}</span>`;
    }
    if (['date', 'start_date', 'created_at', 'updated_at', 'last_login_at', 'last_handshake', 'last_payment_date'].includes(colLower) && strVal !== '') {
        const formattedDate = formatDateUser(strVal);
        return `<span class="inline-flex items-center gap-1 font-mono text-[11px] text-base-content/80 bg-base-200 px-1.5 py-0.5 rounded border border-base-300"><i class="far fa-clock text-[10px] opacity-40"></i>${escapeHtml(formattedDate)}</span>`;
    }
    if (['domain', 'router', 'server_ip', 'ip'].includes(colLower) && strVal !== '') {
        return `<span onclick="event.stopPropagation(); copyToClipboard('${escapeHtml(strVal)}', 'Copied!')" title="Click to copy" class="cursor-pointer font-mono text-xs text-info hover:underline inline-flex items-center gap-1 bg-info/5 px-1.5 py-0.5 rounded border border-info/20"><i class="fas fa-globe text-[10px] opacity-60"></i>${escapeHtml(strVal)}</span>`;
    }
    return `<span class="text-base-content/90">${escapeHtml(strVal)}</span>`;
}

function makeCellEditable(cellEl, rowData, colName, colType) {
    if (cellEl.dataset.editing === 'true') return;
    cellEl.dataset.editing = 'true';
    cellEl.classList.add('db-table-cell-editing');

    const origVal = rowData[colName] !== null ? String(rowData[colName]) : '';
    const colLower = colName.toLowerCase();
    const origContent = cellEl.innerHTML;

    let input;
    if (colLower === 'func' && selectedTable === 'Clients') {
        input = document.createElement('select');
        input.className = 'select select-xs select-primary w-full font-mono text-xs';
        input.innerHTML = `
            <option value="WORK" ${origVal === 'WORK' ? 'selected' : ''}>WORK</option>
            <option value="PAUSE" ${origVal === 'PAUSE' ? 'selected' : ''}>PAUSE</option>
        `;
    } else if (colLower === 'type' && selectedTable === 'Finances_2026') {
        input = document.createElement('select');
        input.className = 'select select-xs select-primary w-full font-mono text-xs';
        input.innerHTML = `
            <option value="Income" ${origVal.toLowerCase() === 'income' ? 'selected' : ''}>Income</option>
            <option value="Expense" ${origVal.toLowerCase() === 'expense' ? 'selected' : ''}>Expense</option>
        `;
    } else {
        input = document.createElement('input');
        input.type = 'text';
        input.value = ['date', 'start_date', 'created_at', 'updated_at', 'last_payment_date'].includes(colLower) ? formatDateUser(origVal) : origVal;
        input.placeholder = ['date', 'start_date', 'created_at', 'updated_at', 'last_payment_date'].includes(colLower) ? 'DD.MM.YYYY' : '';
        input.className = 'input input-xs input-primary w-full font-mono text-xs';
    }

    cellEl.innerHTML = '';
    cellEl.appendChild(input);
    input.focus();
    if (input.select) input.select();

    async function saveCell() {
        let newVal = input.value.trim();
        if (newVal === origVal || (newVal === formatDateUser(origVal) && ['date', 'start_date', 'created_at', 'updated_at', 'last_payment_date'].includes(colLower))) {
            cellEl.innerHTML = origContent;
            cellEl.classList.remove('db-table-cell-editing');
            delete cellEl.dataset.editing;
            return;
        }

        let pk = {};
        if (rowData.hasOwnProperty('id') && rowData.id !== null) {
            pk = { id: rowData.id };
        } else if (rowData.hasOwnProperty('Code') && rowData.Code !== null) {
            pk = { Code: rowData.Code };
        } else if (currentColumns.length > 0) {
            const firstCol = currentColumns[0].column_name;
            pk[firstCol] = rowData[firstCol];
        }

        const updates = {};
        updates[colName] = newVal;

        try {
            const res = await fetch('/api/db-manager/row-update', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': '{{ csrf_token }}'
                },
                body: JSON.stringify({
                    table: selectedTable,
                    pk: pk,
                    updates: updates
                })
            });
            const json = await res.json();
            if (json.success) {
                showToast(`Updated ${colName} successfully!`);
                rowData[colName] = newVal;
                cellEl.innerHTML = formatCellHtml(newVal, colName, colType);
                cellEl.dataset.val = newVal;
                cellEl.classList.remove('db-table-cell-editing');
                delete cellEl.dataset.editing;

                // Live flash animation
                cellEl.classList.add('bg-success/20', 'transition-colors', 'duration-700');
                setTimeout(() => cellEl.classList.remove('bg-success/20'), 800);
            } else {
                showToast('Update failed: ' + (json.error || 'Unknown error'), 'error');
                cellEl.innerHTML = origContent;
                cellEl.classList.remove('db-table-cell-editing');
                delete cellEl.dataset.editing;
            }
        } catch (e) {
            showToast('Error: ' + e.message, 'error');
            cellEl.innerHTML = origContent;
            cellEl.classList.remove('db-table-cell-editing');
            delete cellEl.dataset.editing;
        }
    }

    input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
            e.preventDefault();
            saveCell();
        } else if (e.key === 'Escape') {
            cellEl.innerHTML = origContent;
            cellEl.classList.remove('db-table-cell-editing');
            delete cellEl.dataset.editing;
        }
    });

    input.addEventListener('blur', () => {
        if (cellEl.dataset.editing === 'true') {
            saveCell();
        }
    });
}

// ── Toast System ────────────────────────────────────────────────────────────
function showToast(message, type = 'success') {
    const container = document.getElementById('toastContainer');
    if (!container) return;
    const toast = document.createElement('div');
    const bgClass = type === 'error' ? 'alert-error' : type === 'warning' ? 'alert-warning' : 'alert-success';
    const icon = type === 'error' ? 'fa-exclamation-triangle' : 'fa-check-circle';
    toast.className = `alert ${bgClass} shadow-2xl text-xs font-sans py-2.5 px-4 flex items-center gap-2 rounded-xl text-white pointer-events-auto transition-all transform duration-300 translate-y-2 opacity-0`;
    toast.innerHTML = `<i class="fas ${icon}"></i> <span>${escapeHtml(message)}</span>`;
    container.appendChild(toast);

    requestAnimationFrame(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
    });

    setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 300);
    }, 2800);
}

function copyToClipboard(text, noticeMsg = 'Copied to clipboard!') {
    if (!text) return;
    navigator.clipboard.writeText(text).then(() => {
        showToast(noticeMsg);
    }).catch(() => {
        showToast('Failed to copy', 'error');
    });
}

// ── Date Formatter (DD.MM.YYYY [HH:mm]) ──────────────────────────────────────
function formatDateUser(dateStr) {
    if (!dateStr) return '-';
    const str = String(dateStr).trim();
    if (str === '' || str === '-' || str.toLowerCase() === 'null') return '-';
    const match = str.match(/^(\d{4})-(\d{2})-(\d{2})(?:[T\s](\d{2}:\d{2}(?::\d{2})?))?/);
    if (match) {
        const [, y, m, d, time] = match;
        const timeClean = time && time.substring(0, 5) !== '00:00' ? ` ${time.substring(0, 5)}` : '';
        return `${d}.${m}.${y}${timeClean}`;
    }
    return str;
}

// ── Inspect Row ─────────────────────────────────────────────────────────────
function openInspectRowModal(rowData) {
    activeInspectRow = rowData;
    const container = document.getElementById('inspectContent');
    container.innerHTML = '';

    Object.keys(rowData).forEach(col => {
        const val = rowData[col];
        const colLower = col.toLowerCase();
        let valStr = val !== null ? String(val) : 'NULL';
        if (val !== null && ['date', 'start_date', 'created_at', 'updated_at', 'last_login_at', 'last_handshake', 'last_payment_date', 'expiry_date'].includes(colLower)) {
            valStr = formatDateUser(valStr);
        }
        const isNull = val === null;

        const item = document.createElement('div');
        item.className = 'flex flex-col sm:flex-row sm:items-center justify-between p-2.5 bg-base-200/60 rounded-xl border border-base-300/50 gap-2';
        item.innerHTML = `
            <span class="font-bold text-primary text-xs shrink-0">${escapeHtml(col)}:</span>
            <div class="flex items-center gap-2 overflow-hidden">
                <span class="${isNull ? 'text-base-content/20 italic' : 'text-base-content/90'} truncate" title="${escapeHtml(valStr)}">${escapeHtml(valStr)}</span>
                ${!isNull ? `<button type="button" onclick="copyToClipboard('${escapeHtml(valStr).replace(/'/g, "\\'")}')" class="btn btn-ghost btn-xs text-base-content/40 hover:text-primary"><i class="far fa-copy"></i></button>` : ''}
            </div>
        `;
        if (colLower === 'sub' && (rowData.Code || rowData.code)) {
            const clientCode = rowData.Code || rowData.code;
            const extendDiv = document.createElement('div');
            extendDiv.className = 'flex items-center gap-1.5 shrink-0';
            extendDiv.innerHTML = `
                <button type="button" onclick="quickExtendClientFromDbManager('${clientCode}', 1)" class="btn btn-warning btn-xs gap-1 text-[11px]" title="Extend +1 month (+30d)"><i class="fas fa-bolt"></i> +1 Mo</button>
                <button type="button" onclick="quickExtendClientFromDbManager('${clientCode}', 3)" class="btn btn-outline btn-warning btn-xs text-[11px]" title="Extend +3 months (+90d)">+3 Mo</button>
            `;
            item.appendChild(extendDiv);
        }
        container.appendChild(item);
    });

    document.getElementById('inspectRowModal').showModal();
}

async function quickExtendClientFromDbManager(code, months) {
    if (!confirm(`Extend subscription for client ${code} by +${months} month(s) (+${months * 30} days)?`)) return;
    try {
        const res = await fetch('/api/clients/extend', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '{{ csrf_token }}' },
            body: JSON.stringify({ code, months })
        });
        const json = await res.json();
        if (json.success) {
            showToast(`Extended ${code} by +${months} month(s)! New Sub: ${json.sub}`);
            document.getElementById('inspectRowModal').close();

            // Update in-memory and DOM
            tableRows.forEach(r => {
                if ((r.Code && r.Code === code) || (r.code && r.code === code)) {
                    r.Sub = json.sub;
                    r.Func = 'WORK';
                }
            });

            // Update any matching table cells in the grid
            document.querySelectorAll('#dbTableBody tr').forEach(tr => {
                const codeCell = tr.querySelector('[data-col="Code"]');
                if (codeCell && codeCell.dataset.val === code) {
                    const subCell = tr.querySelector('[data-col="Sub"]');
                    if (subCell) {
                        subCell.innerHTML = formatCellHtml(json.sub, 'Sub', 'integer');
                        subCell.dataset.val = json.sub;
                        subCell.classList.add('bg-success/30', 'transition-colors', 'duration-700');
                        setTimeout(() => subCell.classList.remove('bg-success/30'), 1000);
                    }
                    const funcCell = tr.querySelector('[data-col="Func"]');
                    if (funcCell) {
                        funcCell.innerHTML = formatCellHtml('WORK', 'Func', 'character varying');
                        funcCell.dataset.val = 'WORK';
                    }
                }
            });
        } else {
            alert('Error: ' + (json.error || 'Failed to extend subscription'));
        }
    } catch (e) {
        alert('Network Error: ' + e.message);
    }
}

function copyActiveRowJson() {
    if (activeInspectRow) {
        copyToClipboard(JSON.stringify(activeInspectRow, null, 2), 'Row JSON copied!');
    }
}

function isMatchingPk(rowData, pk) {
    for (const k in pk) {
        if (String(rowData[k]) !== String(pk[k])) return false;
    }
    return true;
}

function prependRowToGrid(newRow) {
    const tbody = document.getElementById('dbTableBody');
    if (!tbody) return;

    const emptyTr = tbody.querySelector('td[colspan]');
    if (emptyTr) emptyTr.parentElement.remove();

    const tr = document.createElement('tr');
    tr.className = 'hover group cursor-pointer bg-success/20 transition-all duration-700';
    tr.ondblclick = () => openInspectRowModal(newRow);

    let html = `<td class="text-center text-base-content/40 font-sans">#</td>`;
    currentColumns.forEach(col => {
        const colName = col.column_name;
        const val = newRow[colName] !== undefined ? newRow[colName] : null;
        const colTypeLower = (col.data_type || '').toLowerCase();
        html += `<td class="whitespace-nowrap max-w-xs truncate py-2 select-text" 
                    data-col="${escapeHtml(colName)}" 
                    data-val="${escapeHtml(val !== null ? String(val) : '')}"
                    onclick='handleCellClick(this, ${JSON.stringify(newRow).replace(/'/g, "&#39;")}, "${escapeHtml(colName)}", "${escapeHtml(colTypeLower)}")'>
                    ${formatCellHtml(val, colName, colTypeLower)}
                 </td>`;
    });

    html += `<td class="text-right whitespace-nowrap py-2" onclick="event.stopPropagation()">
                <div class="flex justify-end gap-1 opacity-70 group-hover:opacity-100 transition-opacity">
                    <button onclick='openInspectRowModal(${JSON.stringify(newRow).replace(/'/g, "&#39;")})' 
                            class="btn btn-ghost btn-xs text-base-content/60 hover:text-primary hover:bg-base-200" title="Inspect row details">
                        <i class="fas fa-search-plus"></i>
                    </button>
                    <button onclick='openEditRowModal(${JSON.stringify(newRow).replace(/'/g, "&#39;")})' 
                            class="btn btn-ghost btn-xs text-info hover:bg-info/10 db-edit-btn ${isDbEditingUnlocked ? '' : 'hidden'}" title="Edit row">
                        <i class="fas fa-edit"></i>
                    </button>
                    <button onclick='confirmDeleteRow(${JSON.stringify(newRow).replace(/'/g, "&#39;")})' 
                            class="btn btn-ghost btn-xs text-error hover:bg-error/10 db-edit-btn ${isDbEditingUnlocked ? '' : 'hidden'}" title="Delete row">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
             </td>`;

    tr.innerHTML = html;
    tbody.prepend(tr);
    setTimeout(() => tr.classList.remove('bg-success/20'), 1000);
}

// ── Add Row Modal ───────────────────────────────────────────────────────────
function openAddRowModal() {
    document.getElementById('addRowForm').reset();
    document.getElementById('addRowModal').showModal();
}

async function submitAddRow(e) {
    e.preventDefault();
    const btn = document.getElementById('saveAddRowBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';

    const form = e.target;
    const formData = new FormData(form);
    const dataObj = {};
    for (let [key, val] of formData.entries()) {
        const match = key.match(/data\[(.*?)\]/);
        if (match) {
            dataObj[match[1]] = val;
        }
    }

    try {
        const res = await fetch('/api/db-manager/row-insert', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': '{{ csrf_token }}'
            },
            body: JSON.stringify({
                table: selectedTable,
                data: dataObj
            })
        });
        const json = await res.json();
        if (json.success) {
            showToast('Record inserted successfully!');
            document.getElementById('addRowModal').close();
            form.reset();
            tableRows.unshift(dataObj);
            prependRowToGrid(dataObj);
        } else {
            showToast('Error: ' + (json.error || 'Failed to insert row'), 'error');
        }
    } catch (err) {
        showToast('Network Error: ' + err.message, 'error');
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-save"></i> Save Record';
    }
}

// ── Edit Row Modal ──────────────────────────────────────────────────────────
function openEditRowModal(rowData) {
    const container = document.getElementById('editFieldsContainer');
    container.innerHTML = '';
    activeEditPk = {};

    if (rowData.hasOwnProperty('id') && rowData.id !== null) {
        activeEditPk = { id: rowData.id };
    } else if (rowData.hasOwnProperty('Code') && rowData.Code !== null) {
        activeEditPk = { Code: rowData.Code };
    } else if (currentColumns.length > 0) {
        const firstCol = currentColumns[0].column_name;
        activeEditPk[firstCol] = rowData[firstCol];
    }

    currentColumns.forEach(col => {
        const colName = col.column_name;
        const val = rowData[colName] !== null ? rowData[colName] : '';
        const isPk = activeEditPk.hasOwnProperty(colName);
        const colLower = colName.toLowerCase();
        const isDateCol = colLower in ['date', 'start_date', 'created_at', 'updated_at', 'last_payment_date'] || col.data_type.toLowerCase().includes('date') || col.data_type.toLowerCase().includes('time');

        const div = document.createElement('div');
        div.innerHTML = `
            <label class="label py-1">
                <span class="label-text text-xs font-mono font-bold ${isPk ? 'text-primary' : ''}">
                    ${escapeHtml(colName)} ${isPk ? '(Primary Key)' : ''}
                </span>
                <span class="label-text-alt text-[10px] text-base-content/40">${escapeHtml(col.data_type)}</span>
            </label>
            <input type="text" name="updates[${escapeHtml(colName)}]" 
                   value="${escapeHtml(isDateCol && val ? formatDateUser(val) : String(val))}" 
                   placeholder="${isDateCol ? 'DD.MM.YYYY' : ''}"
                   ${isPk ? 'readonly' : ''}
                   class="input input-bordered input-sm w-full font-mono text-xs ${isPk ? 'bg-base-200 opacity-80 cursor-not-allowed' : ''}">
        `;
        container.appendChild(div);
    });

    document.getElementById('editRowModal').showModal();
}

async function submitEditRow(e) {
    e.preventDefault();
    const btn = document.getElementById('saveEditRowBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Updating...';

    const form = e.target;
    const formData = new FormData(form);
    const updatesObj = {};
    for (let [key, val] of formData.entries()) {
        const match = key.match(/updates\[(.*?)\]/);
        if (match) {
            updatesObj[match[1]] = val;
        }
    }

    try {
        const res = await fetch('/api/db-manager/row-update', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': '{{ csrf_token }}'
            },
            body: JSON.stringify({
                table: selectedTable,
                pk: activeEditPk,
                updates: updatesObj
            })
        });
        const json = await res.json();
        if (json.success) {
            showToast('Record updated successfully!');
            document.getElementById('editRowModal').close();

            // Update in-memory row
            tableRows.forEach(r => {
                if (isMatchingPk(r, activeEditPk)) {
                    Object.assign(r, updatesObj);
                }
            });

            // Update DOM row cells
            document.querySelectorAll('#dbTableBody tr').forEach(tr => {
                let match = false;
                for (const pkCol in activeEditPk) {
                    const cell = tr.querySelector(`[data-col="${pkCol}"]`);
                    if (cell && cell.dataset.val == activeEditPk[pkCol]) match = true;
                }
                if (match) {
                    for (const colName in updatesObj) {
                        const cell = tr.querySelector(`[data-col="${colName}"]`);
                        if (cell) {
                            cell.innerHTML = formatCellHtml(updatesObj[colName], colName, '');
                            cell.dataset.val = updatesObj[colName];
                            cell.classList.add('bg-success/30', 'transition-colors', 'duration-700');
                            setTimeout(() => cell.classList.remove('bg-success/30'), 1000);
                        }
                    }
                }
            });
        } else {
            showToast('Error: ' + (json.error || 'Failed to update row'), 'error');
        }
    } catch (err) {
        showToast('Network Error: ' + err.message, 'error');
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-check"></i> Update Record';
    }
}

// ── Delete Row ──────────────────────────────────────────────────────────────
async function confirmDeleteRow(rowData) {
    let pk = {};
    if (rowData.hasOwnProperty('id') && rowData.id !== null) {
        pk = { id: rowData.id };
    } else if (rowData.hasOwnProperty('Code') && rowData.Code !== null) {
        pk = { Code: rowData.Code };
    } else if (currentColumns.length > 0) {
        const firstCol = currentColumns[0].column_name;
        pk[firstCol] = rowData[firstCol];
    }

    const rowIdStr = rowData.Code || rowData.id || JSON.stringify(pk);
    if (!confirm(`Are you sure you want to permanently delete record ${rowIdStr} from table ${selectedTable}?`)) {
        return;
    }

    try {
        const res = await fetch('/api/db-manager/row-delete', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': '{{ csrf_token }}'
            },
            body: JSON.stringify({
                table: selectedTable,
                pk: pk
            })
        });
        const json = await res.json();
        if (json.success) {
            showToast('Row deleted successfully');
            tableRows = tableRows.filter(r => !isMatchingPk(r, pk));

            document.querySelectorAll('#dbTableBody tr').forEach(tr => {
                for (const pkCol in pk) {
                    const cell = tr.querySelector(`[data-col="${pkCol}"]`);
                    if (cell && cell.dataset.val == pk[pkCol]) {
                        tr.classList.add('opacity-0', 'transition-opacity', 'duration-300');
                        setTimeout(() => tr.remove(), 300);
                    }
                }
            });
        } else {
            showToast('Error: ' + (json.error || 'Failed to delete row'), 'error');
        }
    } catch (err) {
        showToast('Network Error: ' + err.message, 'error');
    }
}

// ── Edit Lock Toggle ────────────────────────────────────────────────────────
function toggleDbEditLock() {
    isDbEditingUnlocked = !isDbEditingUnlocked;
    const btn = document.getElementById('btnDbEditLock');
    const icon = document.getElementById('dbEditLockIcon');
    const text = document.getElementById('dbEditLockText');
    const addBtn = document.getElementById('btnAddRowHeader');
    const editBtns = document.querySelectorAll('.db-edit-btn');

    if (isDbEditingUnlocked) {
        btn.className = 'btn btn-warning btn-sm gap-2 whitespace-nowrap shadow-md';
        icon.className = 'fas fa-lock-open text-warning-content';
        text.textContent = 'Editing Unlocked';
        if (addBtn) addBtn.classList.remove('hidden');
        editBtns.forEach(b => b.classList.remove('hidden'));
        showToast('Direct cell editing is now active &mdash; click any cell to edit', 'warning');
    } else {
        btn.className = 'btn btn-warning btn-outline btn-sm gap-2 whitespace-nowrap';
        icon.className = 'fas fa-lock';
        text.textContent = 'Unlock Editing';
        if (addBtn) addBtn.classList.add('hidden');
        editBtns.forEach(b => b.classList.add('hidden'));
    }
}

function escapeHtml(str) {
    if (str === null || str === undefined) return '';
    return String(str).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
}
</script>
{% endblock %}
