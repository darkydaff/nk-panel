{% extends "layout.twig" %}

{% block title %}{{ t('menu.settings') }} - {{ app_name }}{% endblock %}

{% block breadcrumbs %}
    <a href="/dashboard" class="hover:text-slate-300 transition-colors">Home</a>
    <i class="fas fa-chevron-right text-[10px] text-slate-700 mx-1"></i>
    <span class="text-slate-300">Settings</span>
{% endblock %}

{% block content %}
<div class="max-w-5xl mx-auto px-4 w-full">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-white flex items-center">
            <div class="w-10 h-10 rounded-lg bg-slate-700 text-accent flex items-center justify-center mr-3">
                <i class="fas fa-cog"></i>
            </div>
            {{ t('menu.settings') }}
        </h1>
        <p class="mt-2 ml-13 text-sm text-slate-400">{{ t('settings.description') }}</p>
    </div>

    {% if success %}
    <div class="mb-6 bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 px-4 py-3 rounded-lg flex items-center">
        <i class="fas fa-check-circle mr-3 text-cyan-400"></i>
        <p class="text-sm">{{ success }}</p>
    </div>
    {% endif %}

    {% if error %}
    <div class="mb-6 bg-red-500/10 border border-red-500/30 text-red-300 px-4 py-3 rounded-lg flex items-center">
        <i class="fas fa-exclamation-circle mr-3 text-red-400"></i>
        <p class="text-sm">{{ error }}</p>
    </div>
    {% endif %}

    <div class="flex gap-2 mb-6 overflow-x-auto pb-2">
        <button onclick="showTab('profile')" id="tab-profile" class="tab-btn tab-btn-active px-4 py-2 text-sm font-medium rounded-lg transition-colors whitespace-nowrap">
            <i class="fas fa-user mr-2"></i>{{ t('settings.profile') }}
        </button>
        {% if user.role == 'admin' %}
        <button onclick="showTab('users')" id="tab-users" class="tab-btn px-4 py-2 text-sm font-medium rounded-lg transition-colors whitespace-nowrap">
            <i class="fas fa-users mr-2"></i>{{ t('settings.users') }}
        </button>
        <button onclick="showTab('backups')" id="tab-backups" class="tab-btn px-4 py-2 text-sm font-medium rounded-lg transition-colors whitespace-nowrap">
            <i class="fas fa-database mr-2"></i>Backups
        </button>
        {% endif %}
    </div>

    <div id="content-profile">
        <div class="panel overflow-hidden border-slate-800/60 bg-slate-900/60 backdrop-blur">
            <div class="px-5 py-4 border-b border-slate-700 bg-slate-800/30">
                <h2 class="text-base font-semibold text-white flex items-center">
                    <i class="fas fa-lock mr-2 text-accent"></i>{{ t('settings.change_password') }}
                </h2>
            </div>
            <div class="p-5">
                <form method="POST" action="/settings/change-password" class="max-w-md">
                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-slate-300 mb-2">{{ t('settings.current_password') }}</label>
                            <input type="password" name="current_password" required class="input-field w-full px-4 py-2.5 font-mono">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-300 mb-2">{{ t('settings.new_password') }}</label>
                            <input type="password" name="new_password" required minlength="6" class="input-field w-full px-4 py-2.5 font-mono">
                            <p class="mt-1 text-xs text-slate-500">Minimum 6 characters</p>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-300 mb-2">{{ t('settings.confirm_password') }}</label>
                            <input type="password" name="confirm_password" required minlength="6" class="input-field w-full px-4 py-2.5 font-mono">
                        </div>
                        <div class="pt-2">
                            <button type="submit" class="btn-primary px-5 py-2.5 text-sm">
                                <i class="fas fa-save mr-2"></i>{{ t('settings.change_password') }}
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    {% if user.role == 'admin' %}
    <div id="content-users" class="hidden">
        <div class="panel overflow-hidden mb-6 border-slate-800/60 bg-slate-900/60 backdrop-blur">
            <div class="px-5 py-4 border-b border-slate-700 bg-slate-800/30">
                <h2 class="text-base font-semibold text-white flex items-center">
                    <i class="fas fa-user-plus mr-2 text-accent"></i>{{ t('users.add_user') }}
                </h2>
            </div>
            <div class="p-5">
                <form method="POST" action="/settings/add-user">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-2xl">
                        <div>
                            <label class="block text-sm font-medium text-slate-300 mb-2">{{ t('auth.name') }}</label>
                            <input type="text" name="name" required class="input-field w-full px-4 py-2.5">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-300 mb-2">{{ t('auth.email') }}</label>
                            <input type="email" name="email" required class="input-field w-full px-4 py-2.5">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-300 mb-2">{{ t('auth.password') }}</label>
                            <input type="password" name="password" required minlength="6" class="input-field w-full px-4 py-2.5 font-mono">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-300 mb-2">{{ t('users.role') }}</label>
                            <select name="role" class="input-field w-full px-4 py-2.5">
                                <option value="user">{{ t('users.role_user') }}</option>
                                <option value="admin">{{ t('users.role_admin') }}</option>
                            </select>
                        </div>
                    </div>
                    <div class="mt-4">
                        <button type="submit" class="btn-primary px-5 py-2.5 text-sm">
                            <i class="fas fa-user-plus mr-2"></i>{{ t('users.add_user') }}
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="panel overflow-hidden border-slate-800/60 bg-slate-900/60 backdrop-blur">
            <div class="px-5 py-4 border-b border-slate-700 bg-slate-800/30">
                <h2 class="text-base font-semibold text-white flex items-center">
                    <i class="fas fa-users mr-2 text-accent"></i>{{ t('users.all_users') }}
                </h2>
            </div>
            <div class="table-wrapper">
                <table class="min-w-full">
                    <thead>
                        <tr class="bg-slate-800/50">
                            <th class="px-4 py-3 text-left text-[10px] uppercase tracking-wider text-slate-500 font-semibold">Name</th>
                            <th class="px-4 py-3 text-left text-[10px] uppercase tracking-wider text-slate-500 font-semibold hide-mobile">Email</th>
                            <th class="px-4 py-3 text-left text-[10px] uppercase tracking-wider text-slate-500 font-semibold">Role</th>
                            <th class="px-4 py-3 text-left text-[10px] uppercase tracking-wider text-slate-500 font-semibold hide-mobile">Created</th>
                            <th class="px-4 py-3 text-right text-[10px] uppercase tracking-wider text-slate-500 font-semibold">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-700">
                        {% for u in users %}
                        <tr class="hover:bg-slate-800/30 transition-colors">
                            <td class="px-4 py-3">
                                <div class="flex items-center">
                                    <div class="w-7 h-7 rounded-full bg-slate-700 flex items-center justify-center mr-2 text-slate-400">
                                        <i class="fas fa-user text-xs"></i>
                                    </div>
                                    <span class="text-sm text-white">{{ u.name }}</span>
                                </div>
                            </td>
                            <td class="px-4 py-3 hide-mobile">
                                <code class="text-xs text-slate-400">{{ u.email }}</code>
                            </td>
                            <td class="px-4 py-3">
                                {% if u.role == 'admin' %}
                                <span class="badge-active text-xs px-2 py-1 rounded-md flex items-center w-fit">
                                    <i class="fas fa-star mr-1 text-xs"></i>{{ t('users.role_admin') }}
                                </span>
                                {% else %}
                                <span class="bg-slate-700 text-slate-300 text-xs px-2 py-1 rounded-md">{{ t('users.role_user') }}</span>
                                {% endif %}
                            </td>
                            <td class="px-4 py-3 hide-mobile">
                                <span class="text-xs text-slate-500">{{ u.created_at|date('Y-m-d') }}</span>
                            </td>
                            <td class="px-4 py-3 text-right">
                                {% if u.id != user.id %}
                                <form method="POST" action="/settings/delete-user/{{ u.id }}" class="inline" onsubmit="return confirm('Delete user {{ u.name }}?')">
                                    <button type="submit" class="px-3 py-1.5 rounded-lg bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/30 transition-colors text-xs">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                                {% else %}
                                <span class="text-xs text-slate-600 px-3 py-1.5">You</span>
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Backups Tab Content -->
    <div id="content-backups" class="hidden">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
                <!-- Configuration Card -->
                <div class="lg:col-span-1 panel overflow-hidden border-slate-800/60 bg-slate-900/60 backdrop-blur">
                    <div class="px-5 py-4 border-b border-slate-700 bg-slate-800/30">
                        <h2 class="text-base font-semibold text-white flex items-center">
                            <i class="fas fa-cog mr-2 text-accent"></i>Backup Settings
                        </h2>
                    </div>
                    <div class="p-5">
                        <form method="POST" action="/settings/backup-config">
                            <div class="space-y-4">
                                <label class="flex items-center text-sm font-medium text-slate-300 cursor-pointer">
                                    <input type="checkbox" name="enabled" value="1" {% if backup_settings.enabled %}checked{% endif %} class="rounded bg-slate-800 border-slate-700 mr-2 text-accent focus:ring-0">
                                    Enable Telegram Offsite
                                </label>
                                <div>
                                    <label class="block text-xs font-medium text-slate-400 mb-2">Bot Token</label>
                                    <input type="password" name="bot_token" id="backup-bot-token" value="{{ backup_settings.bot_token }}" class="input-field w-full px-3 py-2 text-sm">
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-slate-400 mb-2">Chat ID</label>
                                    <input type="text" name="chat_id" id="backup-chat-id" value="{{ backup_settings.chat_id }}" class="input-field w-full px-3 py-2 text-sm">
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-slate-400 mb-2">Backup Schedule</label>
                                    <select name="schedule" class="input-field w-full px-3 py-2 text-sm bg-slate-800">
                                        <option value="disabled" {% if backup_settings.schedule == 'disabled' %}selected{% endif %}>Disabled</option>
                                        <option value="daily" {% if backup_settings.schedule == 'daily' %}selected{% endif %}>Daily</option>
                                        <option value="weekly" {% if backup_settings.schedule == 'weekly' %}selected{% endif %}>Weekly</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-slate-400 mb-2">Local Retention (Days)</label>
                                    <input type="number" name="retention_days" value="{{ backup_settings.retention_days|default(7) }}" class="input-field w-full px-3 py-2 text-sm">
                                </div>
                                <div class="flex gap-2">
                                    <button type="submit" class="btn-primary flex-1 py-2.5 text-sm">
                                        <i class="fas fa-save mr-2"></i>Save Config
                                    </button>
                                    <button type="button" onclick="testTelegramConnection()" class="px-4 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 hover:border-slate-650 rounded-lg text-sm transition-colors" title="Test Connection">
                                        <i class="fas fa-paper-plane"></i>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Create & Drag Restore Zone -->
                <div class="lg:col-span-2 panel overflow-hidden border-slate-800/60 bg-slate-900/60 backdrop-blur">
                    <div class="px-5 py-4 border-b border-slate-700 bg-slate-800/30">
                        <h2 class="text-base font-semibold text-white flex items-center">
                            <i class="fas fa-upload mr-2 text-accent"></i>Manual Backup & Restore
                        </h2>
                    </div>
                    <div class="p-5 grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Manual trigger -->
                        <form method="POST" action="/settings/backup-create">
                            <div class="space-y-4">
                                <h3 class="text-sm font-semibold text-slate-200">Create Backup</h3>
                                <div>
                                    <label class="block text-xs font-medium text-slate-400 mb-2">Backup Target</label>
                                    <select name="target" class="input-field w-full px-3 py-2 text-sm bg-slate-800">
                                        <option value="panel">Full Panel (ZIP)</option>
                                        {% for s in servers %}
                                        <option value="{{ s.id }}">Server: {{ s.name }} (JSON)</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <button type="submit" class="btn-primary w-full py-2.5 text-sm mt-2">
                                    <i class="fas fa-plus-circle mr-2"></i>Create Backup Now
                                </button>
                            </div>
                        </form>

                        <!-- Drag Drop Restore -->
                        <div class="space-y-4">
                            <h3 class="text-sm font-semibold text-slate-200">Restore Backup</h3>
                            <div id="drop-zone" class="border-2 border-dashed border-slate-700 hover:border-accent rounded-lg p-6 flex flex-col items-center justify-center cursor-pointer transition-colors h-36 bg-slate-800/20">
                                <i class="fas fa-file-archive text-2xl text-slate-500 mb-2"></i>
                                <p class="text-xs text-slate-400 text-center">Drag & Drop zip/json backup file here</p>
                                <p class="text-[10px] text-slate-500 text-center mt-1">Or click to select a file</p>
                                <input type="file" id="restore-file-input" class="hidden" accept=".zip,.json">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- History Log -->
            <div class="panel overflow-hidden border-slate-800/60 bg-slate-900/60 backdrop-blur">
                <div class="px-5 py-4 border-b border-slate-700 bg-slate-800/30">
                    <h2 class="text-base font-semibold text-white flex items-center">
                        <i class="fas fa-history mr-2 text-accent"></i>Backup History
                    </h2>
                </div>
                <div class="table-wrapper">
                    <table class="min-w-full">
                        <thead>
                            <tr class="bg-slate-800/50">
                                <th class="px-4 py-3 text-left text-[10px] uppercase tracking-wider text-slate-500 font-semibold">Date & Time</th>
                                <th class="px-4 py-3 text-left text-[10px] uppercase tracking-wider text-slate-500 font-semibold">Scope</th>
                                <th class="px-4 py-3 text-left text-[10px] uppercase tracking-wider text-slate-500 font-semibold">Type</th>
                                <th class="px-4 py-3 text-left text-[10px] uppercase tracking-wider text-slate-500 font-semibold">Size</th>
                                <th class="px-4 py-3 text-left text-[10px] uppercase tracking-wider text-slate-500 font-semibold">Status</th>
                                <th class="px-4 py-3 text-right text-[10px] uppercase tracking-wider text-slate-500 font-semibold">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-700">
                            {% for b in backups %}
                            <tr class="hover:bg-slate-800/30 transition-colors">
                                <td class="px-4 py-3 text-xs text-white font-mono">{{ b.created_at }}</td>
                                <td class="px-4 py-3 text-sm">
                                    {% if b.backup_scope == 'panel' %}
                                    <span class="bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 text-xs px-2 py-0.5 rounded">Panel</span>
                                    {% else %}
                                    <span class="bg-slate-750 text-slate-300 text-xs px-2 py-0.5 rounded">Server</span>
                                    {% endif %}
                                </td>
                                <td class="px-4 py-3 text-xs text-slate-400 font-semibold">{{ b.backup_type|capitalize }}</td>
                                <td class="px-4 py-3 text-xs text-slate-300 font-mono">{{ (b.backup_size / 1024) | number_format(1) }} KB</td>
                                <td class="px-4 py-3 text-sm">
                                    {% if b.status == 'completed' %}
                                    <span class="text-emerald-400 text-xs flex items-center">
                                        <i class="fas fa-check-circle mr-1.5 text-emerald-500"></i>Completed
                                    </span>
                                    {% else %}
                                    <span class="text-red-400 text-xs flex items-center cursor-help" title="{{ b.error_message }}">
                                        <i class="fas fa-exclamation-circle mr-1.5 text-red-500"></i>Failed
                                    </span>
                                    {% endif %}
                                </td>
                                <td class="px-4 py-3 text-right space-x-1 whitespace-nowrap">
                                    <a href="/settings/backup-download/{{ b.id }}" class="px-2 py-1 rounded bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-400 border border-cyan-500/30 transition-colors text-xs inline-block">
                                        <i class="fas fa-download"></i>
                                    </a>
                                    <a href="/settings/backup-delete/{{ b.id }}" onclick="return confirm('Delete backup?')" class="px-2 py-1 rounded bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/30 transition-colors text-xs inline-block">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="6" class="px-4 py-6 text-center text-sm text-slate-500">No backups found.</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    {% endif %}
    </div>

    <!-- Restore Confirmation Modal -->
    <div id="restoreModal" class="fixed inset-0 bg-slate-950/85 backdrop-blur-sm z-50 flex items-center justify-center hidden">
        <div class="bg-slate-900 border border-slate-800 rounded-xl max-w-lg w-full overflow-hidden shadow-2xl">
            <div class="px-5 py-4 border-b border-slate-800 bg-slate-900/50 flex justify-between items-center">
                <h3 class="text-base font-semibold text-white"><i class="fas fa-history mr-2 text-accent"></i>Confirm Restoration</h3>
                <button type="button" onclick="closeRestoreModal()" class="text-slate-400 hover:text-slate-200"><i class="fas fa-times"></i></button>
            </div>
            <form id="restore-form" method="POST" action="/settings/backup-restore">
                <input type="hidden" name="filepath" id="restore-filepath">
                <input type="hidden" name="scope" id="restore-scope">
                <div class="p-5 space-y-4">
                    <!-- Panel Restore Options -->
                    <div id="panel-restore-options" class="hidden space-y-4">
                        <div class="bg-red-500/10 border border-red-500/20 text-red-300 px-4 py-3 rounded-lg text-xs leading-relaxed">
                            ⚠️ WARNING: A Full Panel restore will overwrite your current database configurations, clients, and user sessions.
                        </div>
                        <div class="space-y-2">
                            <label class="flex items-center text-sm font-medium text-slate-300 cursor-pointer">
                                <input type="checkbox" name="restore_mysql" value="1" checked class="rounded bg-slate-850 border-slate-700 mr-2 text-accent focus:ring-0">
                                Restore Panel Database Schema & Data
                            </label>
                            <label class="flex items-center text-sm font-medium text-slate-300 cursor-pointer">
                                <input type="checkbox" name="restore_postgres" value="1" checked class="rounded bg-slate-850 border-slate-700 mr-2 text-accent focus:ring-0">
                                Restore External PostgreSQL DB Data
                            </label>
                            <label class="flex items-center text-sm font-medium text-slate-300 cursor-pointer">
                                <input type="checkbox" name="restore_env" value="1" checked class="rounded bg-slate-850 border-slate-700 mr-2 text-accent focus:ring-0">
                                Restore Environment Variables (.env)
                            </label>
                        </div>
                        <div class="pt-3 border-t border-slate-800">
                            <label class="block text-xs text-slate-400 mb-1 font-semibold uppercase">Selective Server Restore</label>
                            <p class="text-[11px] text-slate-500 mb-3">Check boxes below to ONLY extract and restore specific VPN servers (does not overwrite other data):</p>
                            <div id="panel-selective-servers" class="space-y-1.5 max-h-36 overflow-y-auto pr-2">
                                <!-- populated dynamically -->
                            </div>
                        </div>
                        <div class="pt-2">
                            <label class="block text-xs text-slate-400 mb-1.5 font-medium">Type "RESTORE" to confirm entire panel restore</label>
                            <input type="text" id="confirm-input" class="input-field w-full px-3 py-2 text-sm font-mono" placeholder="RESTORE">
                        </div>
                    </div>

                    <!-- Server Restore Options -->
                    <div id="server-restore-options" class="hidden space-y-4">
                        <div class="bg-slate-800/40 p-4 rounded-lg border border-slate-800">
                            <div class="text-xs text-slate-400">Target Host Config:</div>
                            <div class="text-sm font-bold text-white mb-2" id="backup-server-host"></div>
                            <div>
                                <label class="block text-xs text-slate-400 mb-1">Restoration Action:</label>
                                <select name="server_action" id="server-action-select" class="input-field w-full px-3 py-2 text-sm bg-slate-800" onchange="toggleServerSelect()">
                                    <option value="overwrite">Overwrite existing server with matching Host</option>
                                    <option value="new">Import as a brand new VPN Server Copy</option>
                                </select>
                            </div>
                            <div id="target-server-select-div" class="mt-3">
                                <label class="block text-xs text-slate-400 mb-1">Target server to overwrite:</label>
                                <select name="target_server_id" id="target-server-select" class="input-field w-full px-3 py-2 text-sm bg-slate-800">
                                    <!-- populated dynamically -->
                                </select>
                            </div>
                        </div>
                        <label class="flex items-center text-sm font-medium text-slate-300 cursor-pointer">
                            <input type="checkbox" name="sync_keys" value="1" checked class="rounded bg-slate-850 border-slate-700 mr-2 text-accent focus:ring-0">
                            Sync restored keys & active clients directly to remote VPS
                        </label>
                    </div>
                </div>
                <div class="px-5 py-4 border-t border-slate-800 bg-slate-900/50 flex justify-end space-x-3">
                    <button type="button" onclick="closeRestoreModal()" class="px-4 py-2 bg-slate-800 hover:bg-slate-750 text-slate-300 rounded-lg text-sm transition-colors">Cancel</button>
                    <button type="submit" id="restore-submit-btn" class="btn-primary px-5 py-2 text-sm">Proceed Restoration</button>
                </div>
            </form>
        </div>
    </div>
</div>

    <style>
    .tab-btn { background: #334155; color: #94a3b8; }
    .tab-btn:hover { background: #475569; }
    .tab-btn-active { background: #5b8def; color: white; }
    .tab-btn-active:hover { background: #4a7dd8; }
    </style>
    <script>
function showTab(tab) {
    document.querySelectorAll('[id^="content-"]').forEach(el => el.classList.add('hidden'));
    document.getElementById('content-' + tab).classList.remove('hidden');
    
    document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('tab-btn-active'));
    document.getElementById('tab-' + tab).classList.add('tab-btn-active');
    
    window.location.hash = tab;
}

document.addEventListener('DOMContentLoaded', function() {
    const hash = window.location.hash.substring(1);
    if (hash && document.getElementById('tab-' + hash)) {
        showTab(hash);
    }

    // Dropzone logic
    const dropZone = document.getElementById('drop-zone');
    const fileInput = document.getElementById('restore-file-input');

    if (dropZone && fileInput) {
        dropZone.addEventListener('click', () => fileInput.click());

        dropZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropZone.classList.add('border-accent');
        });

        dropZone.addEventListener('dragleave', () => {
            dropZone.classList.remove('border-accent');
        });

        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.classList.remove('border-accent');
            if (e.dataTransfer.files.length) {
                handleBackupUpload(e.dataTransfer.files[0]);
            }
        });

        fileInput.addEventListener('change', (e) => {
            if (e.target.files.length) {
                handleBackupUpload(e.target.files[0]);
            }
        });
    }
});

async function handleBackupUpload(file) {
    const formData = new FormData();
    formData.append('backup_file', file);

    const dropZone = document.getElementById('drop-zone');
    const originalContent = dropZone.innerHTML;
    dropZone.innerHTML = '<i class="fas fa-spinner fa-spin text-2xl text-slate-500 mb-2"></i><p class="text-xs text-slate-400">Uploading and analyzing backup file...</p>';

    try {
        const res = await fetch('/settings/backup-analyze', {
            method: 'POST',
            body: formData
        });
        const data = await res.json();
        dropZone.innerHTML = originalContent;

        if (data.error) {
            alert(data.error);
            return;
        }
        
        document.getElementById('restore-filepath').value = data.filepath;
        document.getElementById('restore-scope').value = data.scope;
        
        if (data.scope === 'panel') {
            document.getElementById('panel-restore-options').classList.remove('hidden');
            document.getElementById('server-restore-options').classList.add('hidden');
            
            // Populate selective server checkboxes
            const serverDiv = document.getElementById('panel-selective-servers');
            serverDiv.innerHTML = '';
            if (data.servers && data.servers.length) {
                data.servers.forEach(srv => {
                    serverDiv.innerHTML += `
                        <label class="flex items-center text-xs text-slate-350 cursor-pointer">
                            <input type="checkbox" name="selective_servers[]" value="${srv.id}" class="rounded bg-slate-850 border-slate-700 mr-2 text-accent focus:ring-0">
                            ${srv.name} (${srv.host})
                        </label>
                    `;
                });
            } else {
                serverDiv.innerHTML = '<p class="text-xs text-slate-550 italic">No VPN servers found in backup archive.</p>';
            }
        } else {
            document.getElementById('panel-restore-options').classList.add('hidden');
            document.getElementById('server-restore-options').classList.remove('hidden');
            document.getElementById('backup-server-host').innerText = `${data.server.name} (${data.server.host})`;
            
            // Populate target servers overwrite dropdown
            const select = document.getElementById('target-server-select');
            select.innerHTML = '';
            if (data.all_servers && data.all_servers.length) {
                data.all_servers.forEach(srv => {
                    const selected = srv.host === data.server.host ? 'selected' : '';
                    select.innerHTML += `<option value="${srv.id}" ${selected}>${srv.name} (${srv.host})</option>`;
                });
            } else {
                select.innerHTML = '<option value="">No servers available to overwrite</option>';
            }
            toggleServerSelect();
        }
        
        document.getElementById('restoreModal').classList.remove('hidden');
    } catch (err) {
        dropZone.innerHTML = originalContent;
        alert('Upload failed: ' + err);
    }
}

function toggleServerSelect() {
    const val = document.getElementById('server-action-select').value;
    const selectDiv = document.getElementById('target-server-select-div');
    if (val === 'overwrite') {
        selectDiv.classList.remove('hidden');
    } else {
        selectDiv.classList.add('hidden');
    }
}

function closeRestoreModal() {
    document.getElementById('restoreModal').classList.add('hidden');
    document.getElementById('confirm-input').value = '';
}

document.getElementById('restore-form').addEventListener('submit', function (e) {
    const scope = document.getElementById('restore-scope').value;
    if (scope === 'panel') {
        // Only require confirmation string if we are restoring the whole panel database
        const selectiveChecked = document.querySelectorAll('input[name="selective_servers[]"]:checked').length > 0;
        if (!selectiveChecked) {
            const confirmText = document.getElementById('confirm-input').value;
            if (confirmText !== 'RESTORE') {
                e.preventDefault();
                alert('Please type RESTORE to confirm entire panel wipe.');
            }
        }
    }
});
async function testTelegramConnection() {
    const token = document.getElementById('backup-bot-token').value;
    const chat = document.getElementById('backup-chat-id').value;

    if (!token || !chat) {
        alert('Please fill out both Bot Token and Chat ID to run connection test.');
        return;
    }

    const formData = new FormData();
    formData.append('bot_token', token);
    formData.append('chat_id', chat);

    try {
        const res = await fetch('/settings/backup-test-telegram', {
            method: 'POST',
            body: formData
        });
        const data = await res.json();
        if (data.success) {
            alert('Success! Check your Telegram chat for the test notification.');
        } else {
            alert('Failed: ' + data.error);
        }
    } catch (err) {
        alert('Connection test failed: ' + err);
    }
}
</script>
{% endblock %}
