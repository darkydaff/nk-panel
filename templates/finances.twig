async function deleteTransactionRecord(id) {
    if (!confirm('Are you sure you want to delete transaction #' + id + '?')) return;

    try {
        const token = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '{{ csrf_token }}';
        const formData = new FormData();
        formData.append('id', id);
        formData.append('csrf_token', token);
        const res = await fetch('/api/finances/delete', {
            method: 'POST',
            headers: {
                'Accept': 'application/json',
                'X-CSRF-Token': token,
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: formData
        });
        let json;
        try {
            json = await res.json();
        } catch (parseErr) {
            const text = await res.text().catch(() => '');
            json = { success: false, error: text || (`HTTP ${res.status} ${res.statusText}`) };
        }
        if (json.success) {
            loadTransactions();
            loadStats();
        } else {
            alert('Error: ' + (json.error || 'Failed to delete transaction'));
        }
    } catch (err) {
        alert('Network Error: ' + err.message);
    }
}

let isFinancesEditingUnlocked = false;

function toggleFinancesEditLock() {
    isFinancesEditingUnlocked = !isFinancesEditingUnlocked;
    const btn = document.getElementById('btnFinancesEditLock');
    const icon = document.getElementById('financesEditLockIcon');
    const text = document.getElementById('financesEditLockText');
    const addBtn = document.getElementById('btnAddTxHeader');
    const editBtns = document.querySelectorAll('.tx-edit-btn');

    if (isFinancesEditingUnlocked) {
        btn.className = 'btn btn-warning btn-sm gap-2 whitespace-nowrap shadow-md';
        icon.className = 'fas fa-lock-open text-warning-content';
        text.textContent = 'Editing Unlocked';
        if (addBtn) addBtn.classList.remove('hidden');
        editBtns.forEach(b => b.classList.remove('hidden'));
    } else {
        btn.className = 'btn btn-warning btn-outline btn-sm gap-2 whitespace-nowrap';
        icon.className = 'fas fa-lock';
        text.textContent = 'Unlock Editing';
        if (addBtn) addBtn.classList.add('hidden');
        editBtns.forEach(b => b.classList.add('hidden'));
    }
}

let activeQuickClientCode = '';

async function openClientQuickModal(code) {
    activeQuickClientCode = code;
    document.getElementById('quickClientCodeHeader').textContent = code;
    const content = document.getElementById('quickClientContent');
    content.innerHTML = '<div><i class="fas fa-spinner fa-spin mr-2"></i>Loading client information...</div>';
    document.getElementById('modalClientQuick').showModal();

    try {
        const res = await fetch('/api/clients/payments?code=' + encodeURIComponent(code));
        const json = await res.json();

        if (!json.success || !json.client) {
            content.innerHTML = '<div class="text-error">Client record not found in Clients table.</div>';
            return;
        }

        const c = json.client;
        const payments = json.payments || [];

        content.innerHTML = `
            <div class="flex justify-between border-b border-base-300 pb-2">
                <span class="text-base-content/50">Code:</span>
                <span class="font-bold text-primary">${escapeHtml(c.Code)}</span>
            </div>
            <div class="flex justify-between border-b border-base-300 pb-2">
                <span class="text-base-content/50">Name:</span>
                <span class="font-bold">${escapeHtml(c.Name || '-')}</span>
            </div>
            <div class="flex justify-between border-b border-base-300 pb-2">
                <span class="text-base-content/50">Status (Func):</span>
                <span class="badge ${c.Func === 'WORK' ? 'badge-success' : 'badge-warning'} text-xs">${escapeHtml(c.Func || 'UNKNOWN')}</span>
            </div>
            <div class="flex justify-between border-b border-base-300 pb-2">
                <span class="text-base-content/50">Subscription (Sub):</span>
                <span class="font-bold">${c.Sub || 0} months</span>
            </div>
            <div class="flex justify-between border-b border-base-300 pb-2">
                <span class="text-base-content/50">Start Date:</span>
                <span>${escapeHtml(c.Start_Date || '-')}</span>
            </div>
            <div class="flex justify-between border-b border-base-300 pb-2">
                <span class="text-base-content/50">Router:</span>
                <span>${escapeHtml(c.Router || '-')}</span>
            </div>
            <div class="flex justify-between border-b border-base-300 pb-2">
                <span class="text-base-content/50">Telegram ID (tgid):</span>
                <span>${escapeHtml(c.tgid || '-')}</span>
            </div>
            <div class="flex justify-between">
                <span class="text-base-content/50">Total Recorded Payments:</span>
                <span class="font-bold text-emerald-400">${payments.length} transactions</span>
            </div>
        `;
    } catch (err) {
        content.innerHTML = '<div class="text-error">Error loading client details</div>';
    }
}

function goToClientPage() {
    if (activeQuickClientCode) {
        window.location.href = '/clients?search=' + encodeURIComponent(activeQuickClientCode);
    }
}

async function loadClientCodesDatalist() {
    try {
        const res = await fetch('/api/clients/list');
        const json = await res.json();
        if (json.success && json.codes) {
            const dl = document.getElementById('clientCodesDatalist');
            if (dl) dl.innerHTML = json.codes.map(code => `<option value="${escapeHtml(code)}">`).join('');
        }
    } catch (e) {}
}

document.addEventListener('click', (e) => {
    ['addTxClientDropdown', 'editTxClientDropdown', 'filterClientDropdown'].forEach(id => {
        const dd = document.getElementById(id);
        if (dd && !dd.contains(e.target) && dd.previousElementSibling && !dd.previousElementSibling.contains(e.target)) {
            dd.classList.add('hidden');
        }
    });
});

document.addEventListener('DOMContentLoaded', () => {
    loadClientCodesDatalist();
});
</script>
