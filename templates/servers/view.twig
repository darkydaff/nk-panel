{% extends "layout.twig" %}
{% block title %}{{ server.name }}{% endblock %}

{% block breadcrumbs %}
    <a href="/dashboard" class="hover:text-slate-300 transition-colors">Home</a>
    <i class="fas fa-chevron-right text-[10px] text-slate-700 mx-1"></i>
    <a href="/servers" class="hover:text-slate-300 transition-colors">Servers</a>
    <i class="fas fa-chevron-right text-[10px] text-slate-700 mx-1"></i>
    <span class="text-slate-300">{{ server.name }}</span>
{% endblock %}

{% block content %}
<div class="w-full mx-auto max-w-7xl">
    <div class="mb-6 flex flex-col md:flex-row md:items-start justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-white flex items-center">
                <div class="w-10 h-10 rounded-lg bg-slate-700 text-accent flex items-center justify-center mr-3">
                    <i class="fas fa-server"></i>
                </div>
                {{ server.name }}
            </h1>
            <div class="mt-2 ml-13 flex flex-wrap items-center gap-3">
                <code class="text-xs text-slate-400 bg-slate-800 px-2 py-1 rounded">{{ server.host }}</code>
                {% if server.status == 'active' %}
                    <span class="badge-active text-xs px-2 py-1 rounded-md flex items-center">
                        <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 mr-1.5"></span>Active
                    </span>
                {% else %}
                    <span class="badge-error text-xs px-2 py-1 rounded-md flex items-center">
                        <span class="w-1.5 h-1.5 rounded-full bg-red-400 mr-1.5"></span>{{ server.status }}
                    </span>
                {% endif %}
                
                <span id="agentStatusBadge" class="text-xs px-2 py-1 rounded-md flex items-center {% if agent_online %}bg-emerald-500/10 text-emerald-400 border border-emerald-500/30{% else %}bg-amber-500/10 text-amber-400 border border-amber-500/30{% endif %}">
                    <span class="w-1.5 h-1.5 rounded-full {% if agent_online %}bg-emerald-400{% else %}bg-amber-400{% endif %} mr-1.5" id="agentStatusDot"></span>
                    <span id="agentStatusText">{% if agent_online %}Agent Online{% else %}Agent Offline{% endif %}</span>
                </span>
            </div>
        </div>
        <div class="flex gap-2">
            <button onclick="installAgent({{ server.id }})" id="installAgentBtn" class="px-4 py-2 rounded-lg bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-400 border border-cyan-500/30 transition-colors text-sm">
                <i class="fas fa-satellite-dish mr-2"></i><span id="installAgentBtnText">{% if agent_online %}Reinstall Agent{% else %}Install Agent{% endif %}</span>
            </button>
            <button type="button" onclick="openDeleteServerModal({{ server.id }}, '{{ server.name|e('js') }}')" class="px-4 py-2 rounded-lg bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/30 transition-colors text-sm">
                <i class="fas fa-trash-alt mr-2"></i>Delete
            </button>
        </div>
    </div>
    
    {% if import_message %}
    <div class="mb-6 {% if import_message.type == 'success' %}bg-cyan-500/10 border-cyan-500/30 text-cyan-300{% else %}bg-red-500/10 border-red-500/50 text-red-300{% endif %} border px-4 py-3 rounded-lg flex items-center mb-4">
        <i class="fas {% if import_message.type == 'success' %}fa-check-circle text-cyan-400{% else %}fa-exclamation-circle text-red-400{% endif %} mr-3"></i>
        <span>{{ import_message.text }}</span>
    </div>
    {% endif %}

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-6">
        <div class="lg:col-span-2 panel p-5 border-slate-800/60 bg-slate-900/60 backdrop-blur">
            <h3 class="text-base font-semibold mb-4 text-white flex items-center">
                <i class="fas fa-info-circle text-accent mr-2"></i>Server Info
            </h3>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                <div class="bg-slate-800/50 p-3 rounded-lg">
                    <span class="text-xs text-slate-500 block mb-1">VPN Port</span>
                    <span class="text-slate-200 font-mono">{{ server.vpn_port }}</span>
                </div>
                <div class="bg-slate-800/50 p-3 rounded-lg">
                    <span class="text-xs text-slate-500 block mb-1">Subnet</span>
                    <span class="text-slate-200 font-mono">{{ server.vpn_subnet }}</span>
                </div>
                <div class="bg-slate-800/50 p-3 rounded-lg">
                    <span class="text-xs text-slate-500 block mb-1">Protocol</span>
                    <span class="text-cyan-400 font-mono uppercase">{{ server.awg_params.mimicry_type|default('quic') }}</span>
                </div>
                <div class="bg-slate-800/50 p-3 rounded-lg">
                    <span class="text-xs text-slate-500 block mb-1">Deployed</span>
                    <span class="text-slate-200">{{ server.deployed_at|date('Y-m-d H:i') }}</span>
                </div>
            </div>
        </div>
        
        <div class="panel p-5 border-slate-800/60 bg-slate-900/60 backdrop-blur">
            <h3 class="text-base font-semibold mb-4 text-white flex items-center">
                <i class="fas fa-user-plus text-accent mr-2"></i>New Config
            </h3>

            {# ── Mode toggle ── #}
            <div class="flex bg-slate-950/80 p-0.5 rounded-lg border border-slate-800/80 text-xs mb-4 select-none" id="clientModeToggle">
                <button type="button" onclick="setClientMode('linked')"
                        id="modeLinkedBtn"
                        class="flex-1 py-1.5 px-3 rounded-md font-medium transition-all bg-slate-800 text-white">
                    <i class="fas fa-link mr-1 opacity-70"></i>DB Client
                </button>
                <button type="button" onclick="setClientMode('anon')"
                        id="modeAnonBtn"
                        class="flex-1 py-1.5 px-3 rounded-md font-medium transition-all text-slate-400 hover:text-slate-200">
                    <i class="fas fa-user-secret mr-1 opacity-70"></i>Anonymous
                </button>
            </div>

            <form method="POST" action="/servers/{{ server.id }}/clients/create" id="createClientForm">
                {# Hidden: will be filled when a DB client is selected #}
                <input type="hidden" name="ext_client_code" id="extClientCodeInput" value="">

                {# ── Linked mode: code autocomplete ── #}
                <div id="linkedModeFields" class="mb-3">
                    <label class="block text-xs text-slate-500 mb-1.5 uppercase tracking-wide">Client Code</label>
                    <div class="relative">
                        <input type="text"
                               id="clientCodeSearch"
                               placeholder="Type to search..."
                               autocomplete="off"
                               class="input-field w-full px-4 py-2.5 text-sm pr-8"
                               oninput="onCodeSearchInput(this.value)">
                        <i class="fas fa-search absolute right-3 top-1/2 -translate-y-1/2 text-slate-600 text-xs pointer-events-none" id="codeSearchIcon"></i>
                    </div>
                    <div id="codeDropdown"
                         class="hidden absolute z-50 mt-1 w-56 bg-slate-900 border border-slate-700 rounded-lg shadow-xl overflow-hidden max-h-48 overflow-y-auto text-sm">
                    </div>
                    <p id="codeSelectedInfo" class="text-xs text-indigo-400 mt-1.5 hidden">
                        <i class="fas fa-check-circle mr-1"></i><span id="codeSelectedText"></span>
                    </p>
                </div>

                {# ── Config name (shared by both modes) ── #}
                <div class="mb-3">
                    <label class="block text-xs text-slate-500 mb-1.5 uppercase tracking-wide">Config Name</label>
                    <input name="name" required
                           class="input-field w-full px-4 py-2.5 text-sm"
                           placeholder="Client name"
                           id="clientName">
                </div>

                <button type="submit" class="btn-primary w-full py-2.5 text-sm" id="createClientBtn">
                    <i class="fas fa-plus mr-2"></i><span id="createClientText">Create Config</span>
                    <i class="fas fa-spinner fa-spin hidden ml-2" id="createClientSpinner"></i>
                </button>
            </form>
            <p class="text-xs text-slate-500 mt-2">Spaces become underscores. Cyrillic OK.</p>
        </div>
    </div>

    <div class="panel overflow-hidden border-slate-800/60 bg-slate-900/60 backdrop-blur">
        <div class="px-5 py-4 border-b border-slate-750 flex flex-col xl:flex-row gap-4 xl:items-center xl:justify-between bg-slate-900/85">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between xl:justify-start gap-4">
                <h3 class="text-base font-semibold text-white flex items-center">
                    <i class="fas fa-users text-cyan-400 mr-2"></i>Clients
                    <span class="ml-2 bg-slate-800 border border-slate-700 text-slate-300 px-2.5 py-0.5 rounded text-xs font-mono" id="clientCount">{{ clients|length }}</span>
                </h3>
                
                <!-- Status Filter Pills -->
                <div class="flex items-center bg-slate-950/80 p-0.5 rounded-lg border border-slate-800/80 text-[11px] self-start sm:self-auto select-none" id="statusFilterGroup">
                    <button type="button" class="status-filter-btn px-3 py-1 rounded-md font-medium transition-all bg-slate-800 text-white" data-status="all">All</button>
                    <button type="button" class="status-filter-btn px-3 py-1 rounded-md font-medium transition-all text-slate-400 hover:text-slate-200" data-status="online">Online</button>
                    <button type="button" class="status-filter-btn px-3 py-1 rounded-md font-medium transition-all text-slate-400 hover:text-slate-200" data-status="offline">Offline</button>
                    <button type="button" class="status-filter-btn px-3 py-1 rounded-md font-medium transition-all text-slate-400 hover:text-slate-200" data-status="never">Never</button>
                </div>
            </div>
            
            <div class="flex flex-wrap sm:flex-nowrap gap-2 items-center justify-end">
                <div class="relative w-full sm:w-auto">
                    <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-500 text-xs"></i>
                    <input type="text" id="clientSearch" placeholder="Search..." class="input-field pl-9 pr-8 py-2 text-xs w-full sm:w-40 focus:sm:w-56 transition-all bg-slate-950 border-slate-850 text-white rounded-lg focus:outline-none focus:border-blue-500 placeholder-slate-500">
                    <button type="button" id="clearSearch" class="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-500 hover:text-white hidden">
                        <i class="fas fa-times text-xs"></i>
                    </button>
                </div>
                

                
                <button onclick="syncAllStats({{ server.id }})" id="syncBtn" class="btn-secondary px-3.5 py-2 text-xs w-full sm:w-auto text-center flex items-center justify-center gap-1.5 whitespace-nowrap bg-slate-800/40 hover:bg-slate-800 border-slate-700/80 hover:border-slate-600">
                    <i class="fas fa-sync-alt"></i>Sync
                </button>
                <form method="POST" action="/servers/{{ server.id }}/reset-all-traffic" class="inline w-full sm:w-auto" onsubmit="return confirm('Are you sure you want to reset cumulative traffic statistics for ALL clients on this server?')">
                    <button type="submit" class="px-3.5 py-2 rounded-lg bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 border border-amber-500/30 transition-colors text-xs flex items-center justify-center gap-1.5 whitespace-nowrap w-full sm:w-auto font-medium">
                        <i class="fas fa-undo"></i>Reset Traffic
                    </button>
                </form>
            </div>
        </div>
        {% if clients|length > 0 %}
        <div class="hidden md:block">
            <div class="table-wrapper">
                <table class="min-w-full">
                    <thead>
                        <tr class="bg-slate-800/50">
                            <th class="sortable px-4 py-3 text-left text-[10px] uppercase tracking-wider text-slate-500 font-semibold cursor-pointer select-none" data-sort="name">
                                Name <i class="fas fa-sort ml-1 opacity-45 text-[9px]" id="sortIcon-name"></i>
                            </th>
                            <th class="sortable px-4 py-3 text-left text-[10px] uppercase tracking-wider text-slate-500 font-semibold cursor-pointer select-none hide-mobile" data-sort="ip">
                                IP <i class="fas fa-sort ml-1 opacity-45 text-[9px]" id="sortIcon-ip"></i>
                            </th>
                            <th class="sortable px-4 py-3 text-left text-[10px] uppercase tracking-wider text-slate-500 font-semibold cursor-pointer select-none hide-mobile" data-sort="city">
                                City <i class="fas fa-sort ml-1 opacity-45 text-[9px]" id="sortIcon-city"></i>
                            </th>
                            <th class="sortable px-4 py-3 text-left text-[10px] uppercase tracking-wider text-slate-500 font-semibold cursor-pointer select-none" data-sort="traffic">
                                Traffic <i class="fas fa-sort ml-1 opacity-45 text-[9px]" id="sortIcon-traffic"></i>
                            </th>
                            <th class="sortable px-4 py-3 text-left text-[10px] uppercase tracking-wider text-slate-500 font-semibold cursor-pointer select-none hide-mobile" data-sort="handshake">
                                Handshake <i class="fas fa-sort ml-1 opacity-45 text-[9px]" id="sortIcon-handshake"></i>
                            </th>
                            <th class="px-4 py-3 text-right text-[10px] uppercase tracking-wider text-slate-500 font-semibold">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-700" id="clientTableBody">
                        {% for client in clients %}
                        {% set is_never = true %}
                        {% if client.last_handshake is not empty and client.last_handshake != '0000-00-00 00:00:00' and client.last_handshake != '1970-01-01 00:00:00' and client.last_handshake != '0' %}
                            {% set is_never = false %}
                        {% endif %}
                        <tr class="hover:bg-slate-800/30 transition-colors client-row" 
                            data-name="{{ client.name }}" 
                            data-ip="{{ client.client_ip }}" 
                            data-city="{{ client.city|default('') }}"
                            data-client-id="{{ client.id }}"
                            data-bytes="{{ client.bytes_sent + client.bytes_received }}"
                            data-last-handshake="{% if not is_never %}{{ client.last_handshake|date('U') }}{% else %}never{% endif %}">
                            <td class="px-4 py-3">
                                <div class="flex items-center">
                                    <div class="w-7 h-7 rounded-full bg-slate-700 flex items-center justify-center mr-2 text-slate-400">
                                        <i class="fas fa-user text-xs"></i>
                                    </div>
                                    <span class="text-sm text-white">{{ client.name }}</span>
                                </div>
                            </td>
                            <td class="px-4 py-3 hide-mobile">
                                <code class="text-xs text-slate-400 font-mono">{{ client.client_ip }}</code>
                            </td>
                            <td class="px-4 py-3 hide-mobile city-container text-xs text-slate-400">
                                {{ client.city|default('—') }}
                            </td>
                            <td class="px-4 py-3">
                                <div class="flex gap-1 text-xs">
                                    <span class="text-cyan-400 font-mono upload-bytes">↑{{ client.bytes_sent|default(0)|format_bytes }}</span>
                                    <span class="text-blue-400 font-mono download-bytes">↓{{ client.bytes_received|default(0)|format_bytes }}</span>
                                </div>
                                <div class="text-[10px] text-slate-400 mt-1 flex gap-1.5 font-mono speed-container">
                                    {% if client.status == 'active' and (client.speed_up_kbps > 0 or client.speed_down_kbps > 0) %}
                                        {% if client.speed_up_kbps >= 1000 %}
                                            <span class="text-emerald-400 font-semibold">↑{{ (client.speed_up_kbps / 1000)|number_format(1) }} Mbps</span>
                                        {% elseif client.speed_up_kbps > 0 %}
                                            <span class="text-emerald-400">↑{{ client.speed_up_kbps|number_format(0) }} Kbps</span>
                                        {% endif %}
                                        
                                        {% if client.speed_down_kbps >= 1000 %}
                                            <span class="text-indigo-400 font-semibold">↓{{ (client.speed_down_kbps / 1000)|number_format(1) }} Mbps</span>
                                        {% elseif client.speed_down_kbps > 0 %}
                                            <span class="text-indigo-400">↓{{ client.speed_down_kbps|number_format(0) }} Kbps</span>
                                        {% endif %}
                                    {% endif %}
                                </div>
                            </td>
                            <td class="px-4 py-3 hide-mobile handshake-container">
                                {% if not is_never %}
                                    <span class="text-xs text-slate-400">{{ client.last_handshake }}</span>
                                {% else %}
                                    <span class="text-xs text-slate-600">Never</span>
                                {% endif %}
                            </td>
                            <td class="px-4 py-3 text-right">
                                <div class="flex items-center justify-end gap-1">
                                    <a href="/clients/{{ client.id }}" class="btn-secondary px-3 py-1.5 text-xs" title="View">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <form method="POST" action="/clients/{{ client.id }}/delete" style="display:inline;">
                                        <button type="submit" class="px-3 py-1.5 rounded-lg bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/30 transition-colors text-xs" onclick="return confirm('Delete client {{ client.name }}?')" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="md:hidden divide-y divide-slate-700" id="clientCards">
            {% for client in clients %}
            {% set is_never = true %}
            {% if client.last_handshake is not empty and client.last_handshake != '0000-00-00 00:00:00' and client.last_handshake != '1970-01-01 00:00:00' and client.last_handshake != '0' %}
                {% set is_never = false %}
            {% endif %}
            <div class="p-4 client-card border-b border-slate-800 last:border-0" 
                 data-name="{{ client.name }}" 
                 data-ip="{{ client.client_ip }}" 
                 data-city="{{ client.city|default('') }}"
                 data-client-id="{{ client.id }}"
                 data-bytes="{{ client.bytes_sent + client.bytes_received }}"
                 data-last-handshake="{% if not is_never %}{{ client.last_handshake|date('U') }}{% else %}never{% endif %}">
                <div class="flex items-start justify-between mb-3">
                    <div class="flex items-center">
                        <div class="w-8 h-8 rounded-full bg-slate-700 flex items-center justify-center mr-2 text-slate-400">
                            <i class="fas fa-user text-xs"></i>
                        </div>
                        <div>
                            <span class="text-sm font-medium text-white">{{ client.name }}</span>
                            <code class="block text-xs text-slate-500 mt-0.5 font-mono card-ip-value">{{ client.client_ip }}{% if client.city %} ({{ client.city }}){% endif %}</code>
                        </div>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-2 mb-3 text-xs">
                    <div class="bg-slate-800/50 p-2 rounded">
                        <span class="text-slate-500 block">Traffic</span>
                        <span class="text-cyan-400 font-mono upload-bytes">↑{{ client.bytes_sent|default(0)|format_bytes }}</span>
                        <span class="text-blue-400 font-mono download-bytes">↓{{ client.bytes_received|default(0)|format_bytes }}</span>
                        <div class="text-[10px] text-slate-400 mt-1 flex flex-col font-mono speed-container">
                            {% if client.status == 'active' and (client.speed_up_kbps > 0 or client.speed_down_kbps > 0) %}
                                {% if client.speed_up_kbps >= 1000 %}
                                    <span class="text-emerald-400 font-semibold">↑{{ (client.speed_up_kbps / 1000)|number_format(1) }} Mbps</span>
                                {% elseif client.speed_up_kbps > 0 %}
                                    <span class="text-emerald-400">↑{{ client.speed_up_kbps|number_format(0) }} Kbps</span>
                                {% endif %}
                                
                                {% if client.speed_down_kbps >= 1000 %}
                                    <span class="text-indigo-400 font-semibold">↓{{ (client.speed_down_kbps / 1000)|number_format(1) }} Mbps</span>
                                {% elseif client.speed_down_kbps > 0 %}
                                    <span class="text-indigo-400">↓{{ client.speed_down_kbps|number_format(0) }} Kbps</span>
                                {% endif %}
                            {% endif %}
                        </div>
                    </div>
                    <div class="bg-slate-800/50 p-2 rounded">
                        <span class="text-slate-500 block">Handshake</span>
                        <span class="text-slate-300 handshake-value">
                            {% if not is_never %}{{ client.last_handshake }}{% else %}Never{% endif %}
                        </span>
                    </div>
                </div>
                <div class="flex gap-2">
                    <a href="/clients/{{ client.id }}" class="btn-secondary flex-1 text-center py-2 text-xs">
                        <i class="fas fa-eye mr-1"></i>View
                    </a>
                    <form method="POST" action="/clients/{{ client.id }}/delete" class="flex-1">
                        <button type="submit" class="w-full px-3 py-2 rounded-lg bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/30 transition-colors text-xs" onclick="return confirm('Delete client {{ client.name }}?')">
                            <i class="fas fa-trash mr-1"></i>Delete
                        </button>
                    </form>
                </div>
            </div>
            {% endfor %}
        </div>
        {% else %}
        <div class="p-10 text-center">
            <i class="fas fa-users text-slate-600 text-2xl mb-3"></i>
            <p class="text-slate-400">No clients yet</p>
        </div>
        {% endif %}
    </div>
</div>

<script>
// ── Client mode toggle (DB Client vs Anonymous) ──────────────────────────────
let currentClientMode = 'linked';

function setClientMode(mode) {
    currentClientMode = mode;
    const linkedFields  = document.getElementById('linkedModeFields');
    const linkedBtn     = document.getElementById('modeLinkedBtn');
    const anonBtn       = document.getElementById('modeAnonBtn');
    const extInput      = document.getElementById('extClientCodeInput');

    if (mode === 'linked') {
        linkedFields.classList.remove('hidden');
        linkedBtn.classList.add('bg-slate-800', 'text-white');
        linkedBtn.classList.remove('text-slate-400');
        anonBtn.classList.remove('bg-slate-800', 'text-white');
        anonBtn.classList.add('text-slate-400');
    } else {
        linkedFields.classList.add('hidden');
        extInput.value = '';
        anonBtn.classList.add('bg-slate-800', 'text-white');
        anonBtn.classList.remove('text-slate-400');
        linkedBtn.classList.remove('bg-slate-800', 'text-white');
        linkedBtn.classList.add('text-slate-400');
    }
}

// ── Client code autocomplete ─────────────────────────────────────────────────
let codeSearchTimer = null;

function onCodeSearchInput(value) {
    clearTimeout(codeSearchTimer);
    document.getElementById('extClientCodeInput').value = '';
    document.getElementById('codeSelectedInfo').classList.add('hidden');

    if (value.length < 1) {
        hideCodeDropdown();
        return;
    }

    codeSearchTimer = setTimeout(() => fetchCodes(value), 220);
}

function fetchCodes(q) {
    const icon = document.getElementById('codeSearchIcon');
    icon.className = 'fas fa-spinner fa-spin absolute right-3 top-1/2 -translate-y-1/2 text-slate-500 text-xs pointer-events-none';

    fetch('/api/ext-clients/search?q=' + encodeURIComponent(q))
        .then(r => r.json())
        .then(data => {
            icon.className = 'fas fa-search absolute right-3 top-1/2 -translate-y-1/2 text-slate-600 text-xs pointer-events-none';
            renderCodeDropdown(data.codes || []);
        })
        .catch(() => {
            icon.className = 'fas fa-search absolute right-3 top-1/2 -translate-y-1/2 text-slate-600 text-xs pointer-events-none';
            hideCodeDropdown();
        });
}

function renderCodeDropdown(codes) {
    const dd = document.getElementById('codeDropdown');
    dd.innerHTML = '';
    if (!codes.length) {
        dd.innerHTML = '<div class="px-4 py-3 text-slate-500 text-xs">No matches</div>';
        dd.classList.remove('hidden');
        return;
    }
    codes.forEach(code => {
        const item = document.createElement('button');
        item.type = 'button';
        item.className = 'w-full text-left px-4 py-2.5 hover:bg-slate-800 text-slate-200 hover:text-white transition-colors font-mono text-xs flex items-center gap-2';
        item.innerHTML = '<i class="fas fa-user text-slate-600"></i>' + escapeHtml(code);
        item.addEventListener('mousedown', () => selectCode(code));
        dd.appendChild(item);
    });
    dd.classList.remove('hidden');
}

function selectCode(code) {
    document.getElementById('clientCodeSearch').value = code;
    document.getElementById('extClientCodeInput').value = code;

    // Auto-fill config name with the code if it's empty or was auto-filled before
    const nameField = document.getElementById('clientName');
    if (!nameField.dataset.userEdited) {
        nameField.value = code;
    }

    document.getElementById('codeSelectedText').textContent = code + ' selected';
    document.getElementById('codeSelectedInfo').classList.remove('hidden');
    hideCodeDropdown();
}

function hideCodeDropdown() {
    const dd = document.getElementById('codeDropdown');
    if (dd) dd.classList.add('hidden');
}

function escapeHtml(str) {
    return str.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

document.addEventListener('DOMContentLoaded', function() {
    // Track manual edits to config name
    const nameField = document.getElementById('clientName');
    if (nameField) {
        nameField.addEventListener('input', function(e) {
            e.target.value = e.target.value.replace(/ /g, '_');
            e.target.dataset.userEdited = 'true';
        });
    }

    // Close autocomplete dropdown when clicking outside
    document.addEventListener('click', function(e) {
        const searchInput = document.getElementById('clientCodeSearch');
        const dropdown = document.getElementById('codeDropdown');
        if (searchInput && dropdown) {
            if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) {
                hideCodeDropdown();
            }
        }
    });

    const form = document.getElementById('createClientForm');
    if (form) {
        form.addEventListener('submit', function() {
            // Safeguard: Copy search input value to hidden input if in linked mode
            if (currentClientMode === 'linked') {
                const searchInput = document.getElementById('clientCodeSearch');
                const extInput = document.getElementById('extClientCodeInput');
                if (searchInput && extInput && !extInput.value) {
                    extInput.value = searchInput.value.trim();
                }
            }

            document.getElementById('createClientBtn').disabled = true;
            document.getElementById('createClientText').textContent = 'Creating...';
            document.getElementById('createClientSpinner').classList.remove('hidden');
        });
    }

    const searchInput = document.getElementById('clientSearch');
    const clearBtn = document.getElementById('clearSearch');
    const tbody = document.getElementById('clientTableBody');
    const clientCards = document.getElementById('clientCards');
    const clientCount = document.getElementById('clientCount');
    
    let currentStatusFilter = 'all';
    let currentSortColumn = 'name'; // default
    let currentSortDirection = 'asc'; // 'asc' or 'desc'

    function sortClients() {
        const isMobile = clientCards && window.getComputedStyle(clientCards).display !== 'none';
        
        if (isMobile && clientCards) {
            const cards = Array.from(clientCards.querySelectorAll('div.client-card'));
            cards.sort(compareElements);
            cards.forEach(card => clientCards.appendChild(card));
        } else if (tbody) {
            const rows = Array.from(tbody.querySelectorAll('tr.client-row'));
            rows.sort(compareElements);
            rows.forEach(row => tbody.appendChild(row));
        }
        updateSortIcons();
    }

    function compareElements(a, b) {
        let valA, valB;
        if (currentSortColumn === 'name') {
            valA = a.dataset.name.toLowerCase();
            valB = b.dataset.name.toLowerCase();
            return currentSortDirection === 'asc' ? valA.localeCompare(valB) : valB.localeCompare(valA);
        } else if (currentSortColumn === 'ip') {
            valA = a.dataset.ip;
            valB = b.dataset.ip;
            const ipToNum = ip => ip.split('.').reduce((acc, octet) => (acc << 8) + parseInt(octet, 10), 0) >>> 0;
            const numA = ipToNum(valA);
            const numB = ipToNum(valB);
            return currentSortDirection === 'asc' ? numA - numB : numB - numA;
        } else if (currentSortColumn === 'city') {
            valA = (a.dataset.city || '').toLowerCase();
            valB = (b.dataset.city || '').toLowerCase();
            return currentSortDirection === 'asc' ? valA.localeCompare(valB) : valB.localeCompare(valA);
        } else if (currentSortColumn === 'traffic') {
            valA = parseInt(a.dataset.bytes) || 0;
            valB = parseInt(b.dataset.bytes) || 0;
            return currentSortDirection === 'asc' ? valA - valB : valB - valA;
        } else if (currentSortColumn === 'handshake') {
            const hsA = a.dataset.lastHandshake;
            const hsB = b.dataset.lastHandshake;
            valA = hsA === 'never' ? 0 : parseInt(hsA) || 0;
            valB = hsB === 'never' ? 0 : parseInt(hsB) || 0;
            return currentSortDirection === 'asc' ? valA - valB : valB - valA;
        }
        return 0;
    }

    function updateSortIcons() {
        const sortHeaders = document.querySelectorAll('th.sortable');
        sortHeaders.forEach(th => {
            const col = th.dataset.sort;
            const icon = th.querySelector('i');
            if (icon) {
                if (col === currentSortColumn) {
                    icon.className = `fas fa-sort-${currentSortDirection === 'asc' ? 'up' : 'down'} ml-1 text-accent opacity-100 text-[10px]`;
                } else {
                    icon.className = 'fas fa-sort ml-1 opacity-45 text-[9px]';
                }
            }
        });
    }

    function applyFilters() {
        const query = searchInput ? searchInput.value.toLowerCase() : '';
        let visibleCount = 0;
        
        if (clearBtn) {
            clearBtn.classList.toggle('hidden', !query);
        }
        
        const isMobile = clientCards && window.getComputedStyle(clientCards).display !== 'none';
        const currentTime = Math.floor(Date.now() / 1000);
        
        const filterItem = (el) => {
            const name = el.dataset.name?.toLowerCase() || '';
            const ip = el.dataset.ip?.toLowerCase() || '';
            const handshakeVal = el.dataset.lastHandshake;
            
            // Check text query
            const textMatch = name.includes(query) || ip.includes(query);
            
            // Check status filter
            let statusMatch = true;
            if (currentStatusFilter !== 'all') {
                const handshakeTime = parseInt(handshakeVal);
                const isNever = !handshakeVal || handshakeVal === 'never' || isNaN(handshakeTime) || handshakeTime <= 0;
                
                if (currentStatusFilter === 'never') {
                    statusMatch = isNever;
                } else if (currentStatusFilter === 'online') {
                    statusMatch = !isNever && (currentTime - handshakeTime) < 300;
                } else if (currentStatusFilter === 'offline') {
                    statusMatch = !isNever && (currentTime - handshakeTime) >= 300;
                }
            }
            
            const match = textMatch && statusMatch;
            el.style.display = match ? '' : 'none';
            if (match) visibleCount++;
        };
        
        if (isMobile && clientCards) {
            const cards = clientCards.querySelectorAll('div.client-card');
            cards.forEach(filterItem);
        } else if (tbody) {
            const rows = tbody.querySelectorAll('tr.client-row');
            rows.forEach(filterItem);
        }
        
        if (clientCount) {
            clientCount.textContent = visibleCount;
        }
        
        const noResults = document.getElementById('noSearchResults');
        if (visibleCount === 0 && (query || currentStatusFilter !== 'all')) {
            if (!noResults) {
                const container = isMobile ? clientCards : (tbody ? tbody.parentElement : null);
                if (container) {
                    const el = document.createElement('div');
                    el.id = 'noSearchResults';
                    el.className = 'p-8 text-center text-slate-500 font-medium';
                    el.textContent = 'No matching clients found';
                    container.appendChild(el);
                }
            }
        } else if (noResults) {
            noResults.remove();
        }
    }

    if (searchInput) {
        searchInput.addEventListener('input', applyFilters);
        
        if (clearBtn) {
            clearBtn.addEventListener('click', function() {
                searchInput.value = '';
                applyFilters();
                searchInput.focus();
            });
        }
    }

    // Status Filter buttons binding
    const statusFilterBtns = document.querySelectorAll('.status-filter-btn');
    statusFilterBtns.forEach(btn => {
        btn.addEventListener('click', function() {
            statusFilterBtns.forEach(b => {
                b.classList.remove('bg-slate-800', 'text-white');
                b.classList.add('text-slate-400', 'hover:text-slate-200');
            });
            this.classList.remove('text-slate-400', 'hover:text-slate-200');
            this.classList.add('bg-slate-800', 'text-white');
            
            currentStatusFilter = this.dataset.status;
            applyFilters();
        });
    });

    // Column sorting headers binding
    const sortHeaders = document.querySelectorAll('th.sortable');
    sortHeaders.forEach(th => {
        th.addEventListener('click', function() {
            const col = this.dataset.sort;
            if (currentSortColumn === col) {
                currentSortDirection = currentSortDirection === 'asc' ? 'desc' : 'asc';
            } else {
                currentSortColumn = col;
                currentSortDirection = 'asc';
            }
            sortClients();
        });
    });

    // Start AJAX polling
    const serverId = {{ server.id }};
    
    function formatBytes(bytes) {
        if (bytes <= 0) return '0 MB';
        const k = 1024;
        const sizes = ['B', 'KB', 'MB', 'GB', 'TB', 'PB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        const clampedI = Math.max(0, Math.min(i, sizes.length - 1));
        const val = bytes / Math.pow(k, clampedI);
        const decimals = clampedI === 0 ? 0 : (clampedI === 1 ? 1 : 2);
        return val.toFixed(decimals) + ' ' + sizes[clampedI];
    }

    function formatSpeed(kbps, arrow, colorClass, labelClass) {
        if (kbps <= 0) return '';
        if (kbps >= 1000) {
            return `<span class="${colorClass} ${labelClass || ''}">${arrow}${(kbps / 1000).toFixed(1)} Mbps</span>`;
        }
        return `<span class="${colorClass}">${arrow}${Math.round(kbps)} Kbps</span>`;
    }

    async function pollClients() {
        try {
            const response = await fetch(`/api/servers/${serverId}/clients`);
            if (!response.ok) return;
            const data = await response.json();
            if (!data.success) return;

            // Update Agent Badge & Button
            const agentStatusBadge = document.getElementById('agentStatusBadge');
            const agentStatusDot = document.getElementById('agentStatusDot');
            const agentStatusText = document.getElementById('agentStatusText');
            const installAgentBtnText = document.getElementById('installAgentBtnText');
            if (agentStatusBadge && agentStatusDot && agentStatusText) {
                if (data.agent_online) {
                    agentStatusBadge.className = 'text-xs px-2 py-1 rounded-md flex items-center bg-emerald-500/10 text-emerald-400 border border-emerald-500/30';
                    agentStatusDot.className = 'w-1.5 h-1.5 rounded-full bg-emerald-400 mr-1.5';
                    agentStatusText.textContent = 'Agent Online';
                    if (installAgentBtnText) installAgentBtnText.textContent = 'Reinstall Agent';
                } else {
                    agentStatusBadge.className = 'text-xs px-2 py-1 rounded-md flex items-center bg-amber-500/10 text-amber-400 border border-amber-500/30';
                    agentStatusDot.className = 'w-1.5 h-1.5 rounded-full bg-amber-400 mr-1.5';
                    agentStatusText.textContent = 'Agent Offline';
                    if (installAgentBtnText) installAgentBtnText.textContent = 'Install Agent';
                }
            }

            data.clients.forEach(client => {
                const rawHandshake = client.last_handshake_raw !== null ? client.last_handshake_raw : 'never';
                const totalBytes = (client.bytes_sent || 0) + (client.bytes_received || 0);

                // Update Desktop Table Row
                const row = document.querySelector(`tr.client-row[data-client-id="${client.id}"]`);
                if (row) {
                    row.dataset.lastHandshake = rawHandshake;
                    row.dataset.bytes = totalBytes;
                    row.dataset.city = client.city || '';

                    const uploadEl = row.querySelector('.upload-bytes');
                    const downloadEl = row.querySelector('.download-bytes');
                    if (uploadEl) uploadEl.textContent = '↑' + formatBytes(client.bytes_sent || 0);
                    if (downloadEl) downloadEl.textContent = '↓' + formatBytes(client.bytes_received || 0);

                    const cityContainer = row.querySelector('.city-container');
                    if (cityContainer) {
                        cityContainer.textContent = client.city || '—';
                    }

                    const speedContainer = row.querySelector('.speed-container');
                    if (speedContainer) {
                        let speedHtml = '';
                        if (client.status === 'active') {
                            const speedUpHtml = formatSpeed(client.stats.speed_up_raw || 0, '↑', 'text-emerald-400', 'font-semibold');
                            const speedDownHtml = formatSpeed(client.stats.speed_down_raw || 0, '↓', 'text-indigo-400', 'font-semibold');
                            if (speedUpHtml || speedDownHtml) {
                                speedHtml = speedUpHtml + (speedUpHtml && speedDownHtml ? ' ' : '') + speedDownHtml;
                            }
                        }
                        speedContainer.innerHTML = speedHtml;
                    }

                    const handshakeContainer = row.querySelector('.handshake-container');
                    if (handshakeContainer) {
                        handshakeContainer.innerHTML = client.last_handshake 
                            ? `<span class="text-xs text-slate-400">${client.last_handshake}</span>`
                            : '<span class="text-xs text-slate-600">Never</span>';
                    }
                }

                // Update Mobile Card
                const card = document.querySelector(`.client-card[data-client-id="${client.id}"]`);
                if (card) {
                    card.dataset.lastHandshake = rawHandshake;
                    card.dataset.bytes = totalBytes;
                    card.dataset.city = client.city || '';

                    const uploadEl = card.querySelector('.upload-bytes');
                    const downloadEl = card.querySelector('.download-bytes');
                    if (uploadEl) uploadEl.textContent = '↑' + formatBytes(client.bytes_sent || 0);
                    if (downloadEl) downloadEl.textContent = '↓' + formatBytes(client.bytes_received || 0);

                    const cardIpVal = card.querySelector('.card-ip-value');
                    if (cardIpVal) {
                        cardIpVal.textContent = client.client_ip + (client.city ? ` (${client.city})` : '');
                    }

                    const speedContainer = card.querySelector('.speed-container');
                    if (speedContainer) {
                        let speedHtml = '';
                        if (client.status === 'active') {
                            const speedUpHtml = formatSpeed(client.stats.speed_up_raw || 0, '↑', 'text-emerald-400', 'font-semibold');
                            const speedDownHtml = formatSpeed(client.stats.speed_down_raw || 0, '↓', 'text-indigo-400', 'font-semibold');
                            if (speedUpHtml || speedDownHtml) {
                                speedHtml = speedUpHtml + ' ' + speedDownHtml;
                            }
                        }
                        speedContainer.innerHTML = speedHtml;
                    }

                    const handshakeValue = card.querySelector('.handshake-value');
                    if (handshakeValue) {
                        handshakeValue.textContent = client.last_handshake || 'Never';
                    }
                }
            });

            // Re-apply sorting
            sortClients();

            // Re-apply filters to sync the visible display and counts on poll update
            applyFilters();

        } catch (error) {
            console.error('Failed to poll clients:', error);
        }
    }

    // Run immediately and then poll every 5 seconds
    pollClients();
    sortClients();
    setInterval(pollClients, 5000);
});

async function syncAllStats(serverId) {
    const btn = document.getElementById('syncBtn');
    const originalContent = btn.innerHTML;
    
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-sync-alt fa-spin mr-2"></i>Syncing...';
    
    try {
        const response = await fetch(`/servers/${serverId}/sync-stats`, { method: 'POST' });
        const data = await response.json();
        if (data.success) {
            location.reload();
        } else {
            showToast('Failed to sync: ' + (data.error || 'Unknown error'), 'error');
            btn.innerHTML = originalContent;
            btn.disabled = false;
        }
    } catch (error) {
        showToast('Error: ' + error.message, 'error');
        btn.innerHTML = originalContent;
        btn.disabled = false;
    }
}

async function installAgent(serverId) {
    const btn = document.getElementById('installAgentBtn');
    const originalContent = btn.innerHTML;
    
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Installing...';
    
    try {
        const response = await fetch(`/servers/${serverId}/deploy-monitoring`, { method: 'POST' });
        const data = await response.json();
        if (data.success) {
            showToast('Monitoring agent installed successfully!', 'success');
            setTimeout(() => location.reload(), 1500);
        } else {
            showToast('Failed to install agent: ' + (data.error || 'Unknown error'), 'error');
            btn.innerHTML = originalContent;
            btn.disabled = false;
        }
    } catch (error) {
        showToast('Error: ' + error.message, 'error');
        btn.innerHTML = originalContent;
        btn.disabled = false;
    }
}
</script>

<!-- Delete Server Password Modal -->
<div id="deleteServerModal" class="fixed inset-0 z-50 flex items-center justify-center hidden" role="dialog" aria-modal="true" aria-labelledby="deleteServerModalTitle">
    <!-- Backdrop -->
    <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" onclick="closeDeleteServerModal()"></div>
    <!-- Dialog -->
    <div class="relative z-10 w-full max-w-md mx-4 bg-slate-900 border border-slate-700 rounded-2xl shadow-2xl p-6 animate-in">
        <div class="flex items-center gap-3 mb-5">
            <div class="w-10 h-10 rounded-lg bg-red-500/15 border border-red-500/30 flex items-center justify-center shrink-0">
                <i class="fas fa-trash-alt text-red-400"></i>
            </div>
            <div>
                <h2 id="deleteServerModalTitle" class="text-lg font-semibold text-white">Delete Server</h2>
                <p id="deleteServerModalSubtitle" class="text-sm text-slate-400 mt-0.5"></p>
            </div>
        </div>

        <div class="bg-red-500/10 border border-red-500/30 rounded-lg px-4 py-3 mb-5 text-sm text-red-300 flex items-start gap-2">
            <i class="fas fa-exclamation-triangle text-red-400 mt-0.5 shrink-0"></i>
            <span>This action is <strong>irreversible</strong>. All clients and configurations associated with this server will be permanently removed.</span>
        </div>

        <form id="deleteServerForm" method="POST" action="" onsubmit="return handleDeleteServerSubmit(event)">
            <input type="hidden" name="admin_password" id="deleteServerPasswordInput">
            <div class="mb-4">
                <label for="deleteServerPasswordVisible" class="block text-sm font-medium text-slate-300 mb-1.5">
                    Confirm with your password
                </label>
                <div class="relative">
                    <input type="password" id="deleteServerPasswordVisible"
                           autocomplete="current-password"
                           placeholder="Enter your admin password"
                           class="w-full bg-slate-800 border border-slate-600 focus:border-red-500/70 focus:ring-1 focus:ring-red-500/40 rounded-lg px-4 py-2.5 pr-10 text-sm text-white placeholder-slate-500 outline-none transition-colors">
                    <button type="button" onclick="toggleDeletePasswordVisibility()" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-500 hover:text-slate-300 transition-colors" tabindex="-1">
                        <i id="deletePasswordEyeIcon" class="fas fa-eye text-sm"></i>
                    </button>
                </div>
            </div>
            <div id="deleteServerError" class="hidden mb-4 text-sm text-red-400 flex items-center gap-1.5">
                <i class="fas fa-times-circle"></i>
                <span id="deleteServerErrorMsg">Incorrect password.</span>
            </div>
            <div class="flex gap-3">
                <button type="button" onclick="closeDeleteServerModal()" class="flex-1 px-4 py-2.5 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-200 text-sm font-medium transition-colors">
                    Cancel
                </button>
                <button type="submit" id="deleteServerSubmitBtn" class="flex-1 px-4 py-2.5 rounded-lg bg-red-500/20 hover:bg-red-500/30 text-red-400 border border-red-500/40 text-sm font-medium transition-colors">
                    <i class="fas fa-trash-alt mr-1.5"></i>Delete Server
                </button>
            </div>
        </form>
    </div>
</div>

<script>
let _deleteServerId = null;

function openDeleteServerModal(serverId, serverName) {
    _deleteServerId = serverId;
    document.getElementById('deleteServerModalSubtitle').textContent = 'Server: ' + serverName;
    document.getElementById('deleteServerForm').action = '/servers/' + serverId + '/delete';
    document.getElementById('deleteServerPasswordVisible').value = '';
    document.getElementById('deleteServerPasswordInput').value = '';
    document.getElementById('deleteServerError').classList.add('hidden');
    document.getElementById('deleteServerModal').classList.remove('hidden');
    setTimeout(() => document.getElementById('deleteServerPasswordVisible').focus(), 100);
}

function closeDeleteServerModal() {
    document.getElementById('deleteServerModal').classList.add('hidden');
    _deleteServerId = null;
}

function toggleDeletePasswordVisibility() {
    const input = document.getElementById('deleteServerPasswordVisible');
    const icon  = document.getElementById('deletePasswordEyeIcon');
    if (input.type === 'password') {
        input.type = 'text';
        icon.className = 'fas fa-eye-slash text-sm';
    } else {
        input.type = 'password';
        icon.className = 'fas fa-eye text-sm';
    }
}

function handleDeleteServerSubmit(e) {
    e.preventDefault();
    const visibleInput = document.getElementById('deleteServerPasswordVisible');
    const password = visibleInput.value.trim();
    if (!password) {
        showDeleteServerError('Please enter your password.');
        return false;
    }
    // Copy value to the hidden input that will be submitted
    document.getElementById('deleteServerPasswordInput').value = password;

    const btn = document.getElementById('deleteServerSubmitBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1.5"></i>Deleting…';
    document.getElementById('deleteServerError').classList.add('hidden');

    const form = document.getElementById('deleteServerForm');
    const formData = new FormData(form);

    fetch(form.action, {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' },
        body: formData
    }).then(async res => {
        if (res.ok) {
            window.location.href = '/servers';
        } else {
            const data = await res.json().catch(() => ({}));
            showDeleteServerError(data.error || 'Incorrect password. Server not deleted.');
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-trash-alt mr-1.5"></i>Delete Server';
        }
    }).catch(() => {
        showDeleteServerError('Network error. Please try again.');
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-trash-alt mr-1.5"></i>Delete Server';
    });

    return false;
}

function showDeleteServerError(msg) {
    const el = document.getElementById('deleteServerError');
    document.getElementById('deleteServerErrorMsg').textContent = msg;
    el.classList.remove('hidden');
}

// Close modal on Escape key
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeDeleteServerModal();
});
</script>
