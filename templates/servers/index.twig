{% extends "layout.twig" %}

{% block title %}{{ t('servers.title') }}{% endblock %}

{% block breadcrumbs %}
    <li><a href="/dashboard" class="hover:text-base-content transition-colors">Home</a></li>
    <li><span class="text-base-content/70">Servers</span></li>
{% endblock %}

{% block content %}
<div class="w-full">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
        <h1 class="text-2xl font-bold flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-base-300 text-primary flex items-center justify-center">
                <i class="fas fa-server"></i>
            </div>
            {{ t('servers.title') }}
        </h1>
        <a href="/servers/create" class="btn btn-primary btn-sm gap-2">
            <i class="fas fa-plus"></i>
            {{ t('servers.add') }}
        </a>
    </div>

    {% if servers|length > 0 %}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {% for server in servers %}
        <div class="card bg-base-200 border border-base-300 shadow hover:-translate-y-1 hover:border-base-content/20 transition-all duration-300 server-card" data-server-id="{{ server.id }}">
            <div class="card-body p-5">
                <div class="flex items-start justify-between mb-3">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-base-300 text-primary flex items-center justify-center shrink-0">
                            <i class="fas fa-server"></i>
                        </div>
                        <div>
                            <h3 class="font-semibold text-base-content">{{ server.name }}</h3>
                            <code class="text-xs text-base-content/50">{{ server.host }}</code>
                        </div>
                    </div>
                    <span class="status-badge badge badge-sm inline-flex items-center gap-1 leading-none {% if server.status == 'active' %}badge-success{% elseif server.status == 'deploying' %}badge-warning{% else %}badge-error{% endif %}">
                        <span class="status-dot w-1.5 h-1.5 rounded-full shrink-0 {% if server.status == 'active' %}bg-success{% elseif server.status == 'deploying' %}bg-warning{% else %}bg-error{% endif %}"></span>
                        <span class="status-text">
                            {% if server.status == 'active' %}Active{% elseif server.status == 'deploying' %}Deploying{% else %}Offline{% endif %}
                        </span>
                    </span>
                </div>

                <div class="grid grid-cols-2 gap-2 mb-2">
                    <div class="bg-base-300/50 p-2 rounded-lg text-xs">
                        <span class="text-base-content/40 block mb-0.5">VPN Port</span>
                        <span class="font-mono font-medium">{{ server.vpn_port }}</span>
                    </div>
                    <div class="bg-base-300/50 p-2 rounded-lg text-xs">
                        <span class="text-base-content/40 block mb-0.5">Clients</span>
                        <span class="font-mono font-medium client-count">{{ server.client_count|default(0) }}</span>
                    </div>
                </div>

                <div class="bg-base-300/50 p-2 rounded-lg mb-3 text-xs flex justify-between items-center">
                    <span class="text-base-content/40">Live Traffic Speed</span>
                    <div class="font-mono speed-value">
                        {% if server.speed_up_kbps > 0 or server.speed_down_kbps > 0 %}
                            <span class="text-success font-semibold">
                                ↑{% if server.speed_up_kbps >= 1000 %}{{ (server.speed_up_kbps / 1000)|number_format(1) }} Mbps{% else %}{{ server.speed_up_kbps|number_format(0) }} Kbps{% endif %}
                            </span>
                            <span class="text-base-content/20 mx-1">|</span>
                            <span class="text-indigo-400 font-semibold">
                                ↓{% if server.speed_down_kbps >= 1000 %}{{ (server.speed_down_kbps / 1000)|number_format(1) }} Mbps{% else %}{{ server.speed_down_kbps|number_format(0) }} Kbps{% endif %}
                            </span>
                        {% else %}
                            <span class="text-base-content/30">Idle (0 Kbps)</span>
                        {% endif %}
                    </div>
                </div>

                <div class="card-actions border-t border-base-300 pt-3">
                    <a href="/servers/{{ server.id }}" class="btn btn-outline btn-sm flex-1 gap-2">
                        <i class="fas fa-eye"></i>
                        {{ t('servers.view') }}
                    </a>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
    {% else %}
    <div class="card bg-base-200 border border-base-300 shadow">
        <div class="card-body items-center text-center py-12">
            <div class="w-16 h-16 rounded-full bg-base-300 flex items-center justify-center mb-4">
                <i class="fas fa-server text-base-content/20 text-2xl"></i>
            </div>
            <h2 class="card-title text-xl">No Servers Yet</h2>
            <p class="text-base-content/50">Get started by adding your first VPN server.</p>
            <div class="card-actions mt-2">
                <a href="/servers/create" class="btn btn-primary gap-2">
                    <i class="fas fa-plus"></i>
                    Add Your First Server
                </a>
            </div>
        </div>
    </div>
    {% endif %}
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    function formatSpeed(kbps, arrow, colorClass, labelClass) {
        if (kbps <= 0) return '';
        const speedStr = kbps >= 1000 ? (kbps / 1000).toFixed(1) + ' Mbps' : Math.round(kbps) + ' Kbps';
        return `<span class="${colorClass} ${labelClass || ''}">${arrow}${speedStr}</span>`;
    }
    function formatServerCardSpeed(upKbps, downKbps) {
        if (upKbps <= 0 && downKbps <= 0) return '<span class="text-base-content/30">Idle (0 Kbps)</span>';
        let html = '';
        html += upKbps > 0 ? formatSpeed(upKbps, '↑', 'text-success', 'font-semibold') : '<span class="text-base-content/30">↑0 Kbps</span>';
        html += '<span class="text-base-content/20 mx-1">|</span>';
        html += downKbps > 0 ? formatSpeed(downKbps, '↓', 'text-indigo-400', 'font-semibold') : '<span class="text-base-content/30">↓0 Kbps</span>';
        return html;
    }

    async function pollServers() {
        try {
            const response = await fetch('/api/servers');
            if (!response.ok) return;
            const data = await response.json();
            if (!data.servers) return;

            data.servers.forEach(server => {
                const card = document.querySelector(`.server-card[data-server-id="${server.id}"]`);
                if (card) {
                    const statusBadge = card.querySelector('.status-badge');
                    const statusDot = card.querySelector('.status-dot');
                    const statusText = card.querySelector('.status-text');

                    if (statusBadge && statusDot && statusText) {
                        const status = server.status || 'offline';
                        const badgeClasses = { active: 'badge-success', deploying: 'badge-warning', offline: 'badge-error' };
                        const dotClasses  = { active: 'bg-success', deploying: 'bg-warning', offline: 'bg-error' };
                        const labels      = { active: 'Active', deploying: 'Deploying', offline: 'Offline' };
                         statusBadge.className = `status-badge badge badge-sm inline-flex items-center gap-1 leading-none ${badgeClasses[status] || 'badge-error'}`;
                         statusDot.className = `status-dot w-1.5 h-1.5 rounded-full shrink-0 ${dotClasses[status] || 'bg-error'}`;
                        statusText.textContent = labels[status] || 'Offline';
                    }

                    const clientCountEl = card.querySelector('.client-count');
                    if (clientCountEl) clientCountEl.textContent = server.client_count || 0;

                    const speedValEl = card.querySelector('.speed-value');
                    if (speedValEl) {
                        const up = parseFloat(server.speed_up_kbps) || 0;
                        const down = parseFloat(server.speed_down_kbps) || 0;
                        speedValEl.innerHTML = formatServerCardSpeed(up, down);
                    }
                }
            });
        } catch (error) { console.error('Failed to poll servers index page metrics:', error); }
    }

    setInterval(pollServers, 8000);
});
</script>
{% endblock %}
