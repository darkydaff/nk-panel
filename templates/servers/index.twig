{% extends "layout.twig" %}

{% block title %}{{ t('servers.title') }}{% endblock %}

{% block breadcrumbs %}
    <a href="/dashboard" class="hover:text-slate-300 transition-colors">Home</a>
    <i class="fas fa-chevron-right text-[10px] text-slate-700 mx-1"></i>
    <span class="text-slate-300">Servers</span>
{% endblock %}

{% block content %}
<div class="w-full">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
        <div>
            <h1 class="text-2xl font-bold text-white flex items-center">
                <div class="w-10 h-10 rounded-lg bg-slate-700 text-accent flex items-center justify-center mr-3">
                    <i class="fas fa-server"></i>
                </div>
                {{ t('servers.title') }}
            </h1>
        </div>
        <a href="/servers/create" class="btn-primary flex items-center px-5 py-2.5 text-sm">
            <i class="fas fa-plus mr-2"></i> {{ t('servers.add') }}
        </a>
    </div>

    {% if servers|length > 0 %}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {% for server in servers %}
        <div class="panel p-5 hover:border-slate-500 transition-colors server-card" data-server-id="{{ server.id }}">
            <div class="flex items-start justify-between mb-4">
                <div class="flex items-center">
                    <div class="w-10 h-10 rounded-lg bg-slate-700 text-accent flex items-center justify-center mr-3">
                        <i class="fas fa-server"></i>
                    </div>
                    <div>
                        <h3 class="text-white font-semibold">{{ server.name }}</h3>
                        <code class="text-xs text-slate-400">{{ server.host }}</code>
                    </div>
                </div>
                <span class="status-badge text-xs px-2 py-1 rounded-md flex items-center {% if server.status == 'active' %}badge-active{% elseif server.status == 'deploying' %}badge-warning{% else %}badge-error{% endif %}">
                    <span class="status-dot w-1.5 h-1.5 rounded-full {% if server.status == 'active' %}bg-cyan-400{% elseif server.status == 'deploying' %}bg-yellow-400{% else %}bg-red-400{% endif %} mr-1.5"></span>
                    <span class="status-text">
                        {% if server.status == 'active' %}Active{% elseif server.status == 'deploying' %}Deploying{% else %}Offline{% endif %}
                    </span>
                </span>
            </div>
            
            <div class="grid grid-cols-2 gap-2 mb-2 text-xs">
                <div class="bg-slate-800/50 p-2 rounded">
                    <span class="text-slate-500 block mb-0.5">VPN Port</span>
                    <span class="text-slate-300 font-mono">{{ server.vpn_port }}</span>
                </div>
                <div class="bg-slate-800/50 p-2 rounded">
                    <span class="text-slate-500 block mb-0.5">Clients</span>
                    <span class="text-slate-300 client-count">{{ server.client_count|default(0) }}</span>
                </div>
            </div>
            
            <div class="bg-slate-800/50 p-2 rounded mb-4 text-xs flex justify-between items-center">
                <span class="text-slate-500">Live Traffic Speed</span>
                <div class="font-mono text-slate-300 speed-value">
                    {% if server.speed_up_kbps > 0 or server.speed_down_kbps > 0 %}
                        <span class="text-emerald-400 font-semibold">
                            ↑{% if server.speed_up_kbps >= 1000 %}{{ (server.speed_up_kbps / 1000)|number_format(1) }} Mbps{% else %}{{ server.speed_up_kbps|number_format(0) }} Kbps{% endif %}
                        </span>
                        <span class="text-slate-600 mx-1">|</span>
                        <span class="text-indigo-400 font-semibold">
                            ↓{% if server.speed_down_kbps >= 1000 %}{{ (server.speed_down_kbps / 1000)|number_format(1) }} Mbps{% else %}{{ server.speed_down_kbps|number_format(0) }} Kbps{% endif %}
                        </span>
                    {% else %}
                        <span class="text-slate-500">Idle (0 Kbps)</span>
                    {% endif %}
                </div>
            </div>
            
            <div class="flex gap-2 pt-3 border-t border-slate-700">
                <a href="/servers/{{ server.id }}" class="btn-secondary flex-1 text-center py-2 text-xs">
                    <i class="fas fa-eye mr-1"></i> {{ t('servers.view') }}
                </a>
                <form method="POST" action="/servers/{{ server.id }}/delete" class="inline" onsubmit="return confirm('Delete server {{ server.name }}?');">
                    <button type="submit" class="px-3 py-2 rounded-lg bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/30 transition-colors text-xs" title="Delete">
                        <i class="fas fa-trash-alt"></i>
                    </button>
                </form>
            </div>
        </div>
        {% endfor %}
    </div>
    {% else %}
    <div class="panel p-12 text-center">
        <div class="w-16 h-16 rounded-full bg-slate-800 flex items-center justify-center mx-auto mb-4">
            <i class="fas fa-server text-slate-600 text-2xl"></i>
        </div>
        <h2 class="text-xl text-white mb-2">No Servers Yet</h2>
        <p class="text-slate-400 mb-6">Get started by adding your first VPN server.</p>
        <a href="/servers/create" class="btn-primary inline-flex items-center px-6 py-3">
            <i class="fas fa-plus mr-2"></i> Add Your First Server
        </a>
    </div>
    {% endif %}
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    function formatSpeed(kbps, arrow, colorClass, labelClass) {
        if (kbps <= 0) return '';
        const speedStr = kbps >= 1000 ? (kbps / 1000).toFixed(1) + ' Mbps' : Math.round(kbps) + ' Kbps';
        return `<span class="${colorClass} ${labelClass || ''}">${arrow}${speedStr}</span>`;
    }

    function formatServerCardSpeed(upKbps, downKbps) {
        if (upKbps <= 0 && downKbps <= 0) {
            return '<span class="text-slate-500">Idle (0 Kbps)</span>';
        }
        
        let html = '';
        if (upKbps > 0) {
            html += formatSpeed(upKbps, '↑', 'text-emerald-400', 'font-semibold');
        } else {
            html += '<span class="text-slate-500">↑0 Kbps</span>';
        }
        
        html += '<span class="text-slate-600 mx-1">|</span>';
        
        if (downKbps > 0) {
            html += formatSpeed(downKbps, '↓', 'text-indigo-400', 'font-semibold');
        } else {
            html += '<span class="text-slate-500">↓0 Kbps</span>';
        }
        
        return html;
    }

    async function pollServers() {
        try {
            const response = await fetch('/api/servers');
            if (!response.ok) return;
            const data = await response.json();
            if (!data.servers) return;

            data.servers.forEach(server => {
                const card = document.querySelector(`.server-card[data-server-id="${server.id}"]`);
                if (card) {
                    // Update Status Badge
                    const statusBadge = card.querySelector('.status-badge');
                    const statusDot = card.querySelector('.status-dot');
                    const statusText = card.querySelector('.status-text');
                    
                    if (statusBadge && statusDot && statusText) {
                        const status = server.status || 'offline';
                        if (status === 'active') {
                            statusBadge.className = 'status-badge text-xs px-2 py-1 rounded-md flex items-center badge-active';
                            statusDot.className = 'status-dot w-1.5 h-1.5 rounded-full bg-cyan-400 mr-1.5';
                            statusText.textContent = 'Active';
                        } else if (status === 'deploying') {
                            statusBadge.className = 'status-badge text-xs px-2 py-1 rounded-md flex items-center badge-warning';
                            statusDot.className = 'status-dot w-1.5 h-1.5 rounded-full bg-yellow-400 mr-1.5';
                            statusText.textContent = 'Deploying';
                        } else {
                            statusBadge.className = 'status-badge text-xs px-2 py-1 rounded-md flex items-center badge-error';
                            statusDot.className = 'status-dot w-1.5 h-1.5 rounded-full bg-red-400 mr-1.5';
                            statusText.textContent = 'Offline';
                        }
                    }

                    // Update Client Count
                    const clientCountEl = card.querySelector('.client-count');
                    if (clientCountEl) {
                        clientCountEl.textContent = server.client_count || 0;
                    }

                    // Update Live Traffic Speed
                    const speedValEl = card.querySelector('.speed-value');
                    if (speedValEl) {
                        const up = parseFloat(server.speed_up_kbps) || 0;
                        const down = parseFloat(server.speed_down_kbps) || 0;
                        speedValEl.innerHTML = formatServerCardSpeed(up, down);
                    }
                }
            });

        } catch (error) {
            console.error('Failed to poll servers index page metrics:', error);
        }
    }

    // Run polling every 8 seconds
    setInterval(pollServers, 8000);
});
</script>
{% endblock %}
