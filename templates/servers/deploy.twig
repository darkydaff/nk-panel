{% extends "layout.twig" %}
{% block title %}Deploy {{ server.name }}{% endblock %}

{% block breadcrumbs %}
    <a href="/dashboard" class="hover:text-slate-300 transition-colors">Home</a>
    <i class="fas fa-chevron-right text-[10px] text-slate-700 mx-1"></i>
    <a href="/servers" class="hover:text-slate-300 transition-colors">Servers</a>
    <i class="fas fa-chevron-right text-[10px] text-slate-700 mx-1"></i>
    <a href="/servers/{{ server.id }}" class="hover:text-slate-300 transition-colors">{{ server.name }}</a>
    <i class="fas fa-chevron-right text-[10px] text-slate-700 mx-1"></i>
    <span class="text-slate-300">Deployment</span>
{% endblock %}

{% block content %}
<div class="max-w-4xl mx-auto px-4 py-8 w-full">
    <div class="mb-8 text-center">
        <div class="w-16 h-16 rounded-xl bg-slate-700 text-accent flex items-center justify-center mx-auto mb-4">
            <i class="fas fa-rocket text-3xl"></i>
        </div>
        <h1 class="text-2xl font-bold text-white mb-2">Deploying: {{ server.name }}</h1>
        <p class="text-slate-400">Initializing server deployment on <code class="text-cyan-400">{{ server.host }}</code></p>
    </div>

    <div class="panel p-2 mb-6">
        <div class="flex items-center gap-2 px-4 py-2 bg-slate-800 rounded-t-lg border-b border-slate-700">
            <div class="w-3 h-3 rounded-full bg-red-500"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
            <div class="w-3 h-3 rounded-full bg-green-500"></div>
            <span class="ml-3 text-xs font-mono text-slate-500">root@{{ server.host }}:~</span>
        </div>
        
        <div id="deployLog" class="bg-slate-900 text-cyan-400 p-4 rounded-b-lg font-mono text-sm leading-relaxed h-[300px] overflow-y-auto">
            <div class="text-slate-500 mb-2">amnezia@panel:~$ ./deploy.sh</div>
            <div class="text-slate-400">Ready to deploy...</div>
        </div>
    </div>

    <div class="text-center">
        <button id="deployBtn" onclick="deploy()" class="btn-primary px-8 py-3 text-base font-semibold">
            <span id="btnText">Start Deployment</span>
            <i id="btnSpinner" class="fas fa-spinner fa-spin ml-2 hidden"></i>
            <i class="fas fa-rocket ml-2" id="btnIcon"></i>
        </button>
    </div>
</div>

<script>
function deploy() {
    const btn = document.getElementById('deployBtn');
    const btnText = document.getElementById('btnText');
    const btnSpinner = document.getElementById('btnSpinner');
    const btnIcon = document.getElementById('btnIcon');
    const log = document.getElementById('deployLog');
    
    btn.disabled = true;
    btnText.textContent = 'Deploying...';
    btnSpinner.classList.remove('hidden');
    if(btnIcon) btnIcon.classList.add('hidden');
    
    log.innerHTML = '<div class="text-slate-500 mb-2">amnezia@panel:~$ ./deploy.sh</div>';
    log.innerHTML += '<div class="text-cyan-400 mb-2">Connecting to server...</div>';
    
    setTimeout(() => log.innerHTML += '<div class="text-blue-400 mb-2">Installing Docker engine...</div>', 800);
    setTimeout(() => log.innerHTML += '<div class="text-slate-400 mb-2">Building AmneziaWG from source...</div>', 1600);
    setTimeout(() => log.innerHTML += '<div class="text-yellow-400 mb-2">Generating cryptographic keys...</div>', 2400);
    
    fetch('/servers/{{ server.id }}/deploy', {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(async (r) => {
        const raw = await r.text();
        let d;
        try { d = JSON.parse(raw); }
        catch (e) { throw new Error('Server returned non-JSON: ' + raw.slice(0, 240)); }
        if (!r.ok && !d.error) d.error = 'HTTP ' + r.status;
        return d;
    })
    .then(d => {
        if (d.success) {
            log.innerHTML += '<div class="text-cyan-400 font-bold mt-4 p-2 bg-cyan-500/10 border border-cyan-500/30 rounded">Deployment successful!</div>';
            log.innerHTML += '<div class="text-slate-400 mt-2">VPN Port: ' + d.vpn_port + '</div>';
            btnText.textContent = 'Redirecting...';
            btnSpinner.classList.add('hidden');
            log.scrollTop = log.scrollHeight;
            setTimeout(() => window.location.href = '/servers/{{ server.id }}', 2500);
        } else {
            log.innerHTML += '<div class="text-red-400 font-bold mt-4 p-2 bg-red-500/10 border border-red-500/30 rounded">Error: ' + (d.error || 'Unknown error') + '</div>';
            btn.disabled = false;
            btnText.textContent = 'Retry Deployment';
            btnSpinner.classList.add('hidden');
            if(btnIcon) btnIcon.classList.remove('hidden');
        }
    })
    .catch(e => {
        log.innerHTML += '<div class="text-red-400 font-bold mt-4 p-2 bg-red-500/10 border border-red-500/30 rounded">Network error: ' + e.message + '</div>';
        btn.disabled = false;
        btnText.textContent = 'Retry Deployment';
        btnSpinner.classList.add('hidden');
        if(btnIcon) btnIcon.classList.remove('hidden');
    });
}
</script>
{% endblock %}
