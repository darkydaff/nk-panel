{% extends "layout.twig" %}
{% block title %}Deploy {{ server.name }}{% endblock %}

{% block breadcrumbs %}
    <li><a href="/dashboard" class="hover:text-base-content transition-colors">Home</a></li>
    <li><a href="/servers" class="hover:text-base-content transition-colors">Servers</a></li>
    <li><a href="/servers/{{ server.id }}" class="hover:text-base-content transition-colors">{{ server.name }}</a></li>
    <li><span class="text-base-content/70">Deployment</span></li>
{% endblock %}

{% block content %}
<div class="max-w-4xl mx-auto w-full">
    <div class="mb-8 text-center">
        <div class="w-16 h-16 rounded-2xl bg-base-300 border border-base-content/10 text-primary flex items-center justify-center mx-auto mb-4">
            <i class="fas fa-rocket text-3xl"></i>
        </div>
        <h1 class="text-2xl font-bold mb-2">Deploying: {{ server.name }}</h1>
        <p class="text-base-content/50 text-sm">
            Initializing server deployment on
            <code class="text-info font-mono bg-base-300 border border-base-content/10 px-2 py-0.5 rounded">{{ server.host }}</code>
        </p>
    </div>

    <!-- Terminal Mockup -->
    <div class="mockup-code mb-6 text-sm" id="deployLogWrapper">
        <pre data-prefix="$"><code>amnezia@panel:~$ ./deploy.sh</code></pre>
        <div id="deployLog" class="px-4 pb-4 max-h-[280px] overflow-y-auto space-y-1">
            <div class="text-base-content/40 text-xs">Ready to deploy...</div>
        </div>
    </div>

    <div class="text-center">
        <button id="deployBtn" onclick="deploy()" class="btn btn-primary btn-lg gap-3">
            <span id="btnText">Start Deployment</span>
            <i id="btnSpinner" class="fas fa-spinner fa-spin hidden"></i>
            <i class="fas fa-rocket" id="btnIcon"></i>
        </button>
    </div>
</div>

<script>
function addLog(text, colorClass) {
    const log = document.getElementById('deployLog');
    const div = document.createElement('div');
    div.className = `text-xs ${colorClass || 'text-base-content/60'}`;
    div.textContent = text;
    log.appendChild(div);
    log.scrollTop = log.scrollHeight;
}

function deploy() {
    const btn = document.getElementById('deployBtn');
    const btnText = document.getElementById('btnText');
    const btnSpinner = document.getElementById('btnSpinner');
    const btnIcon = document.getElementById('btnIcon');
    const log = document.getElementById('deployLog');

    btn.disabled = true;
    btnText.textContent = 'Deploying...';
    btnSpinner.classList.remove('hidden');
    if (btnIcon) btnIcon.classList.add('hidden');

    log.innerHTML = '';
    addLog('Connecting to server...', 'text-info');

    setTimeout(() => addLog('Installing Docker engine...', 'text-primary'), 800);
    setTimeout(() => addLog('Building AmneziaWG from source...', 'text-base-content/50'), 1600);
    setTimeout(() => addLog('Generating cryptographic keys...', 'text-warning'), 2400);

    fetch('/servers/{{ server.id }}/deploy', {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(async (r) => {
        const raw = await r.text();
        let d;
        try { d = JSON.parse(raw); }
        catch (e) { throw new Error('Server returned non-JSON: ' + raw.slice(0, 240)); }
        if (!r.ok && !d.error) d.error = 'HTTP ' + r.status;
        return d;
    })
    .then(d => {
        if (d.success) {
            addLog('Deployment successful!', 'text-success font-bold');
            addLog('VPN Port: ' + d.vpn_port, 'text-base-content/50');
            btnText.textContent = 'Redirecting...';
            btnSpinner.classList.add('hidden');
            setTimeout(() => window.location.href = '/servers/{{ server.id }}', 2500);
        } else {
            addLog('Error: ' + (d.error || 'Unknown error'), 'text-error font-bold');
            btn.disabled = false;
            btnText.textContent = 'Retry Deployment';
            btnSpinner.classList.add('hidden');
            if (btnIcon) btnIcon.classList.remove('hidden');
        }
    })
    .catch(e => {
        addLog('Network error: ' + e.message, 'text-error font-bold');
        btn.disabled = false;
        btnText.textContent = 'Retry Deployment';
        btnSpinner.classList.add('hidden');
        if (btnIcon) btnIcon.classList.remove('hidden');
    });
}
</script>
{% endblock %}
