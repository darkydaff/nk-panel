{% extends "layout.twig" %}
{% block title %}Add Server{% endblock %}

{% block breadcrumbs %}
    <li><a href="/dashboard" class="hover:text-base-content transition-colors">Home</a></li>
    <li><a href="/servers" class="hover:text-base-content transition-colors">Servers</a></li>
    <li><span class="text-base-content/70">Add Server</span></li>
{% endblock %}

{% block content %}
<div class="max-w-3xl mx-auto w-full">
    <div class="mb-6">
        <h1 class="text-2xl font-bold flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-base-300 border border-base-content/10 text-primary flex items-center justify-center">
                <i class="fas fa-plus-circle"></i>
            </div>
            Add New Server
        </h1>
        <p class="mt-2 ml-13 text-base-content/50 text-sm">Deploy a new Amnezia VPN instance or import an existing configuration.</p>
    </div>

    {% if error %}
    <div class="alert alert-error mb-6">
        <i class="fas fa-exclamation-circle"></i>
        <span>{{ error }}</span>
    </div>
    {% endif %}

    <form method="POST" enctype="multipart/form-data" class="card bg-base-200 border border-base-300 shadow-xl">
        <div class="card-body p-6 md:p-8 space-y-5">

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- Server Name -->
                <div class="form-control md:col-span-2">
                    <label class="label py-1"><span class="label-text font-medium">Server Name</span></label>
                    <label class="input input-bordered flex items-center gap-2">
                        <i class="fas fa-tag text-base-content/30 text-sm"></i>
                        <input name="name" required class="grow" placeholder="e.g. US East Prod">
                    </label>
                </div>

                <!-- Host -->
                <div class="form-control">
                    <label class="label py-1"><span class="label-text font-medium">Server Host / IP</span></label>
                    <label class="input input-bordered flex items-center gap-2">
                        <i class="fas fa-network-wired text-base-content/30 text-sm"></i>
                        <input name="host" required class="grow" placeholder="8.8.8.8">
                    </label>
                </div>

                <!-- SSH Port -->
                <div class="form-control">
                    <label class="label py-1"><span class="label-text font-medium">SSH Port</span></label>
                    <label class="input input-bordered flex items-center gap-2">
                        <i class="fas fa-plug text-base-content/30 text-sm"></i>
                        <input name="port" type="number" required class="grow" value="22">
                    </label>
                </div>

                <!-- VPN Port -->
                <div class="form-control">
                    <label class="label py-1"><span class="label-text font-medium">VPN Port (UDP)</span></label>
                    <label class="input input-bordered flex items-center gap-2">
                        <i class="fas fa-door-open text-base-content/30 text-sm"></i>
                        <input name="vpn_port" type="number" required class="grow" value="{{ random_port }}">
                    </label>
                </div>

                <!-- SSH Username -->
                <div class="form-control">
                    <label class="label py-1"><span class="label-text font-medium">SSH Username</span></label>
                    <label class="input input-bordered flex items-center gap-2">
                        <i class="fas fa-user-shield text-base-content/30 text-sm"></i>
                        <input name="username" value="root" class="grow font-mono">
                    </label>
                </div>

                <!-- SSH Password -->
                <div class="form-control md:col-span-2">
                    <label class="label py-1"><span class="label-text font-medium">SSH Password</span></label>
                    <label class="input input-bordered flex items-center gap-2">
                        <i class="fas fa-key text-base-content/30 text-sm"></i>
                        <input name="password" type="password" required class="grow font-mono">
                    </label>
                </div>
            </div>

            <!-- AmneziaWG Settings -->
            <div class="divider text-xs text-base-content/40 uppercase tracking-wider">
                <i class="fas fa-shield-alt mr-1 text-primary"></i>
                AmneziaWG 2.0 Settings
            </div>

            <div class="bg-base-300/50 rounded-xl border border-base-content/10 p-5">
                <div class="form-control">
                    <label class="label py-1"><span class="label-text font-medium">Protocol Mimicry (Obfuscation)</span></label>
                    <label class="input input-bordered flex items-center gap-2">
                        <i class="fas fa-mask text-base-content/30 text-sm"></i>
                        <select name="mimicry_type" class="grow bg-transparent outline-none cursor-pointer">
                            <option value="quic">QUIC (HTTP/3) - High performance, modern</option>
                            <option value="dns">DNS (UDP/53) - High stealth, universal</option>
                            <option value="stun">STUN (WebRTC) - Low latency video calls</option>
                            <option value="sip">SIP (VoIP) - Voice traffic mimicry</option>
                            <option value="none">None - Standard Obfuscation (V1)</option>
                        </select>
                    </label>
                    <label class="label py-1"><span class="label-text-alt text-base-content/40">Header ranges and padding will be auto-generated.</span></label>
                </div>
            </div>

            <!-- Import Toggle -->
            <div class="divider text-xs text-base-content/40 uppercase tracking-wider">Import</div>

            <div class="form-control">
                <label class="label cursor-pointer justify-start gap-3">
                    <input type="checkbox" id="enableImport" name="enable_import" class="toggle toggle-primary" onchange="toggleImportFields()">
                    <span class="label-text font-medium">Import from existing panel</span>
                </label>
            </div>

            <div id="importFields" class="hidden bg-base-300/50 rounded-xl border border-base-content/10 p-5 space-y-4">
                <div class="form-control">
                    <label class="label py-1"><span class="label-text font-medium">Panel Type</span></label>
                    <select name="panel_type" class="select select-bordered">
                        <option value="">-- Select --</option>
                        <option value="wg-easy">wg-easy</option>
                        <option value="3x-ui">3x-ui</option>
                    </select>
                </div>
                <div class="form-control">
                    <label class="label py-1"><span class="label-text font-medium">Backup File</span></label>
                    <input type="file" name="backup_file" accept=".json" class="file-input file-input-bordered w-full text-sm">
                    <label class="label py-1"><span class="label-text-alt text-base-content/40">wg-easy: db.json | 3x-ui: export.json</span></label>
                </div>
            </div>

            <div class="card-actions pt-2">
                <button type="submit" class="btn btn-primary w-full gap-2">
                    <i class="fas fa-save"></i>
                    Create Server
                </button>
            </div>
        </div>
    </form>
</div>

<script>
function toggleImportFields() {
    const checkbox = document.getElementById('enableImport');
    const fields = document.getElementById('importFields');
    fields.classList.toggle('hidden', !checkbox.checked);
}
</script>
{% endblock %}
