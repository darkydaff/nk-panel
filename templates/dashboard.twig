{% extends "layout.twig" %}

{% block title %}{{ t('dashboard.title') }} - {{ app_name }}{% endblock %}

{% block breadcrumbs %}
    <span class="text-slate-300">Dashboard</span>
{% endblock %}

{% block content %}
<div class="w-full space-y-6">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-white flex items-center">
                <div class="w-10 h-10 rounded-lg bg-slate-700 text-accent flex items-center justify-center mr-3">
                    <i class="fas fa-tachometer-alt"></i>
                </div>
                {{ t('dashboard.title') }}
            </h1>
            <p class="mt-2 text-slate-400 italic">{{ t('dashboard.welcome') }}</p>
        </div>
        <div>
            <a href="/servers/create" class="btn-primary px-5 py-2.5 text-sm inline-flex items-center">
                <i class="fas fa-plus mr-2"></i>
                {{ t('servers.add') }}
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="panel p-5">
            <div class="flex items-center justify-between mb-3">
                <span class="text-sm font-medium text-slate-400 uppercase tracking-wide text-xs">Total Servers</span>
                <i class="fas fa-server text-accent"></i>
            </div>
            <div class="text-3xl font-bold text-white">{{ servers|length }}</div>
        </div>
        
        <div class="panel p-5">
            <div class="flex items-center justify-between mb-3">
                <span class="text-sm font-medium text-slate-400 uppercase tracking-wide text-xs">Total Clients</span>
                <i class="fas fa-users text-cyan-400"></i>
            </div>
            <div class="text-3xl font-bold text-white">{{ clients|length }}</div>
        </div>

        <div class="panel p-5">
            <div class="flex items-center justify-between mb-3">
                <span class="text-sm font-medium text-slate-400 uppercase tracking-wide text-xs">Live Network Speed</span>
                <i class="fas fa-chart-line text-emerald-400"></i>
            </div>
            {% set total_speed_up = 0 %}
            {% set total_speed_down = 0 %}
            {% for server in servers %}
                {% set total_speed_up = total_speed_up + server.speed_up_kbps|default(0) %}
                {% set total_speed_down = total_speed_down + server.speed_down_kbps|default(0) %}
            {% endfor %}
            <div class="text-3xl font-bold text-white flex items-baseline gap-2" id="globalLiveSpeed">
                <span class="text-emerald-400 text-lg font-semibold upload-speed-value">
                    ↑{% if total_speed_up >= 1000 %}{{ (total_speed_up / 1000)|number_format(1) }} <span class="text-[10px] font-normal text-slate-500">Mbps</span>{% else %}{{ total_speed_up|number_format(0) }} <span class="text-[10px] font-normal text-slate-500">Kbps</span>{% endif %}
                </span>
                <span class="text-slate-600 text-sm">/</span>
                <span class="text-indigo-400 text-lg font-semibold download-speed-value">
                    ↓{% if total_speed_down >= 1000 %}{{ (total_speed_down / 1000)|number_format(1) }} <span class="text-[10px] font-normal text-slate-500">Mbps</span>{% else %}{{ total_speed_down|number_format(0) }} <span class="text-[10px] font-normal text-slate-500">Kbps</span>{% endif %}
                </span>
            </div>
        </div>
    </div>

    <!-- Client Locations Map Panel -->
    <div class="panel overflow-hidden relative">
        <div class="px-5 py-4 border-b border-slate-700 flex items-center justify-between">
            <h2 class="text-lg font-semibold text-white flex items-center">
                <i class="fas fa-globe-americas text-accent mr-2"></i>
                Client Locations Map
            </h2>
            <span class="text-xs text-slate-500 font-mono" id="mapStatus">Loading clients...</span>
        </div>
        <div class="relative w-full h-[400px]">
            <!-- Leaflet Map Container -->
            <div id="clientsMap" class="w-full h-full bg-slate-950/20"></div>
            
            <!-- Dynamic Client Info Overlay Panel (Initially Hidden) -->
            <div id="mapClientCard" class="absolute top-4 right-4 z-[1000] w-72 bg-slate-900/95 backdrop-blur-md border border-slate-700/80 rounded-xl p-4 shadow-2xl hidden transition-all duration-300 transform translate-y-2 opacity-0 flex flex-col max-h-[350px]">
                
                <!-- View 1: List of Clients in Location -->
                <div id="cardListView" class="flex flex-col h-full overflow-hidden">
                    <div class="flex items-start justify-between mb-3 shrink-0">
                        <div class="min-w-0">
                            <h4 id="cardLocationTitle" class="text-sm font-semibold text-white truncate pr-2">City, Country</h4>
                            <span id="cardClientCount" class="text-[10px] text-slate-500 font-medium">0 clients</span>
                        </div>
                        <button onclick="closeMapCard()" class="text-slate-500 hover:text-white transition-colors focus:outline-none">
                            <i class="fas fa-times text-xs"></i>
                        </button>
                    </div>
                    <div id="cardClientList" class="space-y-2 overflow-y-auto pr-1 flex-grow scrollbar-thin">
                        <!-- Dynamic list items will be injected here -->
                    </div>
                </div>

                <!-- View 2: Single Client Detail View -->
                <div id="cardDetailView" class="hidden flex flex-col h-full overflow-hidden">
                    <div class="flex items-start justify-between mb-3 shrink-0">
                        <div class="flex flex-col min-w-0">
                            <button id="cardBackButton" class="text-[10px] text-accent hover:text-blue-300 font-medium mb-1.5 flex items-center gap-1 focus:outline-none w-max">
                                <i class="fas fa-chevron-left text-[8px]"></i> Back to List
                            </button>
                            <h4 id="cardClientName" class="text-sm font-semibold text-white truncate max-w-[200px]">Client Name</h4>
                            <span id="cardClientStatus" class="inline-flex items-center text-[10px] px-2 py-0.5 rounded-full font-medium mt-1 w-max">Status</span>
                        </div>
                        <button onclick="closeMapCard()" class="text-slate-500 hover:text-white transition-colors focus:outline-none">
                            <i class="fas fa-times text-xs"></i>
                        </button>
                    </div>
                    
                    <div class="space-y-2 text-xs overflow-y-auto pr-1 flex-grow scrollbar-thin">
                        <div class="flex justify-between items-center border-b border-slate-800 pb-1.5">
                            <span class="text-slate-500">IP Address</span>
                            <code id="cardClientIp" class="text-[10px] bg-slate-950/50 px-1.5 py-0.5 rounded text-slate-300 font-mono">10.0.0.2</code>
                        </div>
                        <div class="flex justify-between items-center border-b border-slate-800 pb-1.5">
                            <span class="text-slate-500">Location</span>
                            <span id="cardClientLoc" class="text-slate-300 font-medium">City, Country</span>
                        </div>
                        <div class="flex justify-between items-center border-b border-slate-800 pb-1.5">
                            <span class="text-slate-500">ISP</span>
                            <span id="cardClientIsp" class="text-slate-300 font-medium truncate max-w-[150px] text-right">ISP Name</span>
                        </div>
                        <div class="flex justify-between items-center border-b border-slate-800 pb-1.5">
                            <span class="text-slate-500">Total Traffic</span>
                            <span id="cardClientTraffic" class="text-slate-300 font-mono">0 MB</span>
                        </div>
                        <div class="flex justify-between items-center pb-1">
                            <span class="text-slate-500">Last Active</span>
                            <span id="cardClientLastSeen" class="text-slate-300">Never</span>
                        </div>
                    </div>
                    
                    <div class="mt-3 pt-2.5 border-t border-slate-800 shrink-0">
                        <a id="cardClientLink" href="#" class="btn-secondary w-full py-2 text-center text-xs block">
                            View Client Details <i class="fas fa-arrow-right ml-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="panel overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-700 flex items-center justify-between">
            <h2 class="text-lg font-semibold text-white">Recent Servers</h2>
            <a href="/servers" class="text-sm text-accent hover:text-blue-300 transition-colors">View All</a>
        </div>
        
        {% if servers|length > 0 %}
        <div class="table-wrapper">
            <table class="min-w-full">
                <thead>
                    <tr class="bg-slate-800/50">
                        <th class="px-5 py-3 text-left text-[10px] uppercase tracking-widest text-slate-500 font-semibold">Name</th>
                        <th class="px-5 py-3 text-left text-[10px] uppercase tracking-widest text-slate-500 font-semibold">Host</th>
                        <th class="px-5 py-3 text-left text-[10px] uppercase tracking-widest text-slate-500 font-semibold">Live Speed</th>
                        <th class="px-5 py-3 text-right text-[10px] uppercase tracking-widest text-slate-500 font-semibold">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-700">
                    {% for server in servers|slice(0, 5) %}
                    <tr class="hover:bg-slate-800/30 transition-colors server-row" data-server-id="{{ server.id }}">
                        <td class="px-5 py-4">
                            <div class="flex items-center">
                                <div class="w-8 h-8 rounded-lg bg-slate-700 text-accent flex items-center justify-center mr-3">
                                    <i class="fas fa-server text-xs"></i>
                                </div>
                                <span class="text-sm font-medium text-white">{{ server.name }}</span>
                            </div>
                        </td>
                        <td class="px-5 py-4">
                            <code class="text-xs text-slate-400 bg-slate-800 px-2 py-1 rounded">{{ server.host }}</code>
                        </td>
                        <td class="px-5 py-4 font-mono text-xs speed-cell">
                            {% if server.speed_up_kbps > 0 or server.speed_down_kbps > 0 %}
                                <span class="text-emerald-400 font-semibold">↑{% if server.speed_up_kbps >= 1000 %}{{ (server.speed_up_kbps / 1000)|number_format(1) }} Mbps{% else %}{{ server.speed_up_kbps|number_format(0) }} Kbps{% endif %}</span>
                                <span class="text-slate-600 mx-1">|</span>
                                <span class="text-indigo-400 font-semibold">↓{% if server.speed_down_kbps >= 1000 %}{{ (server.speed_down_kbps / 1000)|number_format(1) }} Mbps{% else %}{{ server.speed_down_kbps|number_format(0) }} Kbps{% endif %}</span>
                            {% else %}
                                <span class="text-slate-500">Idle</span>
                            {% endif %}
                        </td>
                        <td class="px-5 py-4 text-right">
                            <a href="/servers/{{ server.id }}" class="btn-secondary px-3 py-1.5 text-xs inline-flex items-center">
                                View
                                <i class="fas fa-arrow-right ml-2 text-[10px]"></i>
                            </a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="p-10 text-center">
            <i class="fas fa-server text-slate-600 text-3xl mb-3"></i>
            <p class="text-slate-400 mb-4">{{ t('dashboard.no_servers') }}</p>
            <a href="/servers/create" class="btn-primary px-5 py-2.5 text-sm inline-block">Add Your First Server</a>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block styles %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<style>
    /* Customize Leaflet map appearance */
    .leaflet-container {
        background: #0f172a !important;
        font-family: inherit;
    }
    /* Style Leaflet controls to match dark theme */
    .leaflet-bar {
        border: 1px solid var(--border) !important;
        box-shadow: none !important;
        border-radius: 8px !important;
        overflow: hidden;
    }
    .leaflet-bar a {
        background-color: var(--bg-panel) !important;
        color: var(--text-primary) !important;
        border-bottom: 1px solid var(--border) !important;
        transition: background-color 0.2s;
    }
    .leaflet-bar a:hover {
        background-color: var(--border-light) !important;
        color: white !important;
    }
    .leaflet-bar a:last-child {
        border-bottom: none !important;
    }
    /* Style Attributions */
    .leaflet-control-attribution {
        background: rgba(15, 23, 42, 0.8) !important;
        color: var(--text-muted) !important;
        font-size: 9px !important;
    }
    .leaflet-control-attribution a {
        color: var(--accent) !important;
    }
    
    /* Glowing circle marker animations */
    @keyframes marker-pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(56, 189, 248, 0.5);
        }
        70% {
            box-shadow: 0 0 0 10px rgba(56, 189, 248, 0);
        }
        100% {
            box-shadow: 0 0 0 0 rgba(56, 189, 248, 0);
        }
    }
    
    .glowing-marker {
        animation: none;
    }
</style>
{% endblock %}

{% block scripts %}
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
// Global function to close overlay card
function closeMapCard() {
    const card = document.getElementById('mapClientCard');
    if (card) {
        card.classList.add('translate-y-2', 'opacity-0');
        setTimeout(() => {
            card.classList.add('hidden');
        }, 300);
    }
}

document.addEventListener('DOMContentLoaded', function() {
    // 1. Get raw client data from Twig
    const clients = {{ clients|json_encode|raw }};
    
    // Filter out clients without valid coordinates
    const mappedClients = clients.filter(c => c.latitude !== null && c.longitude !== null);
    
    // Update map status label
    const mapStatus = document.getElementById('mapStatus');
    if (mapStatus) {
        mapStatus.textContent = `${mappedClients.length} of ${clients.length} clients plotted`;
    }
    
    // 2. Initialize Map
    const map = L.map('clientsMap', { 
        zoomControl: false,
        attributionControl: true,
        minZoom: 1.5,
        maxZoom: 15
    }).setView([20, 0], 2); // Default zoom / center
    
    // CartoDB Dark Matter tiles
    L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
        subdomains: 'abcd',
        maxZoom: 20
    }).addTo(map);
    
    // Custom zoom control position
    L.control.zoom({ position: 'bottomright' }).addTo(map);
    
    // Group of markers to fit bounds
    const markerGroup = L.featureGroup().addTo(map);
    
    // Helper function to format bytes inside JS
    function formatBytes(bytes) {
        if (!bytes || bytes <= 0) return '0 MB';
        const units = ['B', 'KB', 'MB', 'GB', 'TB'];
        const i = Math.floor(Math.log(bytes) / Math.log(1024));
        const val = bytes / Math.pow(1024, i);
        return `${val.toFixed(i === 0 ? 0 : 2)} ${units[i]}`;
    }
    
    // Helper function to check activity status
    function getClientActivity(lastHandshake) {
        if (!lastHandshake) return { status: 'offline', text: 'Offline', colorClass: 'badge-error' };
        
        // Convert Y-m-d H:i:s UTC string to standard ISO 8601 UTC string (YYYY-MM-DDTHH:MM:SSZ)
        const utcString = lastHandshake.trim().replace(' ', 'T') + 'Z';
        const lastSeenDate = new Date(utcString);
        const now = new Date();
        const diffSeconds = Math.floor((now.getTime() - lastSeenDate.getTime()) / 1000);
        
        if (diffSeconds < 300) {
            return { status: 'online', text: 'Online', colorClass: 'badge-active' };
        } else if (diffSeconds < 86400) {
            const mins = Math.floor(diffSeconds / 60);
            if (mins < 60) return { status: 'idle', text: `${mins}m ago`, colorClass: 'badge-warning' };
            return { status: 'idle', text: `${Math.floor(mins / 60)}h ago`, colorClass: 'badge-warning' };
        } else {
            return { status: 'offline', text: `${Math.floor(diffSeconds / 86400)}d ago`, colorClass: 'badge-error' };
        }
    }
    
    // Helper function to format relative time
    function formatRelativeTime(lastHandshake) {
        if (!lastHandshake) return 'Never';
        const utcString = lastHandshake.trim().replace(' ', 'T') + 'Z';
        const lastSeenDate = new Date(utcString);
        const now = new Date();
        const diffSeconds = Math.floor((now.getTime() - lastSeenDate.getTime()) / 1000);
        
        if (diffSeconds < 60) return 'Active now';
        if (diffSeconds < 3600) return Math.floor(diffSeconds / 60) + 'm ago';
        if (diffSeconds < 86400) return Math.floor(diffSeconds / 3600) + 'h ago';
        return Math.floor(diffSeconds / 86400) + 'd ago';
    }

    // 3. Group clients by location rounded to 2 decimal places (approx 1.1km)
    const locationGroups = {};
    mappedClients.forEach(client => {
        const lat = parseFloat(client.latitude);
        const lon = parseFloat(client.longitude);
        const key = `${lat.toFixed(2)},${lon.toFixed(2)}`;
        
        if (!locationGroups[key]) {
            locationGroups[key] = {
                lat: lat,
                lon: lon,
                city: client.city || 'Unknown',
                country: client.country || 'Unknown',
                clients: []
            };
        }
        locationGroups[key].clients.push(client);
    });
    
    // Update map status label
    const mapStatus = document.getElementById('mapStatus');
    if (mapStatus) {
        const citiesCount = Object.keys(locationGroups).length;
        mapStatus.textContent = `${mappedClients.length} clients in ${citiesCount} locations plotted`;
    }
    
    // 4. Draw markers for each group
    Object.values(locationGroups).forEach(group => {
        // Determine status of group:
        // - 'online' if any client in group is online
        // - 'idle' if no client is online but at least one is idle
        // - 'offline' if all are offline
        let groupStatus = 'offline';
        let groupColor = '#f87171'; // Red for offline
        
        group.clients.forEach(c => {
            const act = getClientActivity(c.last_handshake);
            if (act.status === 'online') {
                groupStatus = 'online';
            } else if (act.status === 'idle' && groupStatus !== 'online') {
                groupStatus = 'idle';
            }
        });
        
        if (groupStatus === 'online') {
            groupColor = '#38bdf8'; // Glowing cyan for active
        } else if (groupStatus === 'idle') {
            groupColor = '#fbbf24'; // Amber for idle
        }
        
        // Size based on client count
        // 1 client = radius 6. Each extra client adds 2.5 radius, up to max 16.
        const radius = 6 + Math.min(10, (group.clients.length - 1) * 2.5);
        
        if (groupStatus === 'online') {
            // Glowing halo
            L.circleMarker([group.lat, group.lon], {
                radius: radius + 6,
                fillColor: groupColor,
                color: groupColor,
                weight: 0,
                fillOpacity: 0.18,
                interactive: false
            }).addTo(markerGroup);
        }
        
        const marker = L.circleMarker([group.lat, group.lon], {
            radius: radius,
            fillColor: groupColor,
            color: groupColor,
            weight: 2,
            opacity: 0.9,
            fillOpacity: 0.8
        });
        
        // Helper to show client details view inside overlay card
        function showClientDetails(client, activity) {
            document.getElementById('cardClientName').textContent = client.name;
            
            const statusBadge = document.getElementById('cardClientStatus');
            statusBadge.className = `inline-flex items-center text-[10px] px-2 py-0.5 rounded-full font-medium mt-1 ${activity.colorClass}`;
            statusBadge.textContent = activity.text;
            
            document.getElementById('cardClientIp').textContent = client.client_ip;
            document.getElementById('cardClientLoc').textContent = `${client.city || 'Unknown'}, ${client.country || 'Unknown'}`;
            document.getElementById('cardClientIsp').textContent = client.isp || 'N/A';
            
            const totalBytes = (parseInt(client.bytes_sent) || 0) + (parseInt(client.bytes_received) || 0);
            document.getElementById('cardClientTraffic').textContent = formatBytes(totalBytes);
            document.getElementById('cardClientLastSeen').textContent = formatRelativeTime(client.last_handshake);
            
            document.getElementById('cardClientLink').href = `/clients/${client.id}`;
            
            // Hide list view, show detail view
            document.getElementById('cardListView').classList.add('hidden');
            document.getElementById('cardDetailView').classList.remove('hidden');
        }
        
        // Click event on marker
        marker.on('click', function(e) {
            // Zoom smoothly to marker
            map.setView([group.lat, group.lon], Math.max(map.getZoom(), 5), { animate: true });
            
            // Set up back button action
            document.getElementById('cardBackButton').onclick = function() {
                document.getElementById('cardDetailView').classList.add('hidden');
                document.getElementById('cardListView').classList.remove('hidden');
            };
            
            // If there's only 1 client, show details directly
            if (group.clients.length === 1) {
                const client = group.clients[0];
                const activity = getClientActivity(client.last_handshake);
                showClientDetails(client, activity);
                document.getElementById('cardBackButton').classList.add('hidden');
            } else {
                // Show list of clients in city
                document.getElementById('cardLocationTitle').textContent = `${group.city}, ${group.country}`;
                document.getElementById('cardClientCount').textContent = `${group.clients.length} clients`;
                
                const listContainer = document.getElementById('cardClientList');
                listContainer.innerHTML = '';
                
                group.clients.forEach(client => {
                    const activity = getClientActivity(client.last_handshake);
                    
                    const item = document.createElement('div');
                    item.className = 'flex items-center justify-between p-2 rounded-lg bg-slate-800/40 border border-slate-700/30 hover:bg-slate-800/80 transition-colors';
                    
                    let statusColor = 'bg-red-500';
                    if (activity.status === 'online') statusColor = 'bg-sky-400 shadow-[0_0_8px_rgba(56,189,248,0.6)]';
                    else if (activity.status === 'idle') statusColor = 'bg-amber-400';
                    
                    item.innerHTML = `
                        <div class="flex items-center gap-2 min-w-0">
                            <span class="w-1.5 h-1.5 rounded-full ${statusColor} shrink-0"></span>
                            <div class="flex flex-col min-w-0">
                                <span class="text-xs font-semibold text-slate-200 truncate max-w-[130px]">${client.name}</span>
                                <span class="text-[9px] text-slate-500 font-mono">${client.client_ip}</span>
                            </div>
                        </div>
                        <button class="btn-secondary px-2 py-0.5 text-[10px] inline-flex items-center hover:bg-slate-700 transition-colors focus:outline-none shrink-0">
                            Details
                        </button>
                    `;
                    
                    item.querySelector('button').addEventListener('click', function() {
                        showClientDetails(client, activity);
                        document.getElementById('cardBackButton').classList.remove('hidden');
                    });
                    
                    listContainer.appendChild(item);
                });
                
                document.getElementById('cardListView').classList.remove('hidden');
                document.getElementById('cardDetailView').classList.add('hidden');
            }
            
            // Show overlay card with transitions
            const card = document.getElementById('mapClientCard');
            card.classList.remove('hidden');
            setTimeout(() => {
                card.classList.remove('translate-y-2', 'opacity-0');
            }, 10);
        });
        
        marker.addTo(markerGroup);
    });
    
    // Zoom map to bounds if we have plotted clients
    if (mappedClients.length > 0) {
        map.fitBounds(markerGroup.getBounds(), { padding: [40, 40], maxZoom: 6 });
    }
});
</script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    function formatSpeed(kbps, arrow, colorClass, labelClass) {
        if (kbps >= 1000) {
            return `<span class="${colorClass} ${labelClass || ''}">${arrow}${(kbps / 1000).toFixed(1)} <span class="text-[10px] font-normal text-slate-500">Mbps</span></span>`;
        }
        return `<span class="${colorClass}">${arrow}${Math.round(kbps)} <span class="text-[10px] font-normal text-slate-500">Kbps</span></span>`;
    }

    function formatTableCellSpeed(upKbps, downKbps) {
        if (upKbps <= 0 && downKbps <= 0) {
            return '<span class="text-slate-500">Idle</span>';
        }
        
        let html = '';
        if (upKbps > 0) {
            const speedUpStr = upKbps >= 1000 ? (upKbps / 1000).toFixed(1) + ' Mbps' : Math.round(upKbps) + ' Kbps';
            html += `<span class="text-emerald-400 font-semibold">↑${speedUpStr}</span>`;
        } else {
            html += '<span class="text-slate-500">↑0 Kbps</span>';
        }
        
        html += '<span class="text-slate-600 mx-1">|</span>';
        
        if (downKbps > 0) {
            const speedDownStr = downKbps >= 1000 ? (downKbps / 1000).toFixed(1) + ' Mbps' : Math.round(downKbps) + ' Kbps';
            html += `<span class="text-indigo-400 font-semibold">↓${speedDownStr}</span>`;
        } else {
            html += '<span class="text-slate-500">↓0 Kbps</span>';
        }
        
        return html;
    }

    async function pollServers() {
        try {
            const response = await fetch('/api/servers');
            if (!response.ok) return;
            const data = await response.json();
            if (!data.servers) return;

            let totalSpeedUp = 0;
            let totalSpeedDown = 0;

            data.servers.forEach(server => {
                const up = parseFloat(server.speed_up_kbps) || 0;
                const down = parseFloat(server.speed_down_kbps) || 0;
                totalSpeedUp += up;
                totalSpeedDown += down;

                // Update server row in recent table
                const row = document.querySelector(`.server-row[data-server-id="${server.id}"]`);
                if (row) {
                    const speedCell = row.querySelector('.speed-cell');
                    if (speedCell) {
                        speedCell.innerHTML = formatTableCellSpeed(up, down);
                    }
                }
            });

            // Update global network speed card
            const globalLiveSpeed = document.getElementById('globalLiveSpeed');
            if (globalLiveSpeed) {
                const upHtml = formatSpeed(totalSpeedUp, '↑', 'text-emerald-400', 'font-semibold');
                const downHtml = formatSpeed(totalSpeedDown, '↓', 'text-indigo-400', 'font-semibold');
                globalLiveSpeed.innerHTML = `${upHtml} <span class="text-slate-600 text-sm">/</span> ${downHtml}`;
            }

        } catch (error) {
            console.error('Failed to poll dashboard server metrics:', error);
        }
    }

    // Run polling every 8 seconds
    setInterval(pollServers, 8000);
});
</script>
{% endblock %}
