{% extends "layout.twig" %}

{% block title %}{{ t('dashboard.title') }} - {{ app_name }}{% endblock %}

{% block content %}
<div class="w-full space-y-6">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-white flex items-center">
                <div class="w-10 h-10 rounded-lg bg-slate-700 text-accent flex items-center justify-center mr-3">
                    <i class="fas fa-tachometer-alt"></i>
                </div>
                {{ t('dashboard.title') }}
            </h1>
            <p class="mt-2 text-slate-400 italic">{{ t('dashboard.welcome') }}</p>
        </div>
        <div>
            <a href="/servers/create" class="btn-primary px-5 py-2.5 text-sm inline-flex items-center">
                <i class="fas fa-plus mr-2"></i>
                {{ t('servers.add') }}
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="panel p-5">
            <div class="flex items-center justify-between mb-3">
                <span class="text-sm font-medium text-slate-400 uppercase tracking-wide text-xs">Total Servers</span>
                <i class="fas fa-server text-accent"></i>
            </div>
            <div class="text-3xl font-bold text-white">{{ servers|length }}</div>
        </div>
        
        <div class="panel p-5">
            <div class="flex items-center justify-between mb-3">
                <span class="text-sm font-medium text-slate-400 uppercase tracking-wide text-xs">Total Clients</span>
                <i class="fas fa-users text-cyan-400"></i>
            </div>
            <div class="text-3xl font-bold text-white">{{ clients|length }}</div>
        </div>

        <div class="panel p-5">
            <div class="flex items-center justify-between mb-3">
                <span class="text-sm font-medium text-slate-400 uppercase tracking-wide text-xs">Live Network Speed</span>
                <i class="fas fa-chart-line text-emerald-400"></i>
            </div>
            {% set total_speed_up = 0 %}
            {% set total_speed_down = 0 %}
            {% for server in servers %}
                {% set total_speed_up = total_speed_up + server.speed_up_kbps|default(0) %}
                {% set total_speed_down = total_speed_down + server.speed_down_kbps|default(0) %}
            {% endfor %}
            <div class="text-3xl font-bold text-white flex items-baseline gap-2" id="globalLiveSpeed">
                <span class="text-emerald-400 text-lg font-semibold upload-speed-value">
                    ↑{% if total_speed_up >= 1000 %}{{ (total_speed_up / 1000)|number_format(1) }} <span class="text-[10px] font-normal text-slate-500">Mbps</span>{% else %}{{ total_speed_up|number_format(0) }} <span class="text-[10px] font-normal text-slate-500">Kbps</span>{% endif %}
                </span>
                <span class="text-slate-600 text-sm">/</span>
                <span class="text-indigo-400 text-lg font-semibold download-speed-value">
                    ↓{% if total_speed_down >= 1000 %}{{ (total_speed_down / 1000)|number_format(1) }} <span class="text-[10px] font-normal text-slate-500">Mbps</span>{% else %}{{ total_speed_down|number_format(0) }} <span class="text-[10px] font-normal text-slate-500">Kbps</span>{% endif %}
                </span>
            </div>
        </div>
    </div>

    <div class="panel overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-700 flex items-center justify-between">
            <h2 class="text-lg font-semibold text-white">Recent Servers</h2>
            <a href="/servers" class="text-sm text-accent hover:text-blue-300 transition-colors">View All</a>
        </div>
        
        {% if servers|length > 0 %}
        <div class="table-wrapper">
            <table class="min-w-full">
                <thead>
                    <tr class="bg-slate-800/50">
                        <th class="px-5 py-3 text-left text-[10px] uppercase tracking-widest text-slate-500 font-semibold">Name</th>
                        <th class="px-5 py-3 text-left text-[10px] uppercase tracking-widest text-slate-500 font-semibold">Host</th>
                        <th class="px-5 py-3 text-left text-[10px] uppercase tracking-widest text-slate-500 font-semibold">Live Speed</th>
                        <th class="px-5 py-3 text-right text-[10px] uppercase tracking-widest text-slate-500 font-semibold">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-700">
                    {% for server in servers|slice(0, 5) %}
                    <tr class="hover:bg-slate-800/30 transition-colors server-row" data-server-id="{{ server.id }}">
                        <td class="px-5 py-4">
                            <div class="flex items-center">
                                <div class="w-8 h-8 rounded-lg bg-slate-700 text-accent flex items-center justify-center mr-3">
                                    <i class="fas fa-server text-xs"></i>
                                </div>
                                <span class="text-sm font-medium text-white">{{ server.name }}</span>
                            </div>
                        </td>
                        <td class="px-5 py-4">
                            <code class="text-xs text-slate-400 bg-slate-800 px-2 py-1 rounded">{{ server.host }}</code>
                        </td>
                        <td class="px-5 py-4 font-mono text-xs speed-cell">
                            {% if server.speed_up_kbps > 0 or server.speed_down_kbps > 0 %}
                                <span class="text-emerald-400 font-semibold">↑{% if server.speed_up_kbps >= 1000 %}{{ (server.speed_up_kbps / 1000)|number_format(1) }} Mbps{% else %}{{ server.speed_up_kbps|number_format(0) }} Kbps{% endif %}</span>
                                <span class="text-slate-600 mx-1">|</span>
                                <span class="text-indigo-400 font-semibold">↓{% if server.speed_down_kbps >= 1000 %}{{ (server.speed_down_kbps / 1000)|number_format(1) }} Mbps{% else %}{{ server.speed_down_kbps|number_format(0) }} Kbps{% endif %}</span>
                            {% else %}
                                <span class="text-slate-500">Idle</span>
                            {% endif %}
                        </td>
                        <td class="px-5 py-4 text-right">
                            <a href="/servers/{{ server.id }}" class="btn-secondary px-3 py-1.5 text-xs inline-flex items-center">
                                View
                                <i class="fas fa-arrow-right ml-2 text-[10px]"></i>
                            </a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="p-10 text-center">
            <i class="fas fa-server text-slate-600 text-3xl mb-3"></i>
            <p class="text-slate-400 mb-4">{{ t('dashboard.no_servers') }}</p>
            <a href="/servers/create" class="btn-primary px-5 py-2.5 text-sm inline-block">Add Your First Server</a>
        </div>
        {% endif %}
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    function formatSpeed(kbps, arrow, colorClass, labelClass) {
        if (kbps >= 1000) {
            return `<span class="${colorClass} ${labelClass || ''}">${arrow}${(kbps / 1000).toFixed(1)} <span class="text-[10px] font-normal text-slate-500">Mbps</span></span>`;
        }
        return `<span class="${colorClass}">${arrow}${Math.round(kbps)} <span class="text-[10px] font-normal text-slate-500">Kbps</span></span>`;
    }

    function formatTableCellSpeed(upKbps, downKbps) {
        if (upKbps <= 0 && downKbps <= 0) {
            return '<span class="text-slate-500">Idle</span>';
        }
        
        let html = '';
        if (upKbps > 0) {
            const speedUpStr = upKbps >= 1000 ? (upKbps / 1000).toFixed(1) + ' Mbps' : Math.round(upKbps) + ' Kbps';
            html += `<span class="text-emerald-400 font-semibold">↑${speedUpStr}</span>`;
        } else {
            html += '<span class="text-slate-500">↑0 Kbps</span>';
        }
        
        html += '<span class="text-slate-600 mx-1">|</span>';
        
        if (downKbps > 0) {
            const speedDownStr = downKbps >= 1000 ? (downKbps / 1000).toFixed(1) + ' Mbps' : Math.round(downKbps) + ' Kbps';
            html += `<span class="text-indigo-400 font-semibold">↓${speedDownStr}</span>`;
        } else {
            html += '<span class="text-slate-500">↓0 Kbps</span>';
        }
        
        return html;
    }

    async function pollServers() {
        try {
            const response = await fetch('/api/servers');
            if (!response.ok) return;
            const data = await response.json();
            if (!data.servers) return;

            let totalSpeedUp = 0;
            let totalSpeedDown = 0;

            data.servers.forEach(server => {
                const up = parseFloat(server.speed_up_kbps) || 0;
                const down = parseFloat(server.speed_down_kbps) || 0;
                totalSpeedUp += up;
                totalSpeedDown += down;

                // Update server row in recent table
                const row = document.querySelector(`.server-row[data-server-id="${server.id}"]`);
                if (row) {
                    const speedCell = row.querySelector('.speed-cell');
                    if (speedCell) {
                        speedCell.innerHTML = formatTableCellSpeed(up, down);
                    }
                }
            });

            // Update global network speed card
            const globalLiveSpeed = document.getElementById('globalLiveSpeed');
            if (globalLiveSpeed) {
                const upHtml = formatSpeed(totalSpeedUp, '↑', 'text-emerald-400', 'font-semibold');
                const downHtml = formatSpeed(totalSpeedDown, '↓', 'text-indigo-400', 'font-semibold');
                globalLiveSpeed.innerHTML = `${upHtml} <span class="text-slate-600 text-sm">/</span> ${downHtml}`;
            }

        } catch (error) {
            console.error('Failed to poll dashboard server metrics:', error);
        }
    }

    // Run polling every 8 seconds
    setInterval(pollServers, 8000);
});
</script>
{% endblock %}
