{% extends "layout.twig" %}

{% block title %}Register - {{ app_name }}{% endblock %}

{% block content %}
<div class="flex-grow flex items-center justify-center p-4 py-16">
    <div class="w-full max-w-sm">
        <div class="card bg-base-200 shadow-2xl border border-base-300">
            <div class="card-body p-8 md:p-10">
                <div class="text-center mb-8">
                    <div class="w-14 h-14 rounded-2xl bg-base-300 border border-base-content/10 text-primary flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-user-plus text-2xl"></i>
                    </div>
                    <h1 class="text-2xl font-bold tracking-tight">Create Account</h1>
                    <p class="mt-2 text-sm text-base-content/50">Setup your {{ app_name }} account</p>
                </div>

                {% if error %}
                <div class="alert alert-error mb-5">
                    <i class="fas fa-exclamation-circle"></i>
                    <span>{{ error }}</span>
                </div>
                {% endif %}

                <form class="space-y-4" method="POST" action="/register">
                    <div class="form-control">
                        <label class="label py-1" for="name">
                            <span class="label-text font-medium text-xs">Full Name</span>
                        </label>
                        <label class="input input-bordered input-sm flex items-center gap-2">
                            <i class="fas fa-id-card text-base-content/30 text-xs"></i>
                            <input id="name" name="name" type="text" required
                                   class="grow text-sm" placeholder="John Doe">
                        </label>
                    </div>

                    <div class="form-control">
                        <label class="label py-1" for="email">
                            <span class="label-text font-medium text-xs">Email Address</span>
                        </label>
                        <label class="input input-bordered input-sm flex items-center gap-2">
                            <i class="fas fa-envelope text-base-content/30 text-xs"></i>
                            <input id="email" name="email" type="email" required
                                   class="grow text-sm" placeholder="john@example.com">
                        </label>
                    </div>

                    <div class="form-control">
                        <label class="label py-1" for="password">
                            <span class="label-text font-medium text-xs">Password</span>
                        </label>
                        <label class="input input-bordered input-sm flex items-center gap-2">
                            <i class="fas fa-lock text-base-content/30 text-xs"></i>
                            <input id="password" name="password" type="password" required
                                   class="grow text-sm" placeholder="••••••••">
                        </label>
                        <label class="label py-1">
                            <span class="label-text-alt text-base-content/40">Minimum 6 characters</span>
                        </label>
                    </div>

                    <div class="pt-2">
                        <button type="submit" class="btn btn-primary btn-sm w-full gap-2">
                            <span>Register</span>
                            <i class="fas fa-user-plus opacity-70"></i>
                        </button>
                    </div>

                    <div class="text-center mt-2">
                        <a href="/login" class="link link-primary text-sm">
                            Already have an account? Sign in
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
