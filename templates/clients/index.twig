{% extends "layout.twig" %}
{% block title %}Clients{% endblock %}

{% block breadcrumbs %}
    <li><a href="/dashboard" class="hover:text-base-content transition-colors">Home</a></li>
    <li><span class="text-base-content/70">Clients</span></li>
{% endblock %}

{% block content %}
<div class="w-full">
    <!-- Page Header -->
    <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-base-300 text-primary flex items-center justify-center">
                    <i class="fas fa-users"></i>
                </div>
                Clients
            </h1>
            <p class="mt-1 text-sm text-base-content/50">
                Clients from external DB &mdash;
                <span class="font-mono text-base-content/70">{{ total_count }}</span> total
                {% if last_sync %}&middot; <span class="text-base-content/40 text-xs"><i class="fas fa-clock mr-1"></i>Last synced: {{ last_sync }}</span>{% endif %}
                {% if ext_db_error %}&middot; <span class="text-error text-xs"><i class="fas fa-exclamation-triangle mr-1"></i>External DB unavailable</span>{% endif %}
            </p>
        </div>

        <div class="flex flex-wrap sm:flex-nowrap gap-2 w-full sm:w-auto items-center">
            <form method="GET" action="/clients" class="flex gap-2 flex-1 sm:flex-initial" id="searchForm">
                <input type="hidden" name="filter" value="{{ filter }}">
                <input type="hidden" name="sort" value="{{ sort }}">
                <div class="relative flex-1 sm:w-64">
                    <label class="input input-bordered input-sm flex items-center gap-2">
                        <i class="fas fa-search text-base-content/30 text-xs" id="searchIcon"></i>
                        <input type="text" name="search" id="clientSearchInput" value="{{ search }}" placeholder="Search by code..." class="grow" autocomplete="off" oninput="onSearchInput(this.value)">
                    </label>
                    <div id="searchDropdown" class="hidden absolute z-50 mt-1 w-full bg-base-300 border border-base-content/10 rounded-xl shadow-xl overflow-hidden max-h-48 overflow-y-auto text-sm"></div>
                </div>
                <button type="submit" class="btn btn-primary btn-sm gap-2"><i class="fas fa-search"></i>Search</button>
                {% if search or code_filter %}<a href="/clients" class="btn btn-ghost btn-sm gap-2"><i class="fas fa-times"></i>Clear</a>{% endif %}
            </form>

            <button type="button" onclick="triggerClientSync()" id="syncClientBtn" class="btn btn-ghost btn-sm gap-2 whitespace-nowrap">
                <i class="fas fa-sync-alt" id="syncClientIcon"></i>Sync DB
            </button>
        </div>
    </div>

    {% if ext_db_error %}
    <div class="alert alert-error mb-6">
        <i class="fas fa-database"></i>
        <div>
            <p class="font-medium">Cannot reach external database</p>
            <p class="text-xs opacity-80 mt-0.5">{{ ext_db_error }}</p>
        </div>
    </div>
    {% endif %}

    <!-- Filter & Sort Controls -->
    <div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4 bg-base-200 p-4 border border-base-300 rounded-xl">
        <div class="flex flex-wrap gap-1.5">
            <a href="/clients?filter=all&sort={{ sort }}&search={{ search|url_encode }}" class="btn btn-sm {% if filter == 'all' or filter == '' %}btn-primary{% else %}btn-ghost{% endif %}">All</a>
            <a href="/clients?filter=active&sort={{ sort }}&search={{ search|url_encode }}" class="btn btn-sm {% if filter == 'active' %}btn-success{% else %}btn-ghost{% endif %} gap-1.5">
                <i class="fas fa-calendar-check text-xs"></i>Active
            </a>
            <a href="/clients?filter=expiring&sort={{ sort }}&search={{ search|url_encode }}" class="btn btn-sm {% if filter == 'expiring' %}btn-warning{% else %}btn-ghost{% endif %} gap-1.5">
                <i class="fas fa-calendar-minus text-xs"></i>Expiring Soon
            </a>
            <a href="/clients?filter=expired&sort={{ sort }}&search={{ search|url_encode }}" class="btn btn-sm {% if filter == 'expired' %}btn-error{% else %}btn-ghost{% endif %} gap-1.5">
                <i class="fas fa-calendar-times text-xs"></i>Expired
            </a>
            <a href="/clients?filter=paused&sort={{ sort }}&search={{ search|url_encode }}" class="btn btn-sm {% if filter == 'paused' %}btn-info{% else %}btn-ghost{% endif %} gap-1.5">
                <i class="fas fa-pause-circle text-xs"></i>Paused
            </a>
        </div>

        <div class="flex items-center gap-2">
            <span class="text-xs font-medium text-base-content/50 uppercase tracking-wider whitespace-nowrap">Sort by:</span>
            <select onchange="window.location.href='/clients?filter={{ filter }}&search={{ search|url_encode }}&sort=' + this.value"
                    class="select select-bordered select-sm min-w-[170px]">
                <option value="code" {% if sort == 'code' or sort == '' %}selected{% endif %}>Client Code (A-Z)</option>
                <option value="expiry_asc" {% if sort == 'expiry_asc' %}selected{% endif %}>Expiration (Soonest first)</option>
                <option value="expiry_desc" {% if sort == 'expiry_desc' %}selected{% endif %}>Expiration (Latest first)</option>
                <option value="traffic_desc" {% if sort == 'traffic_desc' %}selected{% endif %}>Traffic (Highest first)</option>
                <option value="traffic_asc" {% if sort == 'traffic_asc' %}selected{% endif %}>Traffic (Lowest first)</option>
            </select>
        </div>
    </div>

    <!-- Clients Grid -->
    {% if clients is empty %}
    <div class="card bg-base-200 border border-base-300">
        <div class="card-body items-center text-center py-16">
            <div class="w-16 h-16 rounded-full bg-base-300 flex items-center justify-center mb-4">
                <i class="fas fa-users text-base-content/20 text-2xl"></i>
            </div>
            <p class="text-base-content/50 font-medium">No clients found</p>
            {% if search %}<p class="text-base-content/30 text-sm mt-1">No results for "<span class="text-base-content/50">{{ search }}</span>"</p>{% endif %}
        </div>
    </div>
    {% else %}
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4 mb-6">
        {% for client in clients %}
        <div class="card bg-base-200 border border-base-300 shadow hover:border-primary/30 hover:-translate-y-0.5 transition-all duration-200 group">
            <div class="card-body p-5">
                <!-- Header row -->
                <div class="flex items-start justify-between mb-4">
                    <div class="flex items-center gap-3 min-w-0">
                        <div class="w-9 h-9 rounded-lg bg-primary/10 text-primary flex items-center justify-center shrink-0 group-hover:bg-primary/20 transition-colors">
                            <i class="fas fa-user text-sm"></i>
                        </div>
                        <div class="min-w-0">
                            <div class="flex items-baseline gap-1.5 flex-wrap">
                                <span class="font-semibold font-mono text-sm tracking-wide shrink-0">{{ client.Code }}</span>
                                <span class="text-xs text-base-content/60 font-medium truncate max-w-[130px]" title="{{ client.Name }}">{{ client.Name|default('No Name') }}</span>
                            </div>
                            <p class="text-[10px] text-base-content/40 mt-0.5 uppercase tracking-wider">Client Code &amp; Name</p>
                        </div>
                    </div>
                    <span class="badge badge-sm badge-ghost font-mono shrink-0">{{ client.config_count }} config{{ client.config_count != 1 ? 's' : '' }}</span>
                </div>

                <!-- Subscription status & Router badge -->
                <div class="mb-4 flex flex-wrap gap-2 items-center">
                    {% if client.Func == 'PAUSE' %}
                        <span class="badge badge-info gap-1.5 badge-sm"><i class="fas fa-pause-circle text-[10px]"></i>Paused</span>
                    {% elseif client.ExpiryDate %}
                        {% if client.DaysLeft > 10 %}
                            <span class="badge badge-success gap-1.5 badge-sm"><i class="fas fa-calendar-check text-[10px]"></i>Expires: {{ client.ExpiryDate }} ({{ client.DaysLeft }} days)</span>
                        {% elseif client.DaysLeft > 0 %}
                            <span class="badge badge-warning gap-1.5 badge-sm animate-pulse"><i class="fas fa-calendar-minus text-[10px]"></i>Expires soon: {{ client.ExpiryDate }} ({{ client.DaysLeft }} days)</span>
                        {% else %}
                            <span class="badge badge-error gap-1.5 badge-sm"><i class="fas fa-calendar-times text-[10px]"></i>{% if client.DaysLeft == 0 %}Expired today!{% else %}Expired: {{ client.ExpiryDate }} ({{ client.DaysLeft|abs }} days ago){% endif %}</span>
                        {% endif %}
                    {% else %}
                        <span class="badge badge-ghost badge-sm"><i class="fas fa-calendar-alt text-[10px] opacity-60"></i>No subscription data</span>
                    {% endif %}

                    {% if client.Router %}
                        <span class="badge badge-ghost badge-sm font-mono gap-1"><i class="fas fa-network-wired text-[8px] opacity-75"></i>{{ client.Router }}</span>
                    {% endif %}
                </div>

                <!-- Traffic -->
                <div class="mb-3 flex items-center justify-between text-xs bg-base-300/50 border border-base-content/5 px-3 py-2 rounded-lg font-mono">
                    <span class="text-base-content/40 text-[10px] uppercase font-sans font-semibold tracking-wider">Total Traffic</span>
                    <div class="flex items-center gap-2">
                        <span class="text-info">↑{{ client.BytesSent|default(0)|format_bytes }}</span>
                        <span class="text-base-content/20">|</span>
                        <span class="text-indigo-400">↓{{ client.BytesReceived|default(0)|format_bytes }}</span>
                    </div>
                </div>

                <!-- Last Active -->
                <div class="mb-4 flex items-center justify-between text-xs bg-base-300/50 border border-base-content/5 px-3 py-2 rounded-lg">
                    <span class="text-base-content/40 text-[10px] uppercase font-semibold tracking-wider">Last Active</span>
                    <span class="{{ client.LastActiveClass }} text-[10px] px-2 py-0.5 rounded font-semibold">{{ client.LastActiveText }}</span>
                </div>

                <!-- Config chips -->
                {% if client.configs is not empty %}
                <div class="flex flex-wrap gap-1.5 mb-4">
                    {% for cfg in client.configs|slice(0, 5) %}
                    <a href="/clients/{{ cfg.id }}" title="Last active: {{ cfg.last_active_text }}"
                       class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-base-300/80 hover:bg-base-300 text-xs hover:text-base-content border border-base-content/10 hover:border-base-content/20 transition-all">
                        <i class="fas fa-server text-[9px] text-base-content/30"></i>
                        <span class="font-mono truncate max-w-[100px]">{{ cfg.name }}</span>
                        {% if cfg.status != 'active' %}
                            <span class="w-1.5 h-1.5 rounded-full bg-base-content/20 shrink-0"></span>
                        {% elseif cfg.last_active_class == 'badge-active' %}
                            <span class="w-1.5 h-1.5 rounded-full bg-info shadow-[0_0_6px_rgba(56,189,248,0.6)] shrink-0"></span>
                        {% elseif cfg.last_active_class == 'badge-warning' %}
                            <span class="w-1.5 h-1.5 rounded-full bg-warning shrink-0"></span>
                        {% else %}
                            <span class="w-1.5 h-1.5 rounded-full bg-error shrink-0"></span>
                        {% endif %}
                    </a>
                    {% endfor %}
                    {% if client.config_count > 5 %}<span class="inline-flex items-center px-2.5 py-1 rounded-md bg-base-300/50 text-xs text-base-content/40 border border-base-content/5">+{{ client.config_count - 5 }} more</span>{% endif %}
                </div>
                {% else %}
                <p class="text-xs text-base-content/30 italic mb-4">No configs yet</p>
                {% endif %}

                <!-- Footer actions -->
                <div class="card-actions border-t border-base-300 pt-3">
                    <a href="/clients?code={{ client.Code|url_encode }}" class="btn btn-ghost btn-sm flex-1 gap-2"><i class="fas fa-eye"></i>All Configs</a>
                    <button onclick="openCreateForClient('{{ client.Code|e('js') }}')" class="btn btn-outline btn-primary btn-sm flex-1 gap-2"><i class="fas fa-plus"></i>New Config</button>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>

    <!-- Pagination -->
    {% if total_pages > 1 %}
    <div class="join flex justify-center flex-wrap gap-1 mt-8">
        {% if current_page > 1 %}
        <a href="/clients?search={{ search|url_encode }}&filter={{ filter }}&sort={{ sort }}&page={{ current_page - 1 }}" class="join-item btn btn-sm"><i class="fas fa-chevron-left"></i></a>
        {% endif %}

        {% set start_page = max(1, current_page - 2) %}
        {% set end_page = min(total_pages, current_page + 2) %}
        {% if end_page - start_page < 4 %}
            {% if start_page == 1 %}{% set end_page = min(total_pages, start_page + 4) %}{% else %}{% set start_page = max(1, end_page - 4) %}{% endif %}
        {% endif %}

        {% if start_page > 1 %}<a href="/clients?search={{ search|url_encode }}&filter={{ filter }}&sort={{ sort }}&page=1" class="join-item btn btn-sm font-mono">1</a>{% if start_page > 2 %}<span class="join-item btn btn-sm btn-disabled font-mono">...</span>{% endif %}{% endif %}

        {% for p in start_page..end_page %}
        <a href="/clients?search={{ search|url_encode }}&filter={{ filter }}&sort={{ sort }}&page={{ p }}" class="join-item btn btn-sm font-mono {% if p == current_page %}btn-active{% endif %}">{{ p }}</a>
        {% endfor %}

        {% if end_page < total_pages %}{% if end_page < total_pages - 1 %}<span class="join-item btn btn-sm btn-disabled font-mono">...</span>{% endif %}<a href="/clients?search={{ search|url_encode }}&filter={{ filter }}&sort={{ sort }}&page={{ total_pages }}" class="join-item btn btn-sm font-mono">{{ total_pages }}</a>{% endif %}

        {% if current_page < total_pages %}
        <a href="/clients?search={{ search|url_encode }}&filter={{ filter }}&sort={{ sort }}&page={{ current_page + 1 }}" class="join-item btn btn-sm"><i class="fas fa-chevron-right"></i></a>
        {% endif %}
    </div>
    {% endif %}
    {% endif %}

    <!-- Single-code filtered view -->
    {% if code_filter and code_configs is defined %}
    <div class="card bg-base-200 border border-base-300 shadow overflow-hidden mt-8">
        <div class="px-5 py-4 border-b border-base-300 flex items-center justify-between">
            <h2 class="font-semibold flex items-center gap-2">
                <i class="fas fa-list text-primary"></i>
                All configs for <code class="ml-1 font-mono text-primary">{{ code_filter }}</code>
            </h2>
            <a href="/clients" class="btn btn-ghost btn-xs gap-1"><i class="fas fa-times"></i>Clear filter</a>
        </div>
        {% if code_configs is empty %}
        <div class="p-10 text-center text-base-content/40 text-sm">No configs linked to this client yet.</div>
        {% else %}
        <div class="divide-y divide-base-300">
            {% for cfg in code_configs %}
            <div class="flex items-center gap-4 px-5 py-3 hover:bg-base-300/20 transition-colors">
                <div class="avatar avatar-placeholder">
                    <div class="bg-neutral text-neutral-content rounded-full w-7 text-xs"><span>{{ cfg.name|slice(0,1)|upper }}</span></div>
                </div>
                <div class="flex-1 min-w-0">
                    <span class="font-mono text-sm">{{ cfg.name }}</span>
                    <span class="ml-3 text-xs text-base-content/40">{{ cfg.server_name }}</span>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                    {% if cfg.status == 'active' %}
                        <span class="{{ cfg.last_active_class }} badge badge-sm">{{ cfg.last_active_text }}</span>
                    {% else %}
                        <span class="badge badge-ghost badge-sm">{{ cfg.status|capitalize }}</span>
                    {% endif %}
                    {% if cfg.router_id %}
                    <button onclick="event.preventDefault(); triggerRouterPush({{ cfg.router_id }}, {{ cfg.id }})" class="btn btn-ghost btn-xs gap-1 text-primary" title="Push config to router">
                        <i class="fas fa-upload"></i>Push
                    </button>
                    {% endif %}
                    <a href="/clients/{{ cfg.id }}" class="btn btn-ghost btn-xs gap-1"><i class="fas fa-eye"></i>View</a>
                </div>
            </div>
            {% endfor %}
        </div>
        {% endif %}
    </div>
    {% endif %}
</div>

<!-- Create Config for Client Modal -->
<dialog id="createForClientModal" class="modal">
    <div class="modal-box border border-base-300">
        <div class="flex items-center justify-between mb-5">
            <h3 class="font-semibold flex items-center gap-2"><i class="fas fa-user-plus text-primary"></i>New Config for Client</h3>
            <button onclick="closeCreateForClientModal()" class="btn btn-ghost btn-xs btn-circle"><i class="fas fa-times"></i></button>
        </div>

        <p class="text-sm text-base-content/50 mb-4">
            Creating a VPN config linked to client <code id="modalClientCodeDisplay" class="text-primary font-mono"></code>.
        </p>

        <form method="POST" id="createForClientForm" action="" onsubmit="submitCreateForClient(event)" class="space-y-4">
            <input type="hidden" name="ext_client_code" id="modalExtClientCode">
            <div class="form-control">
                <label class="label py-1"><span class="label-text text-xs font-medium uppercase tracking-wide text-base-content/50">Server</span></label>
                <select name="_server_id" id="modalServerId" class="select select-bordered" required>
                    <option value="">— pick a server —</option>
                    {% for srv in all_servers %}
                    <option value="{{ srv.id }}">{{ srv.name }} ({{ srv.host }})</option>
                    {% endfor %}
                </select>
            </div>
            <div class="form-control">
                <label class="label py-1"><span class="label-text text-xs font-medium uppercase tracking-wide text-base-content/50">Config Name</span></label>
                <input type="text" name="name" id="modalConfigName" required class="input input-bordered" placeholder="e.g. ABC_phone">
                <label class="label py-0.5"><span class="label-text-alt text-base-content/30">Defaults to the client code if left as-is.</span></label>
            </div>

            <div class="modal-action pt-2">
                <button type="button" onclick="closeCreateForClientModal()" class="btn btn-ghost btn-sm">Cancel</button>
                <button type="submit" class="btn btn-primary btn-sm gap-2" id="modalSubmitBtn"><i class="fas fa-plus"></i>Create Config</button>
            </div>
        </form>
    </div>
    <form method="dialog" class="modal-backdrop"><button onclick="closeCreateForClientModal()">close</button></form>
</dialog>

<script>
function openCreateForClient(code) {
    document.getElementById('modalClientCodeDisplay').textContent = code;
    document.getElementById('modalExtClientCode').value = code;
    document.getElementById('modalConfigName').value = code;
    document.getElementById('createForClientModal').showModal();
}

function closeCreateForClientModal() {
    document.getElementById('createForClientModal').close();
}

function submitCreateForClient(e) {
    e.preventDefault();
    const serverId = document.getElementById('modalServerId').value;
    if (!serverId) { alert('Please pick a server.'); return; }
    const form = document.getElementById('createForClientForm');
    form.action = '/servers/' + serverId + '/clients/create';
    form.submit();
}

// ── Search autocomplete ──────────────────────────────────────────────────────
let searchTimer = null;

function onSearchInput(value) {
    clearTimeout(searchTimer);
    if (value.length < 1) { hideSearchDropdown(); return; }
    searchTimer = setTimeout(() => fetchSearchCodes(value), 220);
}

function fetchSearchCodes(q) {
    const icon = document.getElementById('searchIcon');
    const originalClass = icon.className;
    icon.className = 'fas fa-spinner fa-spin text-base-content/30 text-xs';
    fetch('/api/ext-clients/search?q=' + encodeURIComponent(q))
        .then(r => r.json())
        .then(data => { icon.className = originalClass; renderSearchDropdown(data.codes || []); })
        .catch(() => { icon.className = originalClass; hideSearchDropdown(); });
}

function renderSearchDropdown(codes) {
    const dd = document.getElementById('searchDropdown');
    dd.innerHTML = '';
    if (!codes.length) { dd.innerHTML = '<div class="px-4 py-3 text-base-content/40 text-xs">No matches</div>'; dd.classList.remove('hidden'); return; }
    codes.forEach(code => {
        const item = document.createElement('button');
        item.type = 'button';
        item.className = 'w-full text-left px-4 py-2.5 hover:bg-base-200 transition-colors font-mono text-xs flex items-center gap-2';
        item.innerHTML = '<i class="fas fa-user text-base-content/30"></i>' + escapeHtml(code);
        item.addEventListener('mousedown', () => selectSearchCode(code));
        dd.appendChild(item);
    });
    dd.classList.remove('hidden');
}

function selectSearchCode(code) {
    document.getElementById('clientSearchInput').value = code;
    hideSearchDropdown();
    document.getElementById('searchForm').submit();
}

function hideSearchDropdown() { const dd = document.getElementById('searchDropdown'); if (dd) dd.classList.add('hidden'); }

function escapeHtml(str) { return str.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

function triggerClientSync() {
    const btn = document.getElementById('syncClientBtn');
    const icon = document.getElementById('syncClientIcon');
    if (btn.disabled) return;
    btn.disabled = true; btn.classList.add('opacity-70', 'cursor-not-allowed'); icon.classList.add('fa-spin');
    fetch('/api/ext-clients/sync', { method: 'POST' })
        .then(r => r.json().then(data => ({ status: r.status, body: data })))
        .then(res => {
            if (res.status === 200 && res.body.success) { alert('Sync successful! Loaded ' + res.body.count + ' clients.'); window.location.reload(); }
            else { alert('Sync failed: ' + (res.body.error || 'Unknown error')); btn.disabled = false; btn.classList.remove('opacity-70', 'cursor-not-allowed'); icon.classList.remove('fa-spin'); }
        })
        .catch(err => { alert('Sync error: ' + err.message); btn.disabled = false; btn.classList.remove('opacity-70', 'cursor-not-allowed'); icon.classList.remove('fa-spin'); });
}

document.addEventListener('click', function(e) {
    const searchInput = document.getElementById('clientSearchInput');
    const dropdown = document.getElementById('searchDropdown');
    if (searchInput && dropdown && !searchInput.closest('label').contains(e.target) && !dropdown.contains(e.target)) hideSearchDropdown();
});

function triggerRouterPush(routerId, vpnClientId) {
    if (!confirm('Are you sure you want to push the configuration to this router?')) return;
    const btn = event.currentTarget;
    const icon = btn.querySelector('i');
    const oldClass = icon.className;
    icon.className = 'fas fa-spinner fa-spin text-primary';
    btn.disabled = true;
    let url = '/api/routers/' + routerId + '/push';
    if (vpnClientId) url += '?vpn_client_id=' + vpnClientId;
    fetch(url, { method: 'POST' })
        .then(r => r.json().then(data => ({ status: r.status, body: data })))
        .then(res => {
            if (res.status === 200 && res.body.success) { alert('Config pushed successfully!\nModel: ' + res.body.router_model + '\nInterface: ' + res.body.interface_id); window.location.reload(); }
            else { alert('Push failed: ' + (res.body.error || 'Unknown error')); icon.className = oldClass; btn.disabled = false; }
        })
        .catch(err => { alert('Error: ' + err.message); icon.className = oldClass; btn.disabled = false; });
}

function triggerRouterCheck(routerId) {
    const btn = event.currentTarget;
    const icon = btn.querySelector('i');
    const oldClass = icon.className;
    icon.className = 'fas fa-spinner fa-spin text-info';
    btn.disabled = true;
    fetch('/api/routers/' + routerId + '/check', { method: 'POST' })
        .then(r => r.json().then(data => ({ status: r.status, body: data })))
        .then(res => {
            if (res.status === 200 && res.body.success) { alert('Status check completed!\nStatus: ' + res.body.status + '\nModel: ' + res.body.router_model + (res.body.error ? '\nError: ' + res.body.error : '')); window.location.reload(); }
            else { alert('Check failed: ' + (res.body.error || 'Unknown error')); icon.className = oldClass; btn.disabled = false; }
        })
        .catch(err => { alert('Error: ' + err.message); icon.className = oldClass; btn.disabled = false; });
}
</script>
{% endblock %}
