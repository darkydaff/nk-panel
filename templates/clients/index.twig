<script>
let isClientEditingUnlocked = false;

function toggleClientEditLock() {
    isClientEditingUnlocked = !isClientEditingUnlocked;
    const btn = document.getElementById('btnClientEditLock');
    const icon = document.getElementById('clientEditLockIcon');
    const text = document.getElementById('clientEditLockText');
    const addBtn = document.getElementById('btnAddClientHeader');
    const editBtns = document.querySelectorAll('.client-edit-btn');

    if (isClientEditingUnlocked) {
        btn.className = 'btn btn-warning btn-sm gap-2 whitespace-nowrap shadow-md';
        icon.className = 'fas fa-lock-open text-warning-content';
        text.textContent = 'Editing Unlocked';
        if (addBtn) addBtn.classList.remove('hidden');
        editBtns.forEach(b => b.classList.remove('hidden'));
    } else {
        btn.className = 'btn btn-warning btn-outline btn-sm gap-2 whitespace-nowrap';
        icon.className = 'fas fa-lock';
        text.textContent = 'Unlock Editing';
        if (addBtn) addBtn.classList.add('hidden');
        editBtns.forEach(b => b.classList.add('hidden'));
    }
}

let activePaymentClientCode = '';

async function openClientPaymentsModal(code) {
    activePaymentClientCode = code;
    document.getElementById('paymentModalClientCode').textContent = code;
    const banner = document.getElementById('paymentModalClientBanner');
    const tbody = document.getElementById('paymentModalTableBody');

    banner.innerHTML = '<span>Loading client details...</span>';
    tbody.innerHTML = '<tr><td colspan="4" class="text-center py-6 text-base-content/40"><i class="fas fa-spinner fa-spin mr-2"></i>Loading payments...</td></tr>';

    document.getElementById('clientPaymentsModal').showModal();

    try {
        const res = await fetch('/api/clients/payments?code=' + encodeURIComponent(code));
        const data = await res.json();

        if (!data.success) {
            banner.innerHTML = `<span class="text-error">${escapeHtml(data.error || 'Failed to load client')}</span>`;
            tbody.innerHTML = '<tr><td colspan="4" class="text-center py-6 text-error">Failed to load payments</td></tr>';
            return;
        }

        const c = data.client || {};
        const payments = data.payments || [];

        const funcClass = (c.Func === 'WORK') ? 'badge-success' : 'badge-warning';
        banner.innerHTML = `
            <div>Name: <b>${escapeHtml(c.Name || '-')}</b></div>
            <div>Status: <span class="badge ${funcClass} badge-xs">${escapeHtml(c.Func || 'UNKNOWN')}</span></div>
            <div>Sub: <b>${c.Sub || 0} months</b></div>
            <div>Start: <b>${c.Start_Date || '-'}</b></div>
            <div>Total Payments: <b>${payments.length}</b></div>
        `;

        if (payments.length === 0) {
            tbody.innerHTML = '<tr><td colspan="4" class="text-center py-6 text-base-content/40">No linked payments in Finances 2026.</td></tr>';
            return;
        }

        tbody.innerHTML = payments.map(p => `
            <tr class="hover:bg-base-200">
                <td>${p.date}</td>
                <td><span class="badge badge-xs ${p.type === 'income' ? 'badge-success' : 'badge-error'}">${p.type}</span></td>
                <td class="font-bold ${p.type === 'income' ? 'text-emerald-400' : 'text-rose-400'}">${p.amount} ₽</td>
                <td class="max-w-xs truncate" title="${escapeHtml(p.description)}">${escapeHtml(p.description || '-')}</td>
            </tr>
        `).join('');

    } catch (err) {
        banner.innerHTML = `<span class="text-error">Network error</span>`;
        tbody.innerHTML = '<tr><td colspan="4" class="text-center py-6 text-error">Network error loading payments</td></tr>';
    }
}
window.openClientPaymentsModal = openClientPaymentsModal;

function openAddTxForClient() {
    if (!activePaymentClientCode) return;
    window.location.href = '/finances?client=' + encodeURIComponent(activePaymentClientCode);
}
window.openAddTxForClient = openAddTxForClient;
</script>

<!-- Client Payments Modal -->
