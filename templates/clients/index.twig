{% extends "layout.twig" %}
{% block title %}Clients{% endblock %}

{% block breadcrumbs %}
    <a href="/dashboard" class="hover:text-slate-300 transition-colors">Home</a>
    <i class="fas fa-chevron-right text-[10px] text-slate-700 mx-1"></i>
    <span class="text-slate-300">Clients</span>
{% endblock %}

{% block content %}
<div class="w-full mx-auto max-w-7xl">

    {# ─── Page Header ─── #}
    <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-white flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-indigo-500/15 text-indigo-400 flex items-center justify-center">
                    <i class="fas fa-users"></i>
                </div>
                Clients
            </h1>
            <p class="mt-1 text-sm text-slate-500">
                Clients from external DB &mdash;
                <span class="text-slate-400 font-mono">{{ total_count }}</span> total
                {% if last_sync %}
                    &middot; <span class="text-slate-400 text-xs" title="Last cache update"><i class="fas fa-clock mr-1"></i>Last synced: {{ last_sync }}</span>
                {% endif %}
                {% if ext_db_error %}
                    &middot; <span class="text-red-400 text-xs"><i class="fas fa-exclamation-triangle mr-1"></i>External DB unavailable</span>
                {% endif %}
            </p>
        </div>

        {# Search form #}
        <div class="flex flex-wrap sm:flex-nowrap gap-2 w-full sm:w-auto items-center">
            <form method="GET" action="/clients" class="flex gap-2 flex-1 sm:flex-initial" id="searchForm">
                <input type="hidden" name="filter" value="{{ filter }}">
                <input type="hidden" name="sort" value="{{ sort }}">
                <div class="relative flex-1 sm:w-64">
                    <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-500 text-xs pointer-events-none" id="searchIcon"></i>
                    <input
                        type="text"
                        name="search"
                        id="clientSearchInput"
                        value="{{ search }}"
                        placeholder="Search by code..."
                        class="input-field pl-9 pr-8 py-2.5 text-sm w-full rounded-lg"
                        autocomplete="off"
                        oninput="onSearchInput(this.value)"
                    >
                    <div id="searchDropdown"
                         class="hidden absolute z-50 mt-1 w-full bg-slate-900 border border-slate-700 rounded-lg shadow-xl overflow-hidden max-h-48 overflow-y-auto text-sm">
                    </div>
                </div>
                <button type="submit" class="btn-primary px-4 py-2.5 text-sm whitespace-nowrap">
                    <i class="fas fa-search mr-2"></i>Search
                </button>
                {% if search or code_filter %}
                <a href="/clients" class="btn-secondary px-4 py-2.5 text-sm whitespace-nowrap">
                    <i class="fas fa-times mr-1"></i>Clear
                </a>
                {% endif %}
            </form>

            <button type="button" onclick="triggerClientSync()" id="syncClientBtn"
                    class="btn-secondary px-4 py-2.5 text-sm whitespace-nowrap flex items-center gap-2 bg-slate-800/45 hover:bg-slate-800 border-slate-700/80 hover:border-slate-600 transition-all rounded-lg">
                <i class="fas fa-sync-alt" id="syncClientIcon"></i>Sync DB
            </button>
        </div>
    </div>

    {# ─── External DB error banner ─── #}
    {% if ext_db_error %}
    <div class="mb-6 bg-red-500/10 border border-red-500/30 rounded-xl px-5 py-4 flex items-start gap-3">
        <i class="fas fa-database text-red-400 mt-0.5"></i>
        <div>
            <p class="text-sm font-medium text-red-300">Cannot reach external database</p>
            <p class="text-xs text-red-400/80 mt-0.5">{{ ext_db_error }}</p>
        </div>
    </div>
    {% endif %}

    {# ─── Filtering & Sorting Controls ─── #}
    <div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4 bg-slate-900/30 p-4 border border-slate-800/80 rounded-xl backdrop-blur-sm">
        {# Status Filters #}
        <div class="flex flex-wrap gap-1.5">
            <a href="/clients?filter=all&sort={{ sort }}&search={{ search|url_encode }}"
               class="px-3.5 py-1.5 rounded-lg text-xs font-medium border transition-all {% if filter == 'all' or filter == '' %}bg-indigo-600 text-white border-indigo-500 font-semibold{% else %}bg-slate-800/40 border-slate-750 text-slate-400 hover:text-slate-200 hover:bg-slate-800{% endif %}">
                All
            </a>
            <a href="/clients?filter=active&sort={{ sort }}&search={{ search|url_encode }}"
               class="px-3.5 py-1.5 rounded-lg text-xs font-medium border transition-all {% if filter == 'active' %}bg-emerald-600 text-white border-emerald-500 font-semibold{% else %}bg-slate-800/40 border-slate-750 text-emerald-400 hover:text-emerald-300 hover:bg-slate-800{% endif %}">
                <i class="fas fa-calendar-check mr-1"></i>Active
            </a>
            <a href="/clients?filter=expiring&sort={{ sort }}&search={{ search|url_encode }}"
               class="px-3.5 py-1.5 rounded-lg text-xs font-medium border transition-all {% if filter == 'expiring' %}bg-amber-600 text-white border-amber-500 font-semibold{% else %}bg-slate-800/40 border-slate-750 text-amber-400 hover:text-amber-300 hover:bg-slate-800{% endif %}">
                <i class="fas fa-calendar-minus mr-1"></i>Expiring Soon
            </a>
            <a href="/clients?filter=expired&sort={{ sort }}&search={{ search|url_encode }}"
               class="px-3.5 py-1.5 rounded-lg text-xs font-medium border transition-all {% if filter == 'expired' %}bg-rose-600 text-white border-rose-500 font-semibold{% else %}bg-slate-800/40 border-slate-750 text-rose-400 hover:text-rose-300 hover:bg-slate-800{% endif %}">
                <i class="fas fa-calendar-times mr-1"></i>Expired
            </a>
            <a href="/clients?filter=paused&sort={{ sort }}&search={{ search|url_encode }}"
               class="px-3.5 py-1.5 rounded-lg text-xs font-medium border transition-all {% if filter == 'paused' %}bg-sky-600 text-white border-sky-500 font-semibold{% else %}bg-slate-800/40 border-slate-750 text-sky-400 hover:text-sky-300 hover:bg-slate-800{% endif %}">
                <i class="fas fa-pause-circle mr-1"></i>Paused
            </a>
        </div>

        {# Sort Selector #}
        <div class="flex items-center gap-2">
            <span class="text-xs font-medium text-slate-500 uppercase tracking-wider whitespace-nowrap">Sort by:</span>
            <select onchange="window.location.href='/clients?filter={{ filter }}&search={{ search|url_encode }}&sort=' + this.value"
                    class="bg-slate-900 border border-slate-750 rounded-lg text-xs text-slate-300 px-3 py-1.5 focus:outline-none focus:border-indigo-500 cursor-pointer min-w-[170px]">
                <option value="code" {% if sort == 'code' or sort == '' %}selected{% endif %}>Client Code (A-Z)</option>
                <option value="expiry_asc" {% if sort == 'expiry_asc' %}selected{% endif %}>Expiration (Soonest first)</option>
                <option value="expiry_desc" {% if sort == 'expiry_desc' %}selected{% endif %}>Expiration (Latest first)</option>
                <option value="traffic_desc" {% if sort == 'traffic_desc' %}selected{% endif %}>Traffic (Highest first)</option>
                <option value="traffic_asc" {% if sort == 'traffic_asc' %}selected{% endif %}>Traffic (Lowest first)</option>
            </select>
        </div>
    </div>

    {# ─── Clients Grid ─── #}
    {% if clients is empty %}
        <div class="panel p-16 text-center border-slate-800/60 bg-slate-900/40">
            <div class="w-16 h-16 rounded-full bg-slate-800 flex items-center justify-center mx-auto mb-4">
                <i class="fas fa-users text-2xl text-slate-600"></i>
            </div>
            <p class="text-slate-400 font-medium">No clients found</p>
            {% if search %}
            <p class="text-slate-500 text-sm mt-1">No results for "<span class="text-slate-400">{{ search }}</span>"</p>
            {% endif %}
        </div>
    {% else %}
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4 mb-6">
        {% for client in clients %}
        <div class="panel p-5 border-slate-800/60 bg-slate-900/60 backdrop-blur hover:border-indigo-500/30 hover:-translate-y-0.5 transition-all duration-200 group">
            {# Header row #}
            <div class="flex items-start justify-between mb-4">
                <div class="flex items-center gap-3 min-w-0">
                    <div class="w-9 h-9 rounded-lg bg-indigo-500/15 text-indigo-400 flex items-center justify-center shrink-0 group-hover:bg-indigo-500/25 transition-colors">
                        <i class="fas fa-user text-sm"></i>
                    </div>
                    <div class="min-w-0">
                        <div class="flex items-baseline gap-1.5 flex-wrap sm:flex-nowrap">
                            <span class="font-semibold text-white font-mono text-sm tracking-wide shrink-0">{{ client.Code }}</span>
                            <span class="text-xs text-slate-300 font-medium truncate max-w-[130px]" title="{{ client.Name }}">{{ client.Name|default('No Name') }}</span>
                        </div>
                        <p class="text-[10px] text-slate-500 mt-0.5 uppercase tracking-wider">Client Code & Name</p>
                    </div>
                </div>

                {# Configs count badge #}
                <span class="bg-slate-800 border border-slate-700 text-slate-300 px-2.5 py-1 rounded-lg text-xs font-mono shrink-0">
                    {{ client.config_count }} config{{ client.config_count != 1 ? 's' : '' }}
                </span>
            </div>

            {# Subscription status & Router model info #}
            <div class="mb-4 flex flex-wrap gap-2 items-center">
                {# Expiry/Status Badge #}
                {% if client.Func == 'PAUSE' %}
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-sky-500/10 text-sky-400 border border-sky-500/20 font-medium text-xs">
                        <i class="fas fa-pause-circle text-[10px]"></i>
                        <span>Paused</span>
                    </span>
                {% elseif client.ExpiryDate %}
                    {% if client.DaysLeft > 10 %}
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-medium text-xs">
                            <i class="fas fa-calendar-check text-[10px]"></i>
                            <span>Expires: {{ client.ExpiryDate }} ({{ client.DaysLeft }} days left)</span>
                        </span>
                    {% elseif client.DaysLeft > 0 %}
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-amber-500/10 text-amber-400 border border-amber-500/20 font-medium text-xs animate-pulse">
                            <i class="fas fa-calendar-minus text-[10px]"></i>
                            <span>Expires soon: {{ client.ExpiryDate }} ({{ client.DaysLeft }} days left)</span>
                        </span>
                    {% else %}
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-rose-500/10 text-rose-400 border border-rose-500/20 font-medium text-xs">
                            <i class="fas fa-calendar-times text-[10px]"></i>
                            <span>{% if client.DaysLeft == 0 %}Expired today!{% else %}Expired: {{ client.ExpiryDate }} ({{ client.DaysLeft|abs }} days ago){% endif %}</span>
                        </span>
                    {% endif %}
                {% else %}
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-slate-800 text-slate-500 border border-slate-750 font-medium text-xs">
                        <i class="fas fa-calendar-alt text-[10px] opacity-60"></i>
                        <span>No subscription data</span>
                    </span>
                {% endif %}

                {# Router model badge if exists #}
                {% if client.Router %}
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-slate-800/80 text-slate-400 border border-slate-700/50 text-[10px] font-mono" title="Router model">
                        <i class="fas fa-network-wired text-[8px] opacity-75"></i>
                        <span>{{ client.Router }}</span>
                    </span>
                {% endif %}
            </div>

            {# Aggregate Traffic #}
            <div class="mb-4 flex items-center justify-between text-xs text-slate-400 bg-slate-950/40 border border-slate-800/80 px-3 py-2 rounded-lg font-mono">
                <span class="text-slate-500 text-[10px] uppercase font-sans font-semibold tracking-wider">Total Traffic</span>
                <div class="flex items-center gap-2">
                    <span class="text-cyan-400" title="Uploaded">↑{{ client.BytesSent|default(0)|format_bytes }}</span>
                    <span class="text-slate-700">|</span>
                    <span class="text-indigo-400" title="Downloaded">↓{{ client.BytesReceived|default(0)|format_bytes }}</span>
                </div>
            </div>

            {# Last Active #}
            <div class="mb-4 flex items-center justify-between text-xs text-slate-400 bg-slate-950/40 border border-slate-800/80 px-3 py-2 rounded-lg font-mono">
                <span class="text-slate-500 text-[10px] uppercase font-sans font-semibold tracking-wider">Last Active</span>
                <span class="{{ client.LastActiveClass }} text-[10px] px-2 py-0.5 rounded font-sans font-semibold">{{ client.LastActiveText }}</span>
            </div>

            {# Router Status #}
            <div class="mb-4 flex items-center justify-between text-xs text-slate-400 bg-slate-950/40 border border-slate-800/80 px-3 py-2 rounded-lg font-mono">
                <span class="text-slate-500 text-[10px] uppercase font-sans font-semibold tracking-wider font-semibold">Router</span>
                {% if client.router_id %}
                    <div class="flex items-center gap-2">
                        <a href="http://{{ client.router_domain }}" target="_blank" class="text-indigo-400 hover:text-indigo-300 underline text-[10px] truncate max-w-[100px]" title="Open router panel: {{ client.router_domain }}">{{ client.router_domain }}</a>
                        <button onclick="event.preventDefault(); triggerRouterCheck({{ client.router_id }})" class="text-slate-500 hover:text-cyan-400 p-0.5 rounded hover:bg-slate-800 transition-colors" title="Check router status">
                            <i class="fas fa-sync-alt text-[9px]"></i>
                        </button>
                        {% if client.router_status == 'connected' %}
                            <span class="w-2 h-2 rounded-full bg-emerald-500 shadow-[0_0_6px_rgba(16,185,129,0.6)] shrink-0" title="Connected"></span>
                        {% elseif client.router_status == 'offline' %}
                            <span class="w-2 h-2 rounded-full bg-amber-500 shrink-0" title="Offline: {{ client.router_error }}"></span>
                        {% elseif client.router_status == 'error' %}
                            <span class="w-2 h-2 rounded-full bg-rose-500 shrink-0" title="Error: {{ client.router_error }}"></span>
                        {% else %}
                            <span class="w-2 h-2 rounded-full bg-slate-500 shrink-0" title="Pending Push"></span>
                        {% endif %}
                    </div>
                {% else %}
                    <span class="text-slate-600 text-[10px]">None</span>
                {% endif %}
            </div>

            {# Config chips #}
            {% if client.configs is not empty %}
            <div class="flex flex-wrap gap-1.5 mb-4">
                {% for cfg in client.configs|slice(0, 5) %}
                <a href="/clients/{{ cfg.id }}"
                   title="Last active: {{ cfg.last_active_text }}"
                   class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-slate-800/80 hover:bg-slate-700 text-xs text-slate-300 hover:text-white border border-slate-700/60 hover:border-slate-600 transition-all">
                    <i class="fas fa-server text-[9px] text-slate-500"></i>
                    <span class="font-mono truncate max-w-[100px]">{{ cfg.name }}</span>
                    {% if cfg.status != 'active' %}
                        <span class="w-1.5 h-1.5 rounded-full bg-slate-600 shrink-0" title="Disabled"></span>
                    {% elseif cfg.last_active_class == 'badge-active' %}
                        <span class="w-1.5 h-1.5 rounded-full bg-sky-400 shadow-[0_0_6px_rgba(56,189,248,0.6)] shrink-0"></span>
                    {% elseif cfg.last_active_class == 'badge-warning' %}
                        <span class="w-1.5 h-1.5 rounded-full bg-amber-400 shrink-0"></span>
                    {% else %}
                        <span class="w-1.5 h-1.5 rounded-full bg-red-500 shrink-0"></span>
                    {% endif %}
                </a>
                {% endfor %}
                {% if client.config_count > 5 %}
                <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-slate-800/50 text-xs text-slate-500 border border-slate-800">
                    +{{ client.config_count - 5 }} more
                </span>
                {% endif %}
            </div>
            {% else %}
            <p class="text-xs text-slate-600 italic mb-4">No configs yet</p>
            {% endif %}

            {# Footer actions #}
            <div class="flex gap-2 pt-3 border-t border-slate-800/60">
                <a href="/clients?code={{ client.Code|url_encode }}"
                   class="btn-secondary flex-1 text-center py-2 text-xs flex items-center justify-center gap-1.5">
                    <i class="fas fa-eye"></i>All Configs
                </a>
                <button
                    onclick="openCreateForClient('{{ client.Code|e('js') }}')"
                    class="flex-1 py-2 px-3 rounded-lg text-xs bg-indigo-500/10 hover:bg-indigo-500/20 text-indigo-400 hover:text-indigo-300 border border-indigo-500/30 hover:border-indigo-500/50 transition-all flex items-center justify-center gap-1.5">
                    <i class="fas fa-plus"></i>New Config
                </button>
            </div>
        </div>
        {% endfor %}
    </div>

    {# ─── Pagination ─── #}
    {% if total_pages > 1 %}
    <div class="flex items-center justify-center gap-1.5 mt-8 flex-wrap">
        {# Prev Button #}
        {% if current_page > 1 %}
        <a href="/clients?search={{ search|url_encode }}&filter={{ filter }}&sort={{ sort }}&page={{ current_page - 1 }}"
           class="px-3 py-1.5 rounded-lg bg-slate-800/60 hover:bg-slate-700 text-xs text-slate-300 hover:text-white border border-slate-700/60 transition-all mr-1">
            <i class="fas fa-chevron-left"></i>
        </a>
        {% endif %}

        {# Pages #}
        {% set start_page = max(1, current_page - 2) %}
        {% set end_page = min(total_pages, current_page + 2) %}

        {# Adjust if at the boundaries to keep a consistent size (e.g. 5 pages) #}
        {% if end_page - start_page < 4 %}
            {% if start_page == 1 %}
                {% set end_page = min(total_pages, start_page + 4) %}
            {% else %}
                {% set start_page = max(1, end_page - 4) %}
            {% endif %}
        {% endif %}

        {% if start_page > 1 %}
        <a href="/clients?search={{ search|url_encode }}&filter={{ filter }}&sort={{ sort }}&page=1"
           class="w-8 h-8 flex items-center justify-center rounded-lg bg-slate-800/40 hover:bg-slate-700 text-xs text-slate-400 hover:text-white border border-slate-750/60 transition-all font-mono">1</a>
        {% if start_page > 2 %}
        <span class="text-slate-650 px-0.5 text-xs font-mono select-none">...</span>
        {% endif %}
        {% endif %}

        {% for p in start_page..end_page %}
        <a href="/clients?search={{ search|url_encode }}&filter={{ filter }}&sort={{ sort }}&page={{ p }}"
           class="w-8 h-8 flex items-center justify-center rounded-lg text-xs border transition-all font-mono {% if p == current_page %}bg-indigo-600 text-white border-indigo-500 font-bold{% else %}bg-slate-800/40 hover:bg-slate-700 text-slate-400 hover:text-white border-slate-750/60{% endif %}">
            {{ p }}
        </a>
        {% endfor %}

        {% if end_page < total_pages %}
        {% if end_page < total_pages - 1 %}
        <span class="text-slate-655 px-0.5 text-xs font-mono select-none">...</span>
        {% endif %}
        <a href="/clients?search={{ search|url_encode }}&filter={{ filter }}&sort={{ sort }}&page={{ total_pages }}"
           class="w-8 h-8 flex items-center justify-center rounded-lg bg-slate-800/40 hover:bg-slate-700 text-xs text-slate-400 hover:text-white border border-slate-750/60 transition-all font-mono">{{ total_pages }}</a>
        {% endif %}

        {# Next Button #}
        {% if current_page < total_pages %}
        <a href="/clients?search={{ search|url_encode }}&filter={{ filter }}&sort={{ sort }}&page={{ current_page + 1 }}"
           class="px-3 py-1.5 rounded-lg bg-slate-800/60 hover:bg-slate-700 text-xs text-slate-300 hover:text-white border border-slate-700/60 transition-all ml-1">
            <i class="fas fa-chevron-right"></i>
        </a>
        {% endif %}
    </div>
    {% endif %}
    {% endif %}

    {# ─── Single-code filtered view: show all configs for one code ─── #}
    {% if code_filter and code_configs is defined %}
    <div class="mt-8 panel border-slate-800/60 bg-slate-900/60 backdrop-blur overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-800 flex items-center justify-between">
            <h2 class="font-semibold text-white flex items-center gap-2">
                <i class="fas fa-list text-indigo-400"></i>
                All configs for <code class="ml-1 font-mono text-indigo-300">{{ code_filter }}</code>
            </h2>
            <a href="/clients" class="text-xs text-slate-400 hover:text-white transition-colors">
                <i class="fas fa-times mr-1"></i>Clear filter
            </a>
        </div>
        {% if code_configs is empty %}
        <div class="p-10 text-center text-slate-500 text-sm">No configs linked to this client yet.</div>
        {% else %}
        <div class="divide-y divide-slate-800">
            {% for cfg in code_configs %}
            <div class="flex items-center gap-4 px-5 py-3 hover:bg-slate-800/30 transition-colors">
                <div class="w-7 h-7 rounded-full bg-slate-800 flex items-center justify-center shrink-0">
                    <i class="fas fa-user text-xs text-slate-400"></i>
                </div>
                <div class="flex-1 min-w-0">
                    <span class="font-mono text-sm text-white">{{ cfg.name }}</span>
                    <span class="ml-3 text-xs text-slate-500">{{ cfg.server_name }}</span>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                    {% if cfg.status == 'active' %}
                        <span class="{{ cfg.last_active_class }} text-xs px-2 py-0.5 rounded font-medium">{{ cfg.last_active_text }}</span>
                    {% else %}
                        <span class="badge-error text-xs px-2 py-0.5 rounded font-medium">{{ cfg.status|capitalize }}</span>
                    {% endif %}
                    {% if cfg.router_id %}
                    <button onclick="event.preventDefault(); triggerRouterPush({{ cfg.router_id }}, {{ cfg.id }})" class="btn-secondary px-3 py-1.5 text-xs text-indigo-450 hover:text-indigo-300 border-indigo-500/20 hover:bg-indigo-500/10 flex items-center gap-1" title="Push this config to router">
                        <i class="fas fa-upload"></i>Push
                    </button>
                    {% endif %}
                    <a href="/clients/{{ cfg.id }}" class="btn-secondary px-3 py-1.5 text-xs flex items-center gap-1">
                        <i class="fas fa-eye"></i>View
                    </a>
                </div>
            </div>
            {% endfor %}
        </div>
        {% endif %}
    </div>
    {% endif %}

</div>

{# ─── Create Config for Client Modal ─── #}
{# Reuses the same POST endpoint as normal config creation, but pre-fills ext_client_code #}
<div id="createForClientModal"
     class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm hidden"
     onclick="if(event.target===this) closeCreateForClientModal()">
    <div class="panel p-6 w-full max-w-md border-slate-700/60 bg-slate-900/95 backdrop-blur shadow-2xl">
        <div class="flex items-center justify-between mb-5">
            <h3 class="font-semibold text-white flex items-center gap-2">
                <i class="fas fa-user-plus text-indigo-400"></i>
                New Config for Client
            </h3>
            <button onclick="closeCreateForClientModal()" class="text-slate-500 hover:text-white transition-colors p-1">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <p class="text-sm text-slate-400 mb-4">
            Creating a VPN config linked to client
            <code id="modalClientCodeDisplay" class="text-indigo-300 font-mono"></code>.
        </p>

        {# We need to pick a server first; get the list of servers via a <select> #}
        <form method="POST" id="createForClientForm" action="" onsubmit="submitCreateForClient(event)">
            <input type="hidden" name="ext_client_code" id="modalExtClientCode">

            <div class="mb-4">
                <label class="block text-xs text-slate-400 mb-1.5 uppercase tracking-wide">Server</label>
                <select name="_server_id" id="modalServerId"
                        class="input-field w-full px-4 py-2.5 text-sm rounded-lg"
                        required>
                    <option value="">— pick a server —</option>
                    {% for srv in all_servers %}
                    <option value="{{ srv.id }}">{{ srv.name }} ({{ srv.host }})</option>
                    {% endfor %}
                </select>
            </div>

            <div class="mb-5">
                <label class="block text-xs text-slate-400 mb-1.5 uppercase tracking-wide">Config Name</label>
                <input type="text" name="name" id="modalConfigName" required
                       class="input-field w-full px-4 py-2.5 text-sm rounded-lg"
                       placeholder="e.g. ABC_phone">
                <p class="text-[11px] text-slate-600 mt-1.5">Defaults to the client code if left as-is.</p>
            </div>

            <div class="flex gap-2">
                <button type="button" onclick="closeCreateForClientModal()"
                        class="btn-secondary flex-1 py-2.5 text-sm">Cancel</button>
                <button type="submit" class="btn-primary flex-1 py-2.5 text-sm" id="modalSubmitBtn">
                    <i class="fas fa-plus mr-2"></i>Create Config
                </button>
            </div>
        </form>
    </div>
</div>

<script>
function openCreateForClient(code) {
    document.getElementById('modalClientCodeDisplay').textContent = code;
    document.getElementById('modalExtClientCode').value = code;
    document.getElementById('modalConfigName').value = code;
    document.getElementById('createForClientModal').classList.remove('hidden');
}

function closeCreateForClientModal() {
    document.getElementById('createForClientModal').classList.add('hidden');
}

function submitCreateForClient(e) {
    e.preventDefault();
    const serverId = document.getElementById('modalServerId').value;
    if (!serverId) {
        alert('Please pick a server.');
        return;
    }
    const form = document.getElementById('createForClientForm');
    form.action = '/servers/' + serverId + '/clients/create';
    form.submit();
}

// ── Search autocomplete ──────────────────────────────────────────────────────
let searchTimer = null;

function onSearchInput(value) {
    clearTimeout(searchTimer);
    if (value.length < 1) {
        hideSearchDropdown();
        return;
    }
    searchTimer = setTimeout(() => fetchSearchCodes(value), 220);
}

function fetchSearchCodes(q) {
    const icon = document.getElementById('searchIcon');
    const originalClass = icon.className;
    icon.className = 'fas fa-spinner fa-spin absolute left-3 top-1/2 -translate-y-1/2 text-slate-500 text-xs pointer-events-none';

    fetch('/api/ext-clients/search?q=' + encodeURIComponent(q))
        .then(r => r.json())
        .then(data => {
            icon.className = originalClass;
            renderSearchDropdown(data.codes || []);
        })
        .catch(() => {
            icon.className = originalClass;
            hideSearchDropdown();
        });
}

function renderSearchDropdown(codes) {
    const dd = document.getElementById('searchDropdown');
    dd.innerHTML = '';
    if (!codes.length) {
        dd.innerHTML = '<div class="px-4 py-3 text-slate-500 text-xs">No matches</div>';
        dd.classList.remove('hidden');
        return;
    }
    codes.forEach(code => {
        const item = document.createElement('button');
        item.type = 'button';
        item.className = 'w-full text-left px-4 py-2.5 hover:bg-slate-800 text-slate-200 hover:text-white transition-colors font-mono text-xs flex items-center gap-2';
        item.innerHTML = '<i class="fas fa-user text-slate-600"></i>' + escapeHtml(code);
        item.addEventListener('mousedown', () => selectSearchCode(code));
        dd.appendChild(item);
    });
    dd.classList.remove('hidden');
}

function selectSearchCode(code) {
    document.getElementById('clientSearchInput').value = code;
    hideSearchDropdown();
    document.getElementById('searchForm').submit();
}

function hideSearchDropdown() {
    const dd = document.getElementById('searchDropdown');
    if (dd) dd.classList.add('hidden');
}

function escapeHtml(str) {
    return str.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

// ── Sync with DB action ──────────────────────────────────────────────────────
function triggerClientSync() {
    const btn = document.getElementById('syncClientBtn');
    const icon = document.getElementById('syncClientIcon');
    
    if (btn.disabled) return;
    
    btn.disabled = true;
    btn.classList.add('opacity-70', 'cursor-not-allowed');
    icon.classList.add('fa-spin');
    
    fetch('/api/ext-clients/sync', {
        method: 'POST'
    })
    .then(r => r.json().then(data => ({ status: r.status, body: data })))
    .then(res => {
        if (res.status === 200 && res.body.success) {
            alert('Sync successful! Loaded ' + res.body.count + ' clients.');
            window.location.reload();
        } else {
            alert('Sync failed: ' + (res.body.error || 'Unknown error'));
            btn.disabled = false;
            btn.classList.remove('opacity-70', 'cursor-not-allowed');
            icon.classList.remove('fa-spin');
        }
    })
    .catch(err => {
        alert('Sync error: ' + err.message);
        btn.disabled = false;
        btn.classList.remove('opacity-70', 'cursor-not-allowed');
        icon.classList.remove('fa-spin');
    });
}

// Close autocomplete dropdown when clicking outside
document.addEventListener('click', function(e) {
    const searchInput = document.getElementById('clientSearchInput');
    const dropdown = document.getElementById('searchDropdown');
    if (searchInput && dropdown) {
        if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) {
            hideSearchDropdown();
        }
    }
});

// Router action handlers
function triggerRouterPush(routerId, vpnClientId) {
    if (!confirm('Are you sure you want to push the configuration to this router?')) return;
    
    const btn = event.currentTarget;
    const icon = btn.querySelector('i');
    const oldClass = icon.className;
    icon.className = 'fas fa-spinner fa-spin text-indigo-400';
    btn.disabled = true;

    let url = '/api/routers/' + routerId + '/push';
    if (vpnClientId) {
        url += '?vpn_client_id=' + vpnClientId;
    }

    fetch(url, {
        method: 'POST'
    })
    .then(r => r.json().then(data => ({ status: r.status, body: data })))
    .then(res => {
        if (res.status === 200 && res.body.success) {
            alert('Config pushed successfully!\nModel: ' + res.body.router_model + '\nInterface: ' + res.body.interface_id);
            window.location.reload();
        } else {
            alert('Push failed: ' + (res.body.error || 'Unknown error'));
            icon.className = oldClass;
            btn.disabled = false;
        }
    })
    .catch(err => {
        alert('Error: ' + err.message);
        icon.className = oldClass;
        btn.disabled = false;
    });
}

function triggerRouterCheck(routerId) {
    const btn = event.currentTarget;
    const icon = btn.querySelector('i');
    const oldClass = icon.className;
    icon.className = 'fas fa-spinner fa-spin text-cyan-400';
    btn.disabled = true;

    fetch('/api/routers/' + routerId + '/check', {
        method: 'POST'
    })
    .then(r => r.json().then(data => ({ status: r.status, body: data })))
    .then(res => {
        if (res.status === 200 && res.body.success) {
            alert('Status check completed!\nStatus: ' + res.body.status + '\nModel: ' + res.body.router_model + (res.body.error ? '\nError: ' + res.body.error : ''));
            window.location.reload();
        } else {
            alert('Check failed: ' + (res.body.error || 'Unknown error'));
            icon.className = oldClass;
            btn.disabled = false;
        }
    })
    .catch(err => {
        alert('Error: ' + err.message);
        icon.className = oldClass;
        btn.disabled = false;
    });
}
</script>
{% endblock %}
