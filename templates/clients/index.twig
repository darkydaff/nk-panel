</dialog>

<script>
// View Switcher (Grid vs Table) with LocalStorage persistence
function setClientViewMode(mode) {
    const gridView = document.getElementById('clientsGridView');
    const tableView = document.getElementById('clientsTableView');
    const btnGrid = document.getElementById('viewBtnGrid');
    const btnTable = document.getElementById('viewBtnTable');

    if (mode === 'table') {
        if (gridView) gridView.classList.add('hidden');
        if (tableView) tableView.classList.remove('hidden');
        if (btnGrid) { btnGrid.classList.remove('btn-active', 'bg-base-100', 'shadow-sm'); }
        if (btnTable) { btnTable.classList.add('btn-active', 'bg-base-100', 'shadow-sm'); }
        localStorage.setItem('nk_clients_view_mode', 'table');
    } else {
        if (tableView) tableView.classList.add('hidden');
        if (gridView) gridView.classList.remove('hidden');
        if (btnTable) { btnTable.classList.remove('btn-active', 'bg-base-100', 'shadow-sm'); }
        if (btnGrid) { btnGrid.classList.add('btn-active', 'bg-base-100', 'shadow-sm'); }
        localStorage.setItem('nk_clients_view_mode', 'grid');
    }
}

// Restore saved view mode on page load
document.addEventListener('DOMContentLoaded', () => {
    const savedMode = localStorage.getItem('nk_clients_view_mode') || 'grid';
    setClientViewMode(savedMode);
});

function openCreateForClient(code) {
    document.getElementById('modalClientCodeDisplay').textContent = code;
    document.getElementById('modalExtClientCode').value = code;
    document.getElementById('modalConfigName').value = code;
    document.getElementById('createForClientModal').showModal();
}

function closeCreateForClientModal() {
    document.getElementById('createForClientModal').close();
}

function submitCreateForClient(e) {
    e.preventDefault();
    const serverId = document.getElementById('modalServerId').value;
    if (!serverId) { alert('Please pick a server.'); return; }
    const form = document.getElementById('createForClientForm');
    form.action = '/servers/' + serverId + '/clients/create';
    form.submit();
}

// ── Search autocomplete ──────────────────────────────────────────────────────
let searchTimer = null;

function onSearchInput(value) {
    clearTimeout(searchTimer);
    if (value.length < 1) { hideSearchDropdown(); return; }
    searchTimer = setTimeout(() => fetchSearchCodes(value), 220);
}

function fetchSearchCodes(q) {
    const icon = document.getElementById('searchIcon');
    const originalClass = icon.className;
    icon.className = 'fas fa-spinner fa-spin text-base-content/30 text-xs';
    fetch('/api/ext-clients/search?q=' + encodeURIComponent(q))
        .then(r => r.json())
        .then(data => { icon.className = originalClass; renderSearchDropdown(data.codes || []); })
        .catch(() => { icon.className = originalClass; hideSearchDropdown(); });
}

function renderSearchDropdown(codes) {
    const dd = document.getElementById('searchDropdown');
    dd.innerHTML = '';
    if (!codes.length) { dd.innerHTML = '<div class="px-4 py-3 text-base-content/40 text-xs">No matches</div>'; dd.classList.remove('hidden'); return; }
    codes.forEach(code => {
        const item = document.createElement('button');
        item.type = 'button';
        item.className = 'w-full text-left px-4 py-2.5 hover:bg-base-200 transition-colors font-mono text-xs flex items-center gap-2';
        item.innerHTML = '<i class="fas fa-user text-base-content/30"></i>' + escapeHtml(code);
        item.addEventListener('mousedown', () => selectSearchCode(code));
        dd.appendChild(item);
    });
    dd.classList.remove('hidden');
}

function selectSearchCode(code) {
    document.getElementById('clientSearchInput').value = code;
    hideSearchDropdown();
    document.getElementById('searchForm').submit();
}

function hideSearchDropdown() { const dd = document.getElementById('searchDropdown'); if (dd) dd.classList.add('hidden'); }

function escapeHtml(str) { return str.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

function triggerClientSync() {
    const btn = document.getElementById('syncClientBtn');
    const icon = document.getElementById('syncClientIcon');
    if (btn.disabled) return;
    btn.disabled = true; btn.classList.add('opacity-70', 'cursor-not-allowed'); icon.classList.add('fa-spin');
    fetch('/api/ext-clients/sync', { method: 'POST' })
        .then(r => r.json().then(data => ({ status: r.status, body: data })))
        .then(res => {
            if (res.status === 200 && res.body.success) { alert('Sync successful! Loaded ' + res.body.count + ' clients.'); window.location.reload(); }
            else { alert('Sync failed: ' + (res.body.error || 'Unknown error')); btn.disabled = false; btn.classList.remove('opacity-70', 'cursor-not-allowed'); icon.classList.remove('fa-spin'); }
        })
        .catch(err => { alert('Sync error: ' + err.message); btn.disabled = false; btn.classList.remove('opacity-70', 'cursor-not-allowed'); icon.classList.remove('fa-spin'); });
}

document.addEventListener('click', function(e) {
    const searchInput = document.getElementById('clientSearchInput');
    const dropdown = document.getElementById('searchDropdown');
    if (searchInput && dropdown && !searchInput.closest('label').contains(e.target) && !dropdown.contains(e.target)) hideSearchDropdown();
});

function triggerRouterPush(routerId, vpnClientId) {
    if (!confirm('Are you sure you want to push the configuration to this router?')) return;
    const btn = event.currentTarget;
    const icon = btn.querySelector('i');
    const oldClass = icon.className;
    icon.className = 'fas fa-spinner fa-spin text-primary';
    btn.disabled = true;
    let url = '/api/routers/' + routerId + '/push';
    if (vpnClientId) url += '?vpn_client_id=' + vpnClientId;
    fetch(url, { method: 'POST' })
        .then(r => r.json().then(data => ({ status: r.status, body: data })))
        .then(res => {
            if (res.status === 200 && res.body.success) { alert('Config pushed successfully!\nModel: ' + res.body.router_model + '\nInterface: ' + res.body.interface_id); window.location.reload(); }
            else { alert('Push failed: ' + (res.body.error || 'Unknown error')); icon.className = oldClass; btn.disabled = false; }
        })
        .catch(err => { alert('Error: ' + err.message); icon.className = oldClass; btn.disabled = false; });
}

function openAddClientModal() {
    document.getElementById('addClientForm').reset();
    document.getElementById('addClientModal').showModal();
}

async function submitAddClient(e) {
    e.preventDefault();
    const btn = document.getElementById('saveAddClientBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';

    const form = e.target;
    const formData = new FormData(form);

    try {
        const res = await fetch('/api/clients/create', {
            method: 'POST',
            headers: { 'X-CSRF-Token': '{{ csrf_token() }}' },
            body: formData
        });
        const json = await res.json();
        if (json.success) {
            window.location.reload();
        } else {
            alert('Error: ' + (json.error || 'Failed to create client'));
        }
    } catch (err) {
        alert('Network Error: ' + err.message);
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-save"></i> Save Client';
    }
}

async function openEditClientModal(code) {
    try {
        const res = await fetch('/api/clients/get?code=' + encodeURIComponent(code));
        const json = await res.json();
        if (!json.success || !json.client) {
            alert('Could not fetch client record.');
            return;
        }
        const c = json.client;
        document.getElementById('editOriginalCode').value = c.Code || code;
        document.getElementById('editClientCodeHeading').textContent = c.Code || code;
        document.getElementById('editCode').value = c.Code || '';
        document.getElementById('editName').value = c.Name || '';
        document.getElementById('editStartDate').value = c.Start_Date || '';
        document.getElementById('editSub').value = c.Sub !== null ? c.Sub : '';
        document.getElementById('editFunc').value = c.Func || 'WORK';
        document.getElementById('editRouter').value = c.Router || '';
        document.getElementById('editDomain').value = c.Domain || '';
        document.getElementById('editPass').value = c.Pass || '';
        document.getElementById('editTgid').value = c.tgid || '';
        document.getElementById('editServersId').value = c.Servers_id !== null ? c.Servers_id : '';

        document.getElementById('editClientModal').showModal();
    } catch (err) {
        alert('Error loading client: ' + err.message);
    }
}

async function submitEditClient(e) {
    e.preventDefault();
    const btn = document.getElementById('saveEditClientBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Updating...';

    const form = e.target;
    const formData = new FormData(form);

    try {
        const res = await fetch('/api/clients/update', {
            method: 'POST',
            headers: { 'X-CSRF-Token': '{{ csrf_token() }}' },
            body: formData
        });
        const json = await res.json();
        if (json.success) {
            window.location.reload();
        } else {
            alert('Error: ' + (json.error || 'Failed to update client'));
        }
    } catch (err) {
        alert('Network Error: ' + err.message);
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-check"></i> Update Record';
    }
}

async function deleteClientFromModal() {
    const code = document.getElementById('editOriginalCode').value;
    if (!code) return;
    if (!confirm('Are you sure you want to delete client ' + code + ' from PostgreSQL?')) return;

    try {
        const formData = new FormData();
        formData.append('code', code);
        const res = await fetch('/api/clients/delete', {
            method: 'POST',
            headers: { 'X-CSRF-Token': '{{ csrf_token() }}' },
            body: formData
        });
        const json = await res.json();
        if (json.success) {
            window.location.reload();
        } else {
            alert('Error: ' + (json.error || 'Failed to delete client'));
        }
    } catch (err) {
        alert('Network Error: ' + err.message);
    }
}
</script>

