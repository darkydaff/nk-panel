        </div>

        <p class="text-sm text-base-content/50 mb-4">
            Creating a VPN config linked to client <code id="modalClientCodeDisplay" class="text-primary font-mono"></code>.
        </p>

        <form method="POST" id="createForClientForm" action="" onsubmit="submitCreateForClient(event)" class="space-y-4">
