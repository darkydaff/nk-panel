                <i class="fas fa-receipt text-emerald-400"></i> Linked Payments: <span id="paymentModalClientCode" class="font-mono text-primary"></span>
            </h3>
            <button onclick="openAddTxForClient()" class="btn btn-xs text-white bg-emerald-600 hover:bg-emerald-700 border-none gap-1">
                <i class="fas fa-plus"></i> Open in Finances
            </button>
        </div>

        <div class="py-4 space-y-4">
            <div id="paymentModalClientBanner" class="p-3 bg-base-200 rounded-xl flex flex-wrap items-center justify-between text-xs font-mono gap-2">
            </div>

            <div class="overflow-x-auto max-h-60 overflow-y-auto">
                <table class="table table-xs table-zebra w-full font-mono">
                    <thead>
                        <tr class="bg-base-200">
                            <th>Date</th>
                            <th>Type</th>
                            <th>Amount</th>
