{% extends "layout.twig" %}
{% block title %}Clients{% endblock %}

{% block breadcrumbs %}
    <a href="/dashboard" class="hover:text-slate-300 transition-colors">Home</a>
    <i class="fas fa-chevron-right text-[10px] text-slate-700 mx-1"></i>
    <span class="text-slate-300">Clients</span>
{% endblock %}

{% block content %}
<div class="w-full mx-auto max-w-7xl">

    {# ─── Page Header ─── #}
    <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-white flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-indigo-500/15 text-indigo-400 flex items-center justify-center">
                    <i class="fas fa-users"></i>
                </div>
                Clients
            </h1>
            <p class="mt-1 text-sm text-slate-500">
                Clients from external DB &mdash;
                <span class="text-slate-400 font-mono">{{ total_count }}</span> total
                {% if ext_db_error %}
                    &middot; <span class="text-red-400 text-xs"><i class="fas fa-exclamation-triangle mr-1"></i>External DB unavailable</span>
                {% endif %}
            </p>
        </div>

        {# Search form #}
        <form method="GET" action="/clients" class="flex gap-2 w-full sm:w-auto" id="searchForm">
            <div class="relative flex-1 sm:w-64">
                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-500 text-xs pointer-events-none" id="searchIcon"></i>
                <input
                    type="text"
                    name="search"
                    id="clientSearchInput"
                    value="{{ search }}"
                    placeholder="Search by code..."
                    class="input-field pl-9 pr-8 py-2.5 text-sm w-full rounded-lg"
                    autocomplete="off"
                    oninput="onSearchInput(this.value)"
                >
                <div id="searchDropdown"
                     class="hidden absolute z-50 mt-1 w-full bg-slate-900 border border-slate-700 rounded-lg shadow-xl overflow-hidden max-h-48 overflow-y-auto text-sm">
                </div>
            </div>
            <button type="submit" class="btn-primary px-4 py-2.5 text-sm whitespace-nowrap">
                <i class="fas fa-search mr-2"></i>Search
            </button>
            {% if search or code_filter %}
            <a href="/clients" class="btn-secondary px-4 py-2.5 text-sm whitespace-nowrap">
                <i class="fas fa-times mr-1"></i>Clear
            </a>
            {% endif %}
        </form>
    </div>

    {# ─── External DB error banner ─── #}
    {% if ext_db_error %}
    <div class="mb-6 bg-red-500/10 border border-red-500/30 rounded-xl px-5 py-4 flex items-start gap-3">
        <i class="fas fa-database text-red-400 mt-0.5"></i>
        <div>
            <p class="text-sm font-medium text-red-300">Cannot reach external database</p>
            <p class="text-xs text-red-400/80 mt-0.5">{{ ext_db_error }}</p>
        </div>
    </div>
    {% endif %}

    {# ─── Clients Grid ─── #}
    {% if clients is empty %}
        <div class="panel p-16 text-center border-slate-800/60 bg-slate-900/40">
            <div class="w-16 h-16 rounded-full bg-slate-800 flex items-center justify-center mx-auto mb-4">
                <i class="fas fa-users text-2xl text-slate-600"></i>
            </div>
            <p class="text-slate-400 font-medium">No clients found</p>
            {% if search %}
            <p class="text-slate-500 text-sm mt-1">No results for "<span class="text-slate-400">{{ search }}</span>"</p>
            {% endif %}
        </div>
    {% else %}
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4 mb-6">
        {% for client in clients %}
        <div class="panel p-5 border-slate-800/60 bg-slate-900/60 backdrop-blur hover:border-indigo-500/30 hover:-translate-y-0.5 transition-all duration-200 group">
            {# Header row #}
            <div class="flex items-start justify-between mb-4">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-lg bg-indigo-500/15 text-indigo-400 flex items-center justify-center shrink-0 group-hover:bg-indigo-500/25 transition-colors">
                        <i class="fas fa-user text-sm"></i>
                    </div>
                    <div>
                        <span class="font-semibold text-white font-mono text-sm tracking-wide">{{ client.Code }}</span>
                        <p class="text-[10px] text-slate-500 mt-0.5 uppercase tracking-wider">Client Code</p>
                    </div>
                </div>

                {# Configs count badge #}
                <span class="bg-slate-800 border border-slate-700 text-slate-300 px-2.5 py-1 rounded-lg text-xs font-mono shrink-0">
                    {{ client.config_count }} config{{ client.config_count != 1 ? 's' : '' }}
                </span>
            </div>

            {# Config chips #}
            {% if client.configs is not empty %}
            <div class="flex flex-wrap gap-1.5 mb-4">
                {% for cfg in client.configs|slice(0, 5) %}
                <a href="/clients/{{ cfg.id }}"
                   class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-slate-800/80 hover:bg-slate-700 text-xs text-slate-300 hover:text-white border border-slate-700/60 hover:border-slate-600 transition-all">
                    <i class="fas fa-server text-[9px] text-slate-500"></i>
                    <span class="font-mono truncate max-w-[100px]">{{ cfg.name }}</span>
                    {% if cfg.status == 'active' %}
                        <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 shrink-0"></span>
                    {% else %}
                        <span class="w-1.5 h-1.5 rounded-full bg-slate-600 shrink-0"></span>
                    {% endif %}
                </a>
                {% endfor %}
                {% if client.config_count > 5 %}
                <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-slate-800/50 text-xs text-slate-500 border border-slate-800">
                    +{{ client.config_count - 5 }} more
                </span>
                {% endif %}
            </div>
            {% else %}
            <p class="text-xs text-slate-600 italic mb-4">No configs yet</p>
            {% endif %}

            {# Footer actions #}
            <div class="flex gap-2 pt-3 border-t border-slate-800/60">
                <a href="/clients?code={{ client.Code|url_encode }}"
                   class="btn-secondary flex-1 text-center py-2 text-xs flex items-center justify-center gap-1.5">
                    <i class="fas fa-eye"></i>All Configs
                </a>
                <button
                    onclick="openCreateForClient('{{ client.Code|e('js') }}')"
                    class="flex-1 py-2 px-3 rounded-lg text-xs bg-indigo-500/10 hover:bg-indigo-500/20 text-indigo-400 hover:text-indigo-300 border border-indigo-500/30 hover:border-indigo-500/50 transition-all flex items-center justify-center gap-1.5">
                    <i class="fas fa-plus"></i>New Config
                </button>
            </div>
        </div>
        {% endfor %}
    </div>

    {# ─── Pagination ─── #}
    {% if total_pages > 1 %}
    <div class="flex items-center justify-center gap-1.5 mt-8 flex-wrap">
        {# Prev Button #}
        {% if current_page > 1 %}
        <a href="/clients?search={{ search|url_encode }}&page={{ current_page - 1 }}"
           class="px-3 py-1.5 rounded-lg bg-slate-800/60 hover:bg-slate-700 text-xs text-slate-300 hover:text-white border border-slate-700/60 transition-all mr-1">
            <i class="fas fa-chevron-left"></i>
        </a>
        {% endif %}

        {# Pages #}
        {% set start_page = max(1, current_page - 2) %}
        {% set end_page = min(total_pages, current_page + 2) %}

        {# Adjust if at the boundaries to keep a consistent size (e.g. 5 pages) #}
        {% if end_page - start_page < 4 %}
            {% if start_page == 1 %}
                {% set end_page = min(total_pages, start_page + 4) %}
            {% else %}
                {% set start_page = max(1, end_page - 4) %}
            {% endif %}
        {% endif %}

        {% if start_page > 1 %}
        <a href="/clients?search={{ search|url_encode }}&page=1"
           class="w-8 h-8 flex items-center justify-center rounded-lg bg-slate-800/40 hover:bg-slate-700 text-xs text-slate-400 hover:text-white border border-slate-750/60 transition-all font-mono">1</a>
        {% if start_page > 2 %}
        <span class="text-slate-650 px-0.5 text-xs font-mono select-none">...</span>
        {% endif %}
        {% endif %}

        {% for p in start_page..end_page %}
        <a href="/clients?search={{ search|url_encode }}&page={{ p }}"
           class="w-8 h-8 flex items-center justify-center rounded-lg text-xs border transition-all font-mono {% if p == current_page %}bg-indigo-600 text-white border-indigo-500 font-bold{% else %}bg-slate-800/40 hover:bg-slate-700 text-slate-400 hover:text-white border-slate-750/60{% endif %}">
            {{ p }}
        </a>
        {% endfor %}

        {% if end_page < total_pages %}
        {% if end_page < total_pages - 1 %}
        <span class="text-slate-655 px-0.5 text-xs font-mono select-none">...</span>
        {% endif %}
        <a href="/clients?search={{ search|url_encode }}&page={{ total_pages }}"
           class="w-8 h-8 flex items-center justify-center rounded-lg bg-slate-800/40 hover:bg-slate-700 text-xs text-slate-400 hover:text-white border border-slate-750/60 transition-all font-mono">{{ total_pages }}</a>
        {% endif %}

        {# Next Button #}
        {% if current_page < total_pages %}
        <a href="/clients?search={{ search|url_encode }}&page={{ current_page + 1 }}"
           class="px-3 py-1.5 rounded-lg bg-slate-800/60 hover:bg-slate-700 text-xs text-slate-300 hover:text-white border border-slate-700/60 transition-all ml-1">
            <i class="fas fa-chevron-right"></i>
        </a>
        {% endif %}
    </div>
    {% endif %}
    {% endif %}

    {# ─── Single-code filtered view: show all configs for one code ─── #}
    {% if code_filter and code_configs is defined %}
    <div class="mt-8 panel border-slate-800/60 bg-slate-900/60 backdrop-blur overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-800 flex items-center justify-between">
            <h2 class="font-semibold text-white flex items-center gap-2">
                <i class="fas fa-list text-indigo-400"></i>
                All configs for <code class="ml-1 font-mono text-indigo-300">{{ code_filter }}</code>
            </h2>
            <a href="/clients" class="text-xs text-slate-400 hover:text-white transition-colors">
                <i class="fas fa-times mr-1"></i>Clear filter
            </a>
        </div>
        {% if code_configs is empty %}
        <div class="p-10 text-center text-slate-500 text-sm">No configs linked to this client yet.</div>
        {% else %}
        <div class="divide-y divide-slate-800">
            {% for cfg in code_configs %}
            <div class="flex items-center gap-4 px-5 py-3 hover:bg-slate-800/30 transition-colors">
                <div class="w-7 h-7 rounded-full bg-slate-800 flex items-center justify-center shrink-0">
                    <i class="fas fa-user text-xs text-slate-400"></i>
                </div>
                <div class="flex-1 min-w-0">
                    <span class="font-mono text-sm text-white">{{ cfg.name }}</span>
                    <span class="ml-3 text-xs text-slate-500">{{ cfg.server_name }}</span>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                    {% if cfg.status == 'active' %}
                    <span class="badge-active text-xs px-2 py-0.5 rounded">Active</span>
                    {% else %}
                    <span class="badge-error text-xs px-2 py-0.5 rounded">{{ cfg.status }}</span>
                    {% endif %}
                    <a href="/clients/{{ cfg.id }}" class="btn-secondary px-3 py-1.5 text-xs">
                        <i class="fas fa-eye mr-1"></i>View
                    </a>
                </div>
            </div>
            {% endfor %}
        </div>
        {% endif %}
    </div>
    {% endif %}

</div>

{# ─── Create Config for Client Modal ─── #}
{# Reuses the same POST endpoint as normal config creation, but pre-fills ext_client_code #}
<div id="createForClientModal"
     class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm hidden"
     onclick="if(event.target===this) closeCreateForClientModal()">
    <div class="panel p-6 w-full max-w-md border-slate-700/60 bg-slate-900/95 backdrop-blur shadow-2xl">
        <div class="flex items-center justify-between mb-5">
            <h3 class="font-semibold text-white flex items-center gap-2">
                <i class="fas fa-user-plus text-indigo-400"></i>
                New Config for Client
            </h3>
            <button onclick="closeCreateForClientModal()" class="text-slate-500 hover:text-white transition-colors p-1">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <p class="text-sm text-slate-400 mb-4">
            Creating a VPN config linked to client
            <code id="modalClientCodeDisplay" class="text-indigo-300 font-mono"></code>.
        </p>

        {# We need to pick a server first; get the list of servers via a <select> #}
        <form method="POST" id="createForClientForm" action="" onsubmit="submitCreateForClient(event)">
            <input type="hidden" name="ext_client_code" id="modalExtClientCode">

            <div class="mb-4">
                <label class="block text-xs text-slate-400 mb-1.5 uppercase tracking-wide">Server</label>
                <select name="_server_id" id="modalServerId"
                        class="input-field w-full px-4 py-2.5 text-sm rounded-lg"
                        required>
                    <option value="">— pick a server —</option>
                    {% for srv in all_servers %}
                    <option value="{{ srv.id }}">{{ srv.name }} ({{ srv.host }})</option>
                    {% endfor %}
                </select>
            </div>

            <div class="mb-5">
                <label class="block text-xs text-slate-400 mb-1.5 uppercase tracking-wide">Config Name</label>
                <input type="text" name="name" id="modalConfigName" required
                       class="input-field w-full px-4 py-2.5 text-sm rounded-lg"
                       placeholder="e.g. ABC_phone">
                <p class="text-[11px] text-slate-600 mt-1.5">Defaults to the client code if left as-is.</p>
            </div>

            <div class="flex gap-2">
                <button type="button" onclick="closeCreateForClientModal()"
                        class="btn-secondary flex-1 py-2.5 text-sm">Cancel</button>
                <button type="submit" class="btn-primary flex-1 py-2.5 text-sm" id="modalSubmitBtn">
                    <i class="fas fa-plus mr-2"></i>Create Config
                </button>
            </div>
        </form>
    </div>
</div>

<script>
function openCreateForClient(code) {
    document.getElementById('modalClientCodeDisplay').textContent = code;
    document.getElementById('modalExtClientCode').value = code;
    document.getElementById('modalConfigName').value = code;
    document.getElementById('createForClientModal').classList.remove('hidden');
}

function closeCreateForClientModal() {
    document.getElementById('createForClientModal').classList.add('hidden');
}

function submitCreateForClient(e) {
    e.preventDefault();
    const serverId = document.getElementById('modalServerId').value;
    if (!serverId) {
        alert('Please pick a server.');
        return;
    }
    const form = document.getElementById('createForClientForm');
    form.action = '/servers/' + serverId + '/clients/create';
    form.submit();
}

// ── Search autocomplete ──────────────────────────────────────────────────────
let searchTimer = null;

function onSearchInput(value) {
    clearTimeout(searchTimer);
    if (value.length < 1) {
        hideSearchDropdown();
        return;
    }
    searchTimer = setTimeout(() => fetchSearchCodes(value), 220);
}

function fetchSearchCodes(q) {
    const icon = document.getElementById('searchIcon');
    const originalClass = icon.className;
    icon.className = 'fas fa-spinner fa-spin absolute left-3 top-1/2 -translate-y-1/2 text-slate-500 text-xs pointer-events-none';

    fetch('/api/ext-clients/search?q=' + encodeURIComponent(q))
        .then(r => r.json())
        .then(data => {
            icon.className = originalClass;
            renderSearchDropdown(data.codes || []);
        })
        .catch(() => {
            icon.className = originalClass;
            hideSearchDropdown();
        });
}

function renderSearchDropdown(codes) {
    const dd = document.getElementById('searchDropdown');
    dd.innerHTML = '';
    if (!codes.length) {
        dd.innerHTML = '<div class="px-4 py-3 text-slate-500 text-xs">No matches</div>';
        dd.classList.remove('hidden');
        return;
    }
    codes.forEach(code => {
        const item = document.createElement('button');
        item.type = 'button';
        item.className = 'w-full text-left px-4 py-2.5 hover:bg-slate-800 text-slate-200 hover:text-white transition-colors font-mono text-xs flex items-center gap-2';
        item.innerHTML = '<i class="fas fa-user text-slate-600"></i>' + escapeHtml(code);
        item.addEventListener('mousedown', () => selectSearchCode(code));
        dd.appendChild(item);
    });
    dd.classList.remove('hidden');
}

function selectSearchCode(code) {
    document.getElementById('clientSearchInput').value = code;
    hideSearchDropdown();
    document.getElementById('searchForm').submit();
}

function hideSearchDropdown() {
    const dd = document.getElementById('searchDropdown');
    if (dd) dd.classList.add('hidden');
}

function escapeHtml(str) {
    return str.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

// Close autocomplete dropdown when clicking outside
document.addEventListener('click', function(e) {
    const searchInput = document.getElementById('clientSearchInput');
    const dropdown = document.getElementById('searchDropdown');
    if (searchInput && dropdown) {
        if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) {
            hideSearchDropdown();
        }
    }
});
</script>
{% endblock %}
