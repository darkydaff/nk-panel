{% extends "layout.twig" %}
{% block title %}Clients{% endblock %}

{% block breadcrumbs %}
    <li><a href="/dashboard" class="hover:text-base-content transition-colors">Home</a></li>
    <li><span class="text-base-content/70">Clients</span></li>
{% endblock %}

{% block content %}
<div class="w-full">
    <!-- Page Header -->
    <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-base-300 text-primary flex items-center justify-center">
                    <i class="fas fa-users"></i>
                </div>
                Clients
            </h1>
            <p class="mt-1 text-sm text-base-content/50">
                Clients from external DB &mdash;
                <span class="font-mono text-base-content/70">{{ total_count }}</span> total
                {% if last_sync %}&middot; <span class="text-base-content/40 text-xs"><i class="fas fa-clock mr-1"></i>Last synced: {{ last_sync }}</span>{% endif %}
                {% if ext_db_error %}&middot; <span class="text-error text-xs"><i class="fas fa-exclamation-triangle mr-1"></i>External DB unavailable</span>{% endif %}
            </p>
        </div>

        <div class="flex flex-wrap sm:flex-nowrap gap-2 w-full sm:w-auto items-center">
            <form method="GET" action="/clients" class="flex gap-2 flex-1 sm:flex-initial" id="searchForm">
                <input type="hidden" name="filter" value="{{ filter }}">
                <input type="hidden" name="sort" value="{{ sort }}">
                <div class="relative flex-1 sm:w-64">
                    <label class="input input-bordered input-sm flex items-center gap-2">
                        <i class="fas fa-search text-base-content/30 text-xs" id="searchIcon"></i>
                        <input type="text" name="search" id="clientSearchInput" value="{{ search }}" placeholder="Search by code..." class="grow" autocomplete="off" oninput="onSearchInput(this.value)">
                    </label>
                    <div id="searchDropdown" class="hidden absolute z-50 mt-1 w-full bg-base-300 border border-base-content/10 rounded-xl shadow-xl overflow-hidden max-h-48 overflow-y-auto text-sm"></div>
                </div>
                <button type="submit" class="btn btn-primary btn-sm gap-2"><i class="fas fa-search"></i>Search</button>
                {% if search or code_filter %}<a href="/clients" class="btn btn-ghost btn-sm gap-2"><i class="fas fa-times"></i>Clear</a>{% endif %}
            </form>

            <button type="button" onclick="triggerClientSync()" id="syncClientBtn" class="btn btn-ghost btn-sm gap-2 whitespace-nowrap">
                <i class="fas fa-sync-alt" id="syncClientIcon"></i>Sync DB
            </button>
            {% if user.role == 'admin' %}
            <button type="button" onclick="toggleClientEditLock()" id="btnClientEditLock" class="btn btn-warning btn-outline btn-sm gap-2 whitespace-nowrap">
                <i class="fas fa-lock" id="clientEditLockIcon"></i><span id="clientEditLockText">Unlock Editing</span>
            </button>
            <button type="button" onclick="openAddClientModal()" id="btnAddClientHeader" class="btn btn-primary btn-sm gap-2 whitespace-nowrap hidden">
                <i class="fas fa-user-plus"></i>Add Client
            </button>
            {% endif %}
        </div>
    </div>

    {% if ext_db_error %}
    <div class="alert alert-error mb-6">
        <i class="fas fa-database"></i>
        <div>
            <p class="font-medium">Cannot reach external database</p>
            <p class="text-xs opacity-80 mt-0.5">{{ ext_db_error }}</p>
        </div>
    </div>
    {% endif %}

    <!-- Filter, Sort & View Controls -->
    <div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4 bg-base-200 p-4 border border-base-300 rounded-xl">
        <!-- Status Filter Buttons -->
        <div class="flex flex-wrap gap-1.5">
            <a href="/clients?filter=all&sort={{ sort }}&search={{ search|url_encode }}" class="btn btn-sm {% if filter == 'all' or filter == '' %}btn-primary{% else %}btn-ghost{% endif %}">All</a>
            <a href="/clients?filter=active&sort={{ sort }}&search={{ search|url_encode }}" class="btn btn-sm {% if filter == 'active' %}btn-success{% else %}btn-ghost{% endif %} gap-1.5">
                <i class="fas fa-calendar-check text-xs"></i>Active
            </a>
            <a href="/clients?filter=expiring&sort={{ sort }}&search={{ search|url_encode }}" class="btn btn-sm {% if filter == 'expiring' %}btn-warning{% else %}btn-ghost{% endif %} gap-1.5">
                <i class="fas fa-calendar-minus text-xs"></i>Expiring Soon
            </a>
            <a href="/clients?filter=expired&sort={{ sort }}&search={{ search|url_encode }}" class="btn btn-sm {% if filter == 'expired' %}btn-error{% else %}btn-ghost{% endif %} gap-1.5">
                <i class="fas fa-calendar-times text-xs"></i>Expired
            </a>
            <a href="/clients?filter=paused&sort={{ sort }}&search={{ search|url_encode }}" class="btn btn-sm {% if filter == 'paused' %}btn-info{% else %}btn-ghost{% endif %} gap-1.5">
                <i class="fas fa-pause-circle text-xs"></i>Paused
            </a>
        </div>

        <div class="flex items-center gap-3 w-full md:w-auto justify-between md:justify-end">
            <!-- Sort dropdown -->
            <div class="flex items-center gap-2">
                <span class="text-xs font-medium text-base-content/50 uppercase tracking-wider whitespace-nowrap">Sort by:</span>
                <select onchange="window.location.href='/clients?filter={{ filter }}&search={{ search|url_encode }}&sort=' + this.value"
                        class="select select-bordered select-sm min-w-[180px]">
                    <option value="code" {% if sort == 'code' or sort == '' %}selected{% endif %}>Client Code (A-Z)</option>
                    <option value="expiry_asc" {% if sort == 'expiry_asc' %}selected{% endif %}>Expiration (Soonest first)</option>
                    <option value="expiry_desc" {% if sort == 'expiry_desc' %}selected{% endif %}>Expiration (Latest first)</option>
                    <option value="payment_desc" {% if sort == 'payment_desc' %}selected{% endif %}>Latest Payment (Recent first)</option>
                    <option value="payment_asc" {% if sort == 'payment_asc' %}selected{% endif %}>Latest Payment (Oldest first)</option>
                    <option value="traffic_desc" {% if sort == 'traffic_desc' %}selected{% endif %}>Traffic (Highest first)</option>
                    <option value="traffic_asc" {% if sort == 'traffic_asc' %}selected{% endif %}>Traffic (Lowest first)</option>
                </select>
            </div>

            <!-- View Switcher Toggle -->
            <div class="join border border-base-300 rounded-lg p-0.5 bg-base-300/40 shrink-0">
                <button type="button" onclick="setClientViewMode('grid')" id="viewBtnGrid" class="join-item btn btn-xs btn-ghost gap-1.5 active-view-btn">
                    <i class="fas fa-th-large text-xs"></i><span class="hidden sm:inline">Grid</span>
                </button>
                <button type="button" onclick="setClientViewMode('table')" id="viewBtnTable" class="join-item btn btn-xs btn-ghost gap-1.5">
                    <i class="fas fa-list text-xs"></i><span class="hidden sm:inline">Table</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Clients Container -->
    {% if clients is empty %}
    <div class="card bg-base-200 border border-base-300">
        <div class="card-body items-center text-center py-16">
            <div class="w-16 h-16 rounded-full bg-base-300 flex items-center justify-center mb-4">
                <i class="fas fa-users text-base-content/20 text-2xl"></i>
            </div>
            <p class="text-base-content/50 font-medium">No clients found</p>
            {% if search %}<p class="text-base-content/30 text-sm mt-1">No results for "<span class="text-base-content/50">{{ search }}</span>"</p>{% endif %}
        </div>
    </div>
    {% else %}

    <!-- ── GRID VIEW ────────────────────────────────────────────────────────── -->
    <div id="clientsGridView" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4 mb-6">
        {% for client in clients %}
        <div class="card bg-base-200 border border-base-300 shadow-md hover:shadow-xl hover:border-primary/40 hover:-translate-y-0.5 transition-all duration-200 group">
            <div class="card-body p-5">
                <!-- Header row: Avatar + Code & Name + Subscription Badge -->
                <div class="flex items-start justify-between gap-2 mb-3 pb-3 border-b border-base-300">
                    <div class="flex items-center gap-3 min-w-0">
                        <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0 group-hover:bg-primary/20 transition-colors">
                            <i class="fas fa-user text-sm"></i>
                        </div>
                        <div class="min-w-0">
                            <div class="flex items-center gap-2">
                                <span class="font-semibold font-mono text-base tracking-wide shrink-0">{{ client.Code }}</span>
                                <span class="badge badge-xs badge-ghost font-mono opacity-80">{{ client.config_count }} cfg</span>
                            </div>
                            <p class="text-xs text-base-content/60 font-medium truncate max-w-[170px]" title="{{ client.Name }}">
                                {{ client.Name|default('No Name') }}
                            </p>
                        </div>
                    </div>

                    <!-- Status Badge -->
                    <div class="shrink-0">
                        {% if client.Func == 'PAUSE' %}
                            <span class="badge badge-info gap-1 badge-sm"><i class="fas fa-pause-circle text-[9px]"></i>Paused</span>
                        {% elseif client.ExpiryDate %}
                            {% if client.DaysLeft > 10 %}
                                <span class="badge badge-success gap-1 badge-sm"><i class="fas fa-calendar-check text-[9px]"></i>Active</span>
                            {% elseif client.DaysLeft > 0 %}
                                <span class="badge badge-warning gap-1 badge-sm animate-pulse"><i class="fas fa-exclamation-triangle text-[9px]"></i>Soon</span>
                            {% else %}
                                <span class="badge badge-error gap-1 badge-sm"><i class="fas fa-calendar-times text-[9px]"></i>Expired</span>
                            {% endif %}
                        {% else %}
                            <span class="badge badge-ghost badge-sm text-[10px]">No Sub</span>
                        {% endif %}
                    </div>
                </div>

                <!-- Structured Metrics Grid (2 columns x 2 rows) -->
                <div class="grid grid-cols-2 gap-2 mb-3 bg-base-300/40 border border-base-content/5 p-2.5 rounded-xl text-xs">
                    <!-- Metric 1: Subscription Expiry -->
                    <div class="flex flex-col justify-center">
                        <span class="text-[10px] text-base-content/40 uppercase font-semibold tracking-wider flex items-center gap-1">
                            <i class="fas fa-calendar-alt text-[9px] text-primary/70"></i>Subscription
                        </span>
                        <div class="mt-0.5 font-medium truncate">
                            {% if client.ExpiryDate %}
                                <span class="font-mono">{{ client.ExpiryDate }}</span>
                                <span class="text-[10px] text-base-content/50">({{ client.DaysLeft }}d)</span>
                            {% else %}
                                <span class="text-base-content/30 italic">Not set</span>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Metric 2: Latest Payment Info -->
                    <div class="flex flex-col justify-center">
                        <span class="text-[10px] text-base-content/40 uppercase font-semibold tracking-wider flex items-center gap-1">
                            <i class="fas fa-wallet text-[9px] text-emerald-400"></i>Latest Paid
                        </span>
                        <div class="mt-0.5 font-medium truncate">
                            {% if client.LastPaymentFormatted %}
                                <span class="text-emerald-400 font-semibold font-mono">{{ client.LastPaymentFormatted }}</span>
                                {% if client.LastPaymentDateFormatted %}
                                    <span class="text-[10px] text-base-content/50 font-mono">({{ client.LastPaymentDateFormatted }})</span>
                                {% endif %}
                            {% else %}
                                <span class="text-base-content/30 italic">No records</span>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Metric 3: Total Traffic -->
                    <div class="flex flex-col justify-center">
                        <span class="text-[10px] text-base-content/40 uppercase font-semibold tracking-wider flex items-center gap-1">
                            <i class="fas fa-exchange-alt text-[9px] text-info/70"></i>Traffic
                        </span>
                        <div class="mt-0.5 font-mono text-[11px] flex items-center gap-1">
                            <span class="text-info">↑{{ client.BytesSent|default(0)|format_bytes }}</span>
                            <span class="text-base-content/20">|</span>
                            <span class="text-indigo-400">↓{{ client.BytesReceived|default(0)|format_bytes }}</span>
                        </div>
                    </div>

                    <!-- Metric 4: Last Active -->
                    <div class="flex flex-col justify-center">
                        <span class="text-[10px] text-base-content/40 uppercase font-semibold tracking-wider flex items-center gap-1">
                            <i class="fas fa-bolt text-[9px] text-warning/70"></i>Last Active
                        </span>
                        <div class="mt-0.5">
                            <span class="{{ client.LastActiveClass }} text-[10px] px-1.5 py-0.5 rounded font-semibold">{{ client.LastActiveText }}</span>
                        </div>
                    </div>
                </div>

                <!-- Configs & Router Bar -->
                <div class="mb-4">
                    <div class="flex items-center justify-between mb-1.5">
                        <span class="text-[10px] text-base-content/40 uppercase font-semibold tracking-wider">Linked Configs</span>
                        {% if client.Router %}
                            <span class="badge badge-ghost badge-xs font-mono gap-1 text-[9px]" title="Router assigned"><i class="fas fa-network-wired text-[8px] opacity-75"></i>{{ client.Router }}</span>
                        {% endif %}
                    </div>

                    {% if client.configs is not empty %}
                    <div class="flex flex-wrap gap-1">
                        {% for cfg in client.configs|slice(0, 4) %}
                        <a href="/clients/{{ cfg.id }}" title="Server: {{ cfg.server_name }} | Last active: {{ cfg.last_active_text }}"
                           class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-base-300/80 hover:bg-base-300 text-xs border border-base-content/10 transition-colors">
                            <i class="fas fa-server text-[8px] text-base-content/30"></i>
                            <span class="font-mono text-[11px] truncate max-w-[90px]">{{ cfg.name }}</span>
                            {% if cfg.status != 'active' %}
                                <span class="w-1.5 h-1.5 rounded-full bg-base-content/20 shrink-0"></span>
                            {% elseif cfg.last_active_class == 'badge-active' %}
                                <span class="w-1.5 h-1.5 rounded-full bg-info shadow-[0_0_6px_rgba(56,189,248,0.6)] shrink-0"></span>
                            {% elseif cfg.last_active_class == 'badge-warning' %}
                                <span class="w-1.5 h-1.5 rounded-full bg-warning shrink-0"></span>
                            {% else %}
                                <span class="w-1.5 h-1.5 rounded-full bg-error shrink-0"></span>
                            {% endif %}
                        </a>
                        {% endfor %}
                        {% if client.config_count > 4 %}<span class="inline-flex items-center px-1.5 py-0.5 rounded bg-base-300/50 text-[10px] text-base-content/40 border border-base-content/5">+{{ client.config_count - 4 }}</span>{% endif %}
                    </div>
                    {% else %}
                    <p class="text-xs text-base-content/30 italic">No configs linked yet</p>
                    {% endif %}
                </div>

                <!-- Footer Actions -->
                <div class="card-actions border-t border-base-300 pt-3 flex items-center gap-2">
                    <a href="/clients?code={{ client.Code|url_encode }}" class="btn btn-ghost btn-sm flex-1 gap-1.5">
                        <i class="fas fa-eye text-xs"></i>All Configs
                    </a>
                    <button onclick="openCreateForClient('{{ client.Code|e('js') }}')" class="btn btn-outline btn-primary btn-sm flex-1 gap-1.5">
                        <i class="fas fa-plus text-xs"></i>New Config
                    </button>
                    <button onclick="openClientPaymentsModal('{{ client.Code|e('js') }}')" class="btn btn-ghost btn-sm btn-square text-emerald-400 hover:bg-emerald-500/10" title="View linked Finances transactions">
                        <i class="fas fa-receipt text-xs"></i>
                    </button>
                    {% if user.role == 'admin' %}
                    <button onclick="openEditClientModal('{{ client.Code|e('js') }}')" class="btn btn-ghost btn-sm btn-square text-info hover:bg-info/10 client-edit-btn hidden" title="Edit Client Record">
                        <i class="fas fa-edit text-xs"></i>
                    </button>
                    {% endif %}
                    
                    {% if client.router_id %}
                    <div class="dropdown dropdown-top dropdown-end">
                        <div tabindex="0" role="button" class="btn btn-ghost btn-sm btn-square"><i class="fas fa-ellipsis-v"></i></div>
                        <ul tabindex="0" class="dropdown-content menu menu-sm bg-base-300 rounded-box z-[10] w-44 p-1 shadow-xl border border-base-content/10 mb-1">
                            <li>
                                <button onclick="openPushDomainsModal({{ client.router_id }}, '{{ client.Router|default('Router')|escape('js') }}')" class="text-secondary gap-2">
                                    <i class="fas fa-route"></i>Push Domains
                                </button>
                            </li>
                        </ul>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
        {% endfor %}
    </div>

    <!-- ── TABLE VIEW (HIGH-DENSITY COMPACT MODE) ──────────────────────────── -->
    <div id="clientsTableView" class="card bg-base-200 border border-base-300 shadow overflow-x-auto mb-6 hidden">
        <table class="table table-zebra w-full text-xs">
            <thead>
                <tr class="bg-base-300/50 text-base-content/60 font-semibold uppercase text-[10px]">
                    <th>Client Code &amp; Name</th>
                    <th>Status &amp; Expiry</th>
                    <th>Latest Payment</th>
                    <th>Traffic (Up/Down)</th>
                    <th>Last Active</th>
                    <th>Configs</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for client in clients %}
                <tr class="hover:bg-base-300/30 transition-colors">
                    <!-- Client Code & Name -->
                    <td>
                        <div class="flex items-center gap-2.5">
                            <div class="w-7 h-7 rounded-lg bg-primary/10 text-primary flex items-center justify-center font-bold text-xs shrink-0">
                                <i class="fas fa-user text-[10px]"></i>
                            </div>
                            <div>
                                <div class="font-mono font-semibold text-sm">{{ client.Code }}</div>
                                <div class="text-base-content/50 text-[11px] truncate max-w-[140px]">{{ client.Name|default('No Name') }}</div>
                            </div>
                        </div>
                    </td>

                    <!-- Status & Expiry -->
                    <td>
                        {% if client.Func == 'PAUSE' %}
                            <span class="badge badge-info gap-1 badge-sm"><i class="fas fa-pause-circle text-[9px]"></i>Paused</span>
                        {% elseif client.ExpiryDate %}
                            {% if client.DaysLeft > 10 %}
                                <span class="badge badge-success gap-1 badge-sm"><i class="fas fa-calendar-check text-[9px]"></i>{{ client.ExpiryDate }} ({{ client.DaysLeft }}d)</span>
                            {% elseif client.DaysLeft > 0 %}
                                <span class="badge badge-warning gap-1 badge-sm"><i class="fas fa-exclamation-triangle text-[9px]"></i>{{ client.ExpiryDate }} ({{ client.DaysLeft }}d)</span>
                            {% else %}
                                <span class="badge badge-error gap-1 badge-sm"><i class="fas fa-calendar-times text-[9px]"></i>Expired {{ client.ExpiryDate }}</span>
                            {% endif %}
                        {% else %}
                            <span class="text-base-content/30 italic">No sub</span>
                        {% endif %}
                    </td>

                    <!-- Latest Payment -->
                    <td>
                        {% if client.LastPaymentFormatted %}
                            <div class="font-mono font-semibold text-emerald-400">{{ client.LastPaymentFormatted }}</div>
                            {% if client.LastPaymentDateFormatted %}<div class="text-[10px] text-base-content/40 font-mono">{{ client.LastPaymentDateFormatted }}</div>{% endif %}
                        {% else %}
                            <span class="text-base-content/30 italic">No payments</span>
                        {% endif %}
                    </td>

                    <!-- Traffic -->
                    <td class="font-mono">
                        <div class="text-info">↑{{ client.BytesSent|default(0)|format_bytes }}</div>
                        <div class="text-indigo-400">↓{{ client.BytesReceived|default(0)|format_bytes }}</div>
                    </td>

                    <!-- Last Active -->
                    <td>
                        <span class="{{ client.LastActiveClass }} text-[10px] px-1.5 py-0.5 rounded font-semibold whitespace-nowrap">{{ client.LastActiveText }}</span>
                    </td>

                    <!-- Configs -->
                    <td>
                        <div class="flex items-center gap-1">
                            <span class="badge badge-ghost badge-sm font-mono">{{ client.config_count }} cfg</span>
                            {% if client.Router %}
                                <span class="badge badge-ghost badge-xs font-mono text-[9px]" title="Router"><i class="fas fa-network-wired text-[8px] mr-1"></i>{{ client.Router }}</span>
                            {% endif %}
                        </div>
                    </td>

                    <!-- Actions -->
                    <td class="text-right">
                        <div class="flex items-center justify-end gap-1">
                            <a href="/clients?code={{ client.Code|url_encode }}" class="btn btn-ghost btn-xs gap-1" title="View configs"><i class="fas fa-eye"></i></a>
                            <button onclick="openCreateForClient('{{ client.Code|e('js') }}')" class="btn btn-ghost btn-xs text-primary gap-1" title="New config"><i class="fas fa-plus"></i></button>
                            <button onclick="openClientPaymentsModal('{{ client.Code|e('js') }}')" class="btn btn-ghost btn-xs text-emerald-400 hover:bg-emerald-500/10" title="View linked Payments"><i class="fas fa-receipt"></i></button>
                            {% if user.role == 'admin' %}
                            <button onclick="openEditClientModal('{{ client.Code|e('js') }}')" class="btn btn-ghost btn-xs text-info hover:bg-info/10 client-edit-btn hidden" title="Edit Client Record"><i class="fas fa-edit"></i></button>
                            {% endif %}
                            {% if client.router_id %}
                            <button onclick="openPushDomainsModal({{ client.router_id }}, '{{ client.Router|default('Router')|escape('js') }}')" class="btn btn-ghost btn-xs text-secondary gap-1" title="Push domains"><i class="fas fa-route"></i></button>
                            {% endif %}
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    {% if total_pages > 1 %}
    <div class="join flex justify-center flex-wrap gap-1 mt-8">
        {% if current_page > 1 %}
        <a href="/clients?search={{ search|url_encode }}&filter={{ filter }}&sort={{ sort }}&page={{ current_page - 1 }}" class="join-item btn btn-sm"><i class="fas fa-chevron-left"></i></a>
        {% endif %}

        {% set start_page = max(1, current_page - 2) %}
        {% set end_page = min(total_pages, current_page + 2) %}
        {% if end_page - start_page < 4 %}
            {% if start_page == 1 %}{% set end_page = min(total_pages, start_page + 4) %}{% else %}{% set start_page = max(1, end_page - 4) %}{% endif %}
        {% endif %}

        {% if start_page > 1 %}<a href="/clients?search={{ search|url_encode }}&filter={{ filter }}&sort={{ sort }}&page=1" class="join-item btn btn-sm font-mono">1</a>{% if start_page > 2 %}<span class="join-item btn btn-sm btn-disabled font-mono">...</span>{% endif %}{% endif %}

        {% for p in start_page..end_page %}
        <a href="/clients?search={{ search|url_encode }}&filter={{ filter }}&sort={{ sort }}&page={{ p }}" class="join-item btn btn-sm font-mono {% if p == current_page %}btn-active{% endif %}">{{ p }}</a>
        {% endfor %}

        {% if end_page < total_pages %}{% if end_page < total_pages - 1 %}<span class="join-item btn btn-sm btn-disabled font-mono">...</span>{% endif %}<a href="/clients?search={{ search|url_encode }}&filter={{ filter }}&sort={{ sort }}&page={{ total_pages }}" class="join-item btn btn-sm font-mono">{{ total_pages }}</a>{% endif %}

        {% if current_page < total_pages %}
        <a href="/clients?search={{ search|url_encode }}&filter={{ filter }}&sort={{ sort }}&page={{ current_page + 1 }}" class="join-item btn btn-sm"><i class="fas fa-chevron-right"></i></a>
        {% endif %}
    </div>
    {% endif %}
    {% endif %}

    <!-- Single-code filtered view -->
    {% if code_filter and code_configs is defined %}
    <div class="card bg-base-200 border border-base-300 shadow overflow-hidden mt-8">
        <div class="px-5 py-4 border-b border-base-300 flex items-center justify-between">
            <h2 class="font-semibold flex items-center gap-2">
                <i class="fas fa-list text-primary"></i>
                All configs for <code class="ml-1 font-mono text-primary">{{ code_filter }}</code>
            </h2>
            <a href="/clients" class="btn btn-ghost btn-xs gap-1"><i class="fas fa-times"></i>Clear filter</a>
        </div>
        {% if code_configs is empty %}
        <div class="p-10 text-center text-base-content/40 text-sm">No configs linked to this client yet.</div>
        {% else %}
        <div class="divide-y divide-base-300">
            {% for cfg in code_configs %}
            <div class="flex items-center gap-4 px-5 py-3 hover:bg-base-300/20 transition-colors">
                <div class="avatar avatar-placeholder">
                    <div class="bg-neutral text-neutral-content rounded-full w-7 text-xs"><span>{{ cfg.name|slice(0,1)|upper }}</span></div>
                </div>
                <div class="flex-1 min-w-0">
                    <span class="font-mono text-sm">{{ cfg.name }}</span>
                    <span class="ml-3 text-xs text-base-content/40">{{ cfg.server_name }}</span>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                    {% if cfg.status == 'active' %}
                        <span class="{{ cfg.last_active_class }} badge badge-sm">{{ cfg.last_active_text }}</span>
                    {% else %}
                        <span class="badge badge-ghost badge-sm">{{ cfg.status|capitalize }}</span>
                    {% endif %}
                    {% if cfg.router_id %}
                    <button onclick="event.preventDefault(); triggerRouterPush({{ cfg.router_id }}, {{ cfg.id }})" class="btn btn-ghost btn-xs gap-1 text-primary" title="Push config to router">
                        <i class="fas fa-upload"></i>Push
                    </button>
                    {% endif %}
                    <a href="/clients/{{ cfg.id }}" class="btn btn-ghost btn-xs gap-1"><i class="fas fa-eye"></i>View</a>
                </div>
            </div>
            {% endfor %}
        </div>
        {% endif %}
    </div>
    {% endif %}
</div>

<!-- Create Config for Client Modal -->
<dialog id="createForClientModal" class="modal">
    <div class="modal-box border border-base-300">
