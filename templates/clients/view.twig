{% extends "layout.twig" %}
{% block title %}Client: {{ client.name }}{% endblock %}

{% block content %}
<div class="w-full mx-auto max-w-5xl">
    <div class="mb-6 flex flex-col md:flex-row md:items-start justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-white flex items-center">
                <div class="w-10 h-10 rounded-lg bg-slate-700 text-accent flex items-center justify-center mr-3">
                    <i class="fas fa-user"></i>
                </div>
                {{ client.name }}
            </h1>
            <div class="mt-2 ml-13 flex flex-wrap items-center gap-3">
                <code class="text-xs text-slate-400 bg-slate-800 px-2 py-1 rounded">{{ client.client_ip }}</code>
                <span class="text-xs text-slate-500">
                    <i class="fas fa-calendar-alt mr-1"></i>{{ client.created_at|date('Y-m-d H:i') }}
                </span>
            </div>
        </div>
        <a href="/servers/{{ client.server_id }}" class="btn-secondary px-4 py-2 text-sm">
            <i class="fas fa-arrow-left mr-2"></i>Back to Server
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        <div class="panel p-5">
            <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-medium text-slate-500 uppercase tracking-wide">Uploaded</span>
                <i class="fas fa-arrow-up text-cyan-400 text-sm"></i>
            </div>
            <div class="text-2xl font-bold text-white font-mono">{{ (client.bytes_sent / 1024 / 1024)|number_format(2) }} <span class="text-xs text-slate-500">MB</span></div>
        </div>
        <div class="panel p-5">
            <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-medium text-slate-500 uppercase tracking-wide">Downloaded</span>
                <i class="fas fa-arrow-down text-blue-400 text-sm"></i>
            </div>
            <div class="text-2xl font-bold text-white font-mono">{{ (client.bytes_received / 1024 / 1024)|number_format(2) }} <span class="text-xs text-slate-500">MB</span></div>
        </div>
        <div class="panel p-5">
            <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-medium text-slate-500 uppercase tracking-wide">Last Handshake</span>
                <i class="fas fa-clock text-accent text-sm"></i>
            </div>
            <div class="text-lg font-medium text-white">
                {% if client.last_handshake %}
                    {{ client.last_handshake }}
                {% else %}
                    <span class="text-slate-500 italic">Never</span>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="panel p-5">
            <h3 class="text-base font-semibold mb-4 text-white flex items-center">
                <i class="fas fa-edit text-accent mr-2"></i>Client Settings
            </h3>
            
            <form method="POST" action="/clients/{{ client.id }}/update" class="mb-4">
                <label class="block text-xs font-medium text-slate-500 uppercase tracking-wide mb-2">Client Name</label>
                <div class="flex gap-2">
                    <input name="name" value="{{ client.name }}" class="input-field flex-grow px-4 py-2.5 text-sm" required>
                    <button type="submit" class="btn-primary px-4 py-2.5 text-sm">
                        <i class="fas fa-save mr-2"></i>Save
                    </button>
                </div>
            </form>

            <div class="border-t border-slate-700 pt-4">
                <label class="block text-xs font-medium text-slate-500 uppercase tracking-wide mb-2">Configuration</label>
                <div class="flex flex-wrap gap-2">
                    <a href="/clients/{{ client.id }}/download" class="btn-secondary px-4 py-2.5 text-sm flex-1 text-center">
                        <i class="fas fa-download mr-2"></i>Download Config
                    </a>
                    <button onclick="copyConfig()" id="copyBtn" class="btn-secondary px-4 py-2.5 text-sm flex-1 text-center">
                        <i class="fas fa-copy mr-2"></i>Copy Config
                    </button>
                </div>
            </div>
            <pre id="configData" class="hidden">{{ client.config }}</pre>
        </div>

        <div class="panel p-5">
            <h3 class="text-base font-semibold mb-4 text-white flex items-center">
                <i class="fas fa-cog text-accent mr-2"></i>Actions
            </h3>
            <div class="space-y-3">
                <button onclick="refreshClientStats()" id="refreshStatsBtn" class="btn-secondary w-full py-2.5 text-sm">
                    <i class="fas fa-sync-alt mr-2"></i>Sync Stats
                </button>
                
                {% if client.status != 'active' %}
                <form method="POST" action="/clients/{{ client.id }}/restore">
                    <button type="submit" class="w-full bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-400 border border-cyan-500/30 rounded-lg py-2.5 text-sm transition-colors font-medium">
                        <i class="fas fa-check mr-2"></i>Restore Client
                    </button>
                </form>
                {% endif %}

                <form method="POST" action="/clients/{{ client.id }}/delete" onsubmit="return confirm('Delete this client permanently?')">
                    <button type="submit" class="w-full bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/30 rounded-lg py-2.5 text-sm transition-colors font-medium">
                        <i class="fas fa-trash-alt mr-2"></i>Delete Client
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
function copyConfig() {
    const config = document.getElementById('configData').textContent;
    const btn = document.getElementById('copyBtn');
    const originalHtml = btn.innerHTML;
    
    const doFeedback = () => {
        btn.innerHTML = '<i class="fas fa-check mr-2"></i>Copied!';
        setTimeout(() => btn.innerHTML = originalHtml, 2000);
    };

    if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(config).then(doFeedback).catch(() => fallbackCopy(config, doFeedback));
    } else {
        fallbackCopy(config, doFeedback);
    }
}

function fallbackCopy(text, callback) {
    const textArea = document.createElement("textarea");
    textArea.value = text;
    textArea.style.cssText = 'position:fixed;left:-9999px;top:-9999px';
    document.body.appendChild(textArea);
    textArea.focus();
    textArea.select();
    try { document.execCommand('copy'); if (callback) callback(); }
    catch (err) { alert('Failed to copy. Please copy manually.'); }
    document.body.removeChild(textArea);
}

async function refreshClientStats() {
    const btn = document.getElementById('refreshStatsBtn');
    const clientId = {{ client.id }};
    const originalContent = btn.innerHTML;
    
    btn.innerHTML = '<i class="fas fa-sync-alt fa-spin mr-2"></i>Syncing...';
    btn.disabled = true;
    
    try {
        const response = await fetch(`/clients/${clientId}/sync-stats`, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
        const data = await response.json();
        if (data.success) location.reload();
        else {
            showToast('Failed to sync: ' + (data.error || 'Unknown error'), 'error');
            btn.innerHTML = originalContent;
            btn.disabled = false;
        }
    } catch (error) {
        showToast('Connection error', 'error');
        btn.innerHTML = originalContent;
        btn.disabled = false;
    }
}
</script>
{% endblock %}
