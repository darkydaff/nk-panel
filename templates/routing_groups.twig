{% extends 'layout.twig' %}

{% block title %}Routing Groups - {{ app_name }}{% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-8">
    <!-- Breadcrumbs -->
    <div class="text-sm breadcrumbs mb-6 text-base-content/60">
        <ul>
            <li><a href="/dashboard" class="hover:text-base-content transition-colors">Home</a></li>
            <li>Routing Groups</li>
        </ul>
    </div>

    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-extrabold tracking-tight text-base-content flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-primary to-secondary flex items-center justify-center text-white shadow-lg shadow-primary/20">
                    <i class="fas fa-route"></i>
                </div>
                Routing Groups
            </h1>
            <p class="text-base-content/60 mt-1">Manage domain lists and CIDR subnets to route through Keenetic VPN clients</p>
        </div>
    </div>

    <!-- Main Grid Layout -->
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-8">
        
        <!-- Left: List of Existing Groups (2 cols on large, 1 on small) -->
        <div class="xl:col-span-2 space-y-6">
            <div class="card bg-base-300 border border-base-content/5 shadow-xl">
                <div class="card-body p-6">
                    <h2 class="card-title text-lg font-bold flex items-center gap-2 mb-4">
                        <i class="fas fa-list text-primary"></i>
                        Active Groups
                        <span class="badge badge-primary badge-sm ml-2 font-mono">{{ groups|length }}</span>
                    </h2>

                    {% if groups is empty %}
                        <div class="text-center py-12 border-2 border-dashed border-base-content/10 rounded-2xl">
                            <div class="text-5xl text-base-content/20 mb-4">
                                <i class="fas fa-folder-open"></i>
                            </div>
                            <h3 class="text-lg font-bold text-base-content/70">No routing groups created yet</h3>
                            <p class="text-sm text-base-content/40 mt-1">Use the form on the right to add your first group.</p>
                        </div>
                    {% else %}
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            {% for g in groups %}
                                {% set items_count = g.content|split('\n')|filter(line => line|trim is not empty)|length %}
                                <div class="card bg-base-200 border border-base-content/5 hover:border-primary/30 hover:bg-base-100/50 transition-all duration-300 group shadow-md">
                                    <div class="card-body p-5 flex flex-col justify-between h-full">
                                        <div>
                                            <div class="flex items-start justify-between gap-2">
                                                <h3 class="font-bold text-base-content group-hover:text-primary transition-colors text-base truncate" title="{{ g.name }}">
                                                    {{ g.name }}
                                                </h3>
                                                <span class="badge badge-ghost font-mono text-xs">{{ items_count }} items</span>
                                            </div>
                                            
                                            <p class="text-xs text-base-content/50 mt-2 line-clamp-2 min-h-[32px]">
                                                {{ g.description ?: 'No description provided.' }}
                                            </p>
                                        </div>
                                        
                                        <div class="flex items-center justify-between gap-2 mt-4 pt-4 border-t border-base-content/5">
                                            <button onclick="editGroup({{ g|json_encode }})" class="btn btn-ghost btn-xs text-info gap-1 normal-case">
                                                <i class="fas fa-edit"></i> Edit
                                            </button>
                                            <button onclick="deleteGroup({{ g.id }}, '{{ g.name|escape('js') }}')" class="btn btn-ghost btn-xs text-error gap-1 normal-case">
                                                <i class="fas fa-trash-alt"></i> Delete
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Right: Create/Edit Form (1 col) -->
        <div class="space-y-6">
            <div class="card bg-base-300 border border-base-content/5 shadow-xl sticky top-6">
                <div class="card-body p-6">
                    <h2 id="formTitle" class="card-title text-lg font-bold flex items-center gap-2 mb-4">
                        <i class="fas fa-plus-circle text-success"></i>
                        <span>Create New Group</span>
                    </h2>

                    <form id="groupForm" onsubmit="saveGroup(event)" class="space-y-4">
                        <input type="hidden" id="groupId" name="id" value="">

                        <!-- Group Name -->
                        <div class="form-control">
                            <label class="label py-1">
                                <span class="label-text font-semibold text-xs tracking-wide uppercase text-base-content/60">Group Name</span>
                            </label>
                            <input type="text" id="groupName" name="name" required placeholder="e.g. Discord" 
                                   class="input input-bordered focus:input-primary w-full text-sm font-mono" 
                                   pattern="^[a-zA-Z0-9_\-]+$" title="Letters, numbers, dashes and underscores only.">
                        </div>

                        <!-- Description -->
                        <div class="form-control">
                            <label class="label py-1">
                                <span class="label-text font-semibold text-xs tracking-wide uppercase text-base-content/60">Description</span>
                            </label>
                            <input type="text" id="groupDescription" name="description" placeholder="e.g. Chat application servers" 
                                   class="input input-bordered focus:input-primary w-full text-sm">
                        </div>

                        <!-- Content List -->
                        <div class="form-control">
                            <label class="label py-1">
                                <span class="label-text font-semibold text-xs tracking-wide uppercase text-base-content/60">Domains & Subnets</span>
                                <span class="label-text-alt text-xs text-base-content/40">One per line</span>
                            </label>
                            <textarea id="groupContent" name="content" required rows="10" 
                                      placeholder="discord.gg&#10;discordapp.com&#10;149.154.164.0/22" 
                                      class="textarea textarea-bordered focus:textarea-primary w-full font-mono text-xs leading-relaxed"></textarea>
                        </div>

                        <!-- Form Actions -->
                        <div class="flex items-center gap-2 pt-2">
                            <button type="submit" id="submitBtn" class="btn btn-primary btn-sm flex-1 gap-2">
                                <i class="fas fa-save"></i> Save Group
                            </button>
                            <button type="button" id="cancelBtn" onclick="resetForm()" class="btn btn-ghost btn-sm gap-2 hidden">
                                Cancel
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        
    </div>
</div>

<script>
function editGroup(group) {
    document.getElementById('groupId').value = group.id;
    document.getElementById('groupName').value = group.name;
    document.getElementById('groupDescription').value = group.description || '';
    document.getElementById('groupContent').value = group.content || '';
    
    document.getElementById('formTitle').innerHTML = '<i class="fas fa-edit text-info"></i> Edit Group';
    document.getElementById('submitBtn').innerHTML = '<i class="fas fa-save"></i> Update Group';
    document.getElementById('cancelBtn').classList.remove('hidden');
    
    // Smooth scroll to form on mobile
    document.getElementById('groupForm').scrollIntoView({ behavior: 'smooth' });
}

function resetForm() {
    document.getElementById('groupId').value = '';
    document.getElementById('groupForm').reset();
    
    document.getElementById('formTitle').innerHTML = '<i class="fas fa-plus-circle text-success"></i> Create New Group';
    document.getElementById('submitBtn').innerHTML = '<i class="fas fa-save"></i> Save Group';
    document.getElementById('cancelBtn').classList.add('hidden');
}

async function saveGroup(event) {
    event.preventDefault();
    const submitBtn = document.getElementById('submitBtn');
    submitBtn.classList.add('loading');
    
    const formData = new FormData(event.target);
    
    try {
        const res = await fetch('/api/routing-groups', {
            method: 'POST',
            body: formData
        });
        const data = await res.json();
        
        if (data.success) {
            window.location.reload();
        } else {
            alert(data.error || 'Failed to save group');
        }
    } catch (e) {
        alert('Network error: ' + e.message);
    } finally {
        submitBtn.classList.remove('loading');
    }
}

async function deleteGroup(id, name) {
    if (!confirm(`Are you sure you want to delete the routing group "${name}"?`)) {
        return;
    }
    
    try {
        const res = await fetch(`/api/routing-groups/${id}/delete`, {
            method: 'POST'
        });
        const data = await res.json();
        
        if (data.success) {
            window.location.reload();
        } else {
            alert(data.error || 'Failed to delete group');
        }
    } catch (e) {
        alert('Network error: ' + e.message);
    }
}
</script>
{% endblock %}
