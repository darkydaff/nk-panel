{% extends 'layout.twig' %}
{% block title %}Router Management - {{ app_name }}{% endblock %}

{% block breadcrumbs %}
    <li><a href="/dashboard" class="hover:text-base-content transition-colors">Home</a></li>
    <li><span class="text-base-content/70">Routers</span></li>
{% endblock %}

{% block content %}
<div class="w-full">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
        <div>
            <h1 class="text-2xl font-bold flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-base-300 text-primary flex items-center justify-center shrink-0">
                    <i class="fas fa-network-wired"></i>
                </div>
                Keenetic Router Management
            </h1>
            <p class="text-xs text-base-content/40 mt-1 ml-13">Manage AmneziaWG connections on clients' Keenetic routers and run bulk status updates</p>
        </div>

        <div class="flex flex-wrap gap-2">
            <button onclick="triggerSync()" id="syncBtn" class="btn btn-primary btn-sm gap-2">
                <i class="fas fa-sync" id="syncIcon"></i>Sync from External DB
            </button>
            <button onclick="triggerCheckAll()" id="checkAllBtn" class="btn btn-ghost btn-sm gap-2">
                <i class="fas fa-wifi" id="checkAllIcon"></i>Check All Connections
            </button>
            <button onclick="triggerPushAll()" id="pushAllBtn" class="btn btn-success btn-sm gap-2">
                <i class="fas fa-upload" id="pushAllIcon"></i>Push All Pending
            </button>
        </div>
    </div>

    <!-- Routers Table -->
    <div class="card bg-base-200 border border-base-300 shadow overflow-hidden">
        <div class="overflow-x-auto">
            <table class="table table-sm w-full">
                <thead>
                    <tr>
                        <th>Client Code &amp; Name</th>
                        <th>Router Info</th>
                        <th>Domain / IP</th>
                        <th>Interface</th>
                        <th class="text-center">Status</th>
                        <th>Last Sync / Check</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% if routers is empty %}
                    <tr>
                        <td colspan="7" class="text-center py-10">
                            <div class="flex flex-col items-center gap-2">
                                <i class="fas fa-network-wired text-3xl text-base-content/10"></i>
                                <p class="text-base-content/40 text-sm">No routers synced yet. Press "Sync from External DB" to synchronize credentials from external PostgreSQL cache.</p>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                        {% for r in routers %}
                        <tr data-router-id="{{ r.id }}" class="hover">
                            <td>
                                <div class="flex flex-col">
                                    <a href="/clients?code={{ r.ext_client_code|url_encode }}" class="font-mono text-primary hover:text-primary/70 hover:underline text-xs tracking-wide">{{ r.ext_client_code }}</a>
                                    <span class="text-xs text-base-content/50 mt-0.5">{{ r.client_name|default('No Name') }}</span>
                                </div>
                            </td>
                            <td>
                                <div class="flex flex-col">
                                    <span class="text-xs router-model-text font-medium">{{ r.router_model|default('Keenetic (Generic)') }}</span>
                                     {% if r.firmware_version or r.last_ping_ms %}
                                         <div class="flex items-center gap-1.5 mt-0.5">
                                             {% if r.firmware_version %}
                                                 <span class="text-[10px] text-base-content/50 font-mono" title="OS Version">OS: {{ r.firmware_version }}</span>
                                             {% endif %}
                                             {% if r.last_ping_ms %}
                                                 {% set pingClass = r.last_ping_ms < 100 ? 'text-success' : (r.last_ping_ms < 160 ? 'text-warning' : 'text-error') %}
                                                 <span class="badge badge-ghost badge-xs font-mono text-[10px] gap-1" title="Ping from router to public server IP"><i class="fas fa-bolt text-[9px] {{ pingClass }}"></i> {{ r.last_ping_ms }}ms</span>
                                             {% elseif r.status == 'connected' %}
                                                 <span class="text-[10px] text-base-content/40 font-mono" title="ICMP ping blocked by server or unavailable">ping: n/a</span>
                                             {% endif %}
                                         </div>
                                     {% endif %}
                                </div>
                            </td>
                            <td>
                                <a href="{% if '://' in r.domain %}{{ r.domain }}{% else %}https://{{ r.domain }}{% endif %}" target="_blank"
                                   class="text-xs font-mono text-base-content/70 hover:text-base-content underline truncate max-w-[180px] block" title="{{ r.domain }}">{{ r.domain }}</a>
                            </td>
                            <td>
                                {% if r.wg_interface_id %}
                                    <span class="font-mono text-xs text-info">{{ r.wg_interface_id }}</span>
                                {% else %}
                                    <span class="text-base-content/30 text-xs italic">Not Pushed</span>
                                {% endif %}
                            </td>
                            <td class="text-center router-status-cell">
                                {% if r.status == 'connected' %}
                                    <span class="badge badge-success badge-sm">Connected</span>
                                {% elseif r.status == 'offline' %}
                                    <span class="badge badge-warning badge-sm" title="{{ r.error_message }}">Offline</span>
                                {% elseif r.status == 'error' %}
                                    <span class="badge badge-error badge-sm" title="{{ r.error_message }}">Error</span>
                                {% else %}
                                    <span class="badge badge-ghost badge-sm">Pending</span>
                                {% endif %}
                            </td>
                            <td class="text-xs font-mono text-base-content/50">
                                <div class="flex flex-col gap-0.5">
                                    <span title="Last push timestamp">P: {{ r.last_push_at|default('Never') }}</span>
                                    <span title="Last check timestamp">C: <span class="router-check-time-text">{{ r.last_check_at|default('Never') }}</span></span>
                                </div>
                            </td>
                            <td class="text-right">
                                <div class="flex items-center justify-end gap-1">
                                    <button onclick="pushConfig({{ r.id }})" class="btn btn-ghost btn-xs text-primary" title="Push configuration"><i class="fas fa-upload text-xs"></i></button>
                                    <button onclick="checkStatus({{ r.id }})" class="btn btn-ghost btn-xs text-info" title="Check status"><i class="fas fa-sync-alt text-xs"></i></button>
                                    <button onclick="editCredentials({{ r.id }}, '{{ r.domain|e('js') }}', '{{ r.login|default('admin')|e('js') }}')" class="btn btn-ghost btn-xs text-warning" title="Edit credentials"><i class="fas fa-key text-xs"></i></button>
                                    {% if r.wg_interface_id %}
                                    <button onclick="openPushDomainsModal({{ r.id }}, '{{ r.ext_client_code|escape('js') }}')" class="btn btn-ghost btn-xs text-secondary" title="Push routing groups"><i class="fas fa-route text-xs"></i></button>
                                    <button onclick="removeWg({{ r.id }})" class="btn btn-ghost btn-xs text-error" title="Remove interface"><i class="fas fa-trash-alt text-xs"></i></button>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
function triggerSync() {
    const btn = document.getElementById('syncBtn'); const icon = document.getElementById('syncIcon');
    if (btn.disabled) return;
    btn.disabled = true; icon.className = 'fas fa-spinner fa-spin';
    fetch('/api/routers/sync', { method: 'POST' }).then(r => r.json().then(data => ({ status: r.status, body: data })))
    .then(res => {
        if (res.status === 200 && res.body.success) { alert('Synchronization successful!\nSynced/updated ' + res.body.synced + ' router records.'); window.location.reload(); }
        else { alert('Synchronization failed: ' + (res.body.error || 'Unknown error')); btn.disabled = false; icon.className = 'fas fa-sync'; }
    }).catch(err => { alert('Network error: ' + err.message); btn.disabled = false; icon.className = 'fas fa-sync'; });
}

function triggerCheckAll() {
    const btn = document.getElementById('checkAllBtn'); const icon = document.getElementById('checkAllIcon');
    if (btn.disabled) return;
    btn.disabled = true; icon.className = 'fas fa-spinner fa-spin';
    const rows = document.querySelectorAll('tr[data-router-id]');
    const tasks = Array.from(rows).map(row => ({ id: row.getAttribute('data-router-id'), row }));
    if (tasks.length === 0) { btn.disabled = false; icon.className = 'fas fa-wifi'; return; }
    const concurrency = 6; let active = 0; let completed = 0; const total = tasks.length;

    function makeBadge(status, errMsg) {
        if (status === 'connected') return '<span class="badge badge-success badge-sm">Connected</span>';
        if (status === 'offline') return `<span class="badge badge-warning badge-sm" title="${errMsg || 'Offline'}">Offline</span>`;
        if (status === 'error') return `<span class="badge badge-error badge-sm" title="${errMsg || 'Error'}">Error</span>`;
        return '<span class="badge badge-ghost badge-sm">Pending</span>';
    }
    function runNext() {
        if (tasks.length === 0) { if (active === 0) { btn.disabled = false; icon.className = 'fas fa-wifi'; alert('Checked ' + total + ' routers successfully!'); } return; }
        const task = tasks.shift(); active++;
        const statusCell = task.row.querySelector('.router-status-cell');
        statusCell.innerHTML = '<span class="text-xs text-info font-medium flex items-center gap-1 justify-center"><i class="fas fa-spinner fa-spin"></i>Checking...</span>';
        fetch('/api/routers/' + task.id + '/check', { method: 'POST' }).then(r => r.json().then(d => ({ status: r.status, body: d })))
        .then(res => {
            if (res.status === 200 && res.body.success) {
                statusCell.innerHTML = makeBadge(res.body.status, res.body.error);
                const now = new Date(); const pad = n => String(n).padStart(2,'0');
                task.row.querySelector('.router-check-time-text').textContent = now.getFullYear()+'-'+pad(now.getMonth()+1)+'-'+pad(now.getDate())+' '+pad(now.getHours())+':'+pad(now.getMinutes())+':'+pad(now.getSeconds());
            } else statusCell.innerHTML = makeBadge('error', res.body.error);
        }).catch(() => statusCell.innerHTML = makeBadge('error', 'Network error')).finally(() => { active--; completed++; runNext(); });
    }
    for (let i = 0; i < Math.min(concurrency, tasks.length); i++) runNext();
}

function triggerPushAll() {
    if (!confirm('Are you sure you want to push configurations to all pending routers?')) return;
    const btn = document.getElementById('pushAllBtn'); const icon = document.getElementById('pushAllIcon');
    if (btn.disabled) return;
    const rows = document.querySelectorAll('tr[data-router-id]');
    const tasks = Array.from(rows).filter(row => row.querySelector('.router-status-cell').textContent.trim() === 'Pending').map(row => ({ id: row.getAttribute('data-router-id'), row }));
    if (tasks.length === 0) { alert('No pending routers found.'); return; }
    btn.disabled = true; icon.className = 'fas fa-spinner fa-spin';
    const concurrency = 4; let active = 0; const total = tasks.length;
    function runNext() {
        if (tasks.length === 0) { if (active === 0) { btn.disabled = false; icon.className = 'fas fa-upload'; alert('Finished configuration push to ' + total + ' routers. Reloading...'); window.location.reload(); } return; }
        const task = tasks.shift(); active++;
        const statusCell = task.row.querySelector('.router-status-cell');
        statusCell.innerHTML = '<span class="text-xs text-primary font-medium flex items-center gap-1 justify-center"><i class="fas fa-spinner fa-spin"></i>Pushing...</span>';
        fetch('/api/routers/' + task.id + '/push', { method: 'POST' }).then(r => r.json().then(d => ({ status: r.status, body: d })))
        .then(res => { statusCell.innerHTML = (res.status === 200 && res.body.success) ? '<span class="badge badge-success badge-sm">Connected</span>' : `<span class="badge badge-error badge-sm" title="${res.body.error || 'Push failed'}">Error</span>`; })
        .catch(() => { statusCell.innerHTML = '<span class="badge badge-error badge-sm" title="Network error">Error</span>'; })
        .finally(() => { active--; runNext(); });
    }
    for (let i = 0; i < Math.min(concurrency, tasks.length); i++) runNext();
}

function formatBytes(bytes) {
    if (bytes === 0) return '0 B';
    const k = 1024, sizes = ['B','KB','MB','GB','TB'], i = Math.floor(Math.log(bytes)/Math.log(k));
    return parseFloat((bytes/Math.pow(k,i)).toFixed(2)) + ' ' + sizes[i];
}

function pushConfig(routerId) {
    const btn = event.currentTarget; const icon = btn.querySelector('i'); const oldClass = icon.className;
    icon.className = 'fas fa-spinner fa-spin text-primary'; btn.disabled = true;
    fetch('/api/routers/' + routerId + '/configs').then(r => r.json())
    .then(data => {
        if (!data.configs || data.configs.length === 0) { alert("No active VPN configurations found for this router's client code."); icon.className = oldClass; btn.disabled = false; return; }
        if (data.configs.length === 1) {
            if (confirm('Push the configuration "' + data.configs[0].name + '" to this router?')) executePush(routerId, data.configs[0].id, btn, oldClass);
            else { icon.className = oldClass; btn.disabled = false; }
            return;
        }
        icon.className = oldClass; btn.disabled = false;
        document.getElementById('pushSelectorRouterId').value = routerId;
        const listDiv = document.getElementById('pushSelectorList');
        listDiv.innerHTML = '';
        data.configs.forEach(cfg => {
            const selectBtn = document.createElement('button');
            selectBtn.className = 'w-full text-left p-3.5 rounded-xl bg-base-300/40 hover:bg-primary/10 border border-base-content/10 hover:border-primary/30 transition-all flex items-center justify-between gap-4 mb-2';
            selectBtn.onclick = () => { closeModal('pushSelectorModal'); icon.className = 'fas fa-spinner fa-spin text-primary'; btn.disabled = true; executePush(routerId, cfg.id, btn, oldClass); };
            const totalTraffic = formatBytes(cfg.bytes_sent + cfg.bytes_received);
            selectBtn.innerHTML = `
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <span class="font-mono text-sm font-semibold">${cfg.name}</span>
                        <span class="text-xs text-base-content/40 font-mono">(${cfg.client_ip || 'No IP'})</span>
                    </div>
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] text-base-content/50 mt-1">
                        <span class="flex items-center gap-1"><i class="fas fa-server text-[10px]"></i> ${cfg.server_name}</span>
                        <span>|</span>
                        <span class="flex items-center gap-1"><i class="fas fa-chart-line text-[10px]"></i> ${totalTraffic}</span>
                        <span class="${cfg.last_active_class} text-[9px] px-1.5 py-0.5 rounded font-semibold">${cfg.last_active_text}</span>
                    </div>
                </div>
                <div class="shrink-0 w-7 h-7 rounded-full bg-base-300 flex items-center justify-center border border-base-content/10">
                    <i class="fas fa-chevron-right text-xs text-base-content/30"></i>
                </div>
            `;
            listDiv.appendChild(selectBtn);
        });
        openModal('pushSelectorModal');
    }).catch(err => { alert('Failed to load configs: ' + err.message); icon.className = oldClass; btn.disabled = false; });
}

function executePush(routerId, vpnClientId, btn, oldClass) {
    const row = document.querySelector('tr[data-router-id="' + routerId + '"]');
    let statusCell = row ? row.querySelector('.router-status-cell') : null;
    if (statusCell) statusCell.innerHTML = '<span class="text-xs text-primary font-medium flex items-center gap-1 justify-center"><i class="fas fa-spinner fa-spin"></i>Pushing...</span>';
    let url = '/api/routers/' + routerId + '/push' + (vpnClientId ? '?vpn_client_id=' + vpnClientId : '');
    fetch(url, { method: 'POST' }).then(r => r.json().then(d => ({ status: r.status, body: d })))
    .then(res => {
        if (res.status === 200 && res.body.success) { alert('Config pushed successfully!\nModel: ' + res.body.router_model + '\nInterface: ' + res.body.interface_id); window.location.reload(); }
        else {
            alert('Push failed: ' + (res.body.error || 'Unknown error'));
            if (btn && oldClass) { const icon = btn.querySelector('i'); if (icon) icon.className = oldClass; btn.disabled = false; }
            if (statusCell) statusCell.innerHTML = '<span class="badge badge-error badge-sm">Error</span>';
        }
    }).catch(err => {
        alert('Network error: ' + err.message);
        if (btn && oldClass) { const icon = btn.querySelector('i'); if (icon) icon.className = oldClass; btn.disabled = false; }
        if (statusCell) statusCell.innerHTML = '<span class="badge badge-error badge-sm">Error</span>';
    });
}

function checkStatus(routerId) {
    const btn = event.currentTarget; const icon = btn.querySelector('i'); const oldClass = icon.className;
    icon.className = 'fas fa-spinner fa-spin text-info'; btn.disabled = true;
    const row = btn.closest('tr[data-router-id]');
    fetch('/api/routers/' + routerId + '/check', { method: 'POST' }).then(r => r.json().then(d => ({ status: r.status, body: d })))
    .then(res => {
        if (res.status === 200 && res.body.success) {
            if (row) {
                let badge = '';
                if (res.body.status === 'connected') badge = '<span class="badge badge-success badge-sm">Connected</span>';
                else if (res.body.status === 'offline') badge = `<span class="badge badge-warning badge-sm" title="${res.body.error || 'Offline'}">Offline</span>`;
                else if (res.body.status === 'error') badge = `<span class="badge badge-error badge-sm" title="${res.body.error || 'Error'}">Error</span>`;
                else badge = '<span class="badge badge-ghost badge-sm">Pending</span>';
                row.querySelector('.router-status-cell').innerHTML = badge;
                const now = new Date(); const pad = n => String(n).padStart(2,'0');
                row.querySelector('.router-check-time-text').textContent = now.getFullYear()+'-'+pad(now.getMonth()+1)+'-'+pad(now.getDate())+' '+pad(now.getHours())+':'+pad(now.getMinutes())+':'+pad(now.getSeconds());
            } else window.location.reload();
        } else alert('Check failed: ' + (res.body.error || 'Unknown error'));
    }).catch(err => alert('Network error: ' + err.message)).finally(() => { icon.className = oldClass; btn.disabled = false; });
}

function removeWg(routerId) {
    if (!confirm('Are you sure you want to remove the WireGuard interface from the router? This will delete the interface and NAT settings on the router.')) return;
    const btn = event.currentTarget; const icon = btn.querySelector('i'); const oldClass = icon.className;
    icon.className = 'fas fa-spinner fa-spin text-error'; btn.disabled = true;
    fetch('/api/routers/' + routerId + '/remove-wg', { method: 'POST' }).then(r => r.json().then(d => ({ status: r.status, body: d })))
    .then(res => {
        if (res.status === 200 && res.body.success) { alert('Interface removed successfully!'); window.location.reload(); }
        else { alert('Removal failed: ' + (res.body.error || 'Unknown error')); icon.className = oldClass; btn.disabled = false; }
    }).catch(err => { alert('Network error: ' + err.message); icon.className = oldClass; btn.disabled = false; });
}

function editCredentials(routerId, domain, login) {
    document.getElementById('credRouterId').value = routerId;
    document.getElementById('credDomain').value = domain;
    document.getElementById('credLogin').value = login;
    document.getElementById('credPassword').value = '';
    openModal('credentialsModal');
}

function submitCredentials(e) {
    e.preventDefault();
    const routerId = document.getElementById('credRouterId').value;
    const domain = document.getElementById('credDomain').value;
    const login = document.getElementById('credLogin').value;
    const password = document.getElementById('credPassword').value;
    const btn = document.getElementById('credSubmitBtn');
    btn.disabled = true; const oldHtml = btn.innerHTML;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Saving...';
    fetch('/api/routers/' + routerId + '/credentials', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ domain, login, password }) })
    .then(r => r.json().then(d => ({ status: r.status, body: d })))
    .then(res => {
        if (res.status === 200 && res.body.success) { alert('Credentials updated successfully!'); window.location.reload(); }
        else { alert('Failed to update credentials: ' + (res.body.error || 'Unknown error')); btn.disabled = false; btn.innerHTML = oldHtml; }
    }).catch(err => { alert('Network error: ' + err.message); btn.disabled = false; btn.innerHTML = oldHtml; });
}

function openModal(id) { document.getElementById(id).showModal(); }
function closeModal(id) { document.getElementById(id).close(); }
</script>

<!-- Edit Credentials Modal -->
<dialog id="credentialsModal" class="modal">
    <div class="modal-box border border-base-300">
        <div class="flex items-center justify-between mb-5">
            <h3 class="font-semibold flex items-center gap-2"><i class="fas fa-key text-warning"></i>Edit Router Credentials</h3>
            <button onclick="closeModal('credentialsModal')" class="btn btn-ghost btn-xs btn-circle"><i class="fas fa-times"></i></button>
        </div>
        <form method="POST" id="credentialsForm" onsubmit="submitCredentials(event)" class="space-y-4">
            <input type="hidden" id="credRouterId">
            <div class="form-control">
                <label class="label py-1"><span class="label-text text-xs font-medium uppercase tracking-wide text-base-content/50">Domain / IP</span></label>
                <input type="text" id="credDomain" required class="input input-bordered" placeholder="e.g. router.example.link or 192.168.1.1">
            </div>
            <div class="form-control">
                <label class="label py-1"><span class="label-text text-xs font-medium uppercase tracking-wide text-base-content/50">Login Username</span></label>
                <input type="text" id="credLogin" required class="input input-bordered" placeholder="admin">
            </div>
            <div class="form-control">
                <label class="label py-1"><span class="label-text text-xs font-medium uppercase tracking-wide text-base-content/50">Password</span></label>
                <input type="password" id="credPassword" class="input input-bordered" placeholder="•••••••• (leave blank to keep current)">
            </div>
            <div class="modal-action pt-2">
                <button type="button" onclick="closeModal('credentialsModal')" class="btn btn-ghost btn-sm">Cancel</button>
                <button type="submit" class="btn btn-primary btn-sm gap-2" id="credSubmitBtn"><i class="fas fa-save"></i>Save Settings</button>
            </div>
        </form>
    </div>
    <form method="dialog" class="modal-backdrop"><button onclick="closeModal('credentialsModal')">close</button></form>
</dialog>

<!-- Push Config Selector Modal -->
<dialog id="pushSelectorModal" class="modal">
    <div class="modal-box border border-base-300">
        <div class="flex items-center justify-between mb-5">
            <h3 class="font-semibold flex items-center gap-2"><i class="fas fa-upload text-primary"></i>Select Config to Push</h3>
            <button onclick="closeModal('pushSelectorModal')" class="btn btn-ghost btn-xs btn-circle"><i class="fas fa-times"></i></button>
        </div>
        <input type="hidden" id="pushSelectorRouterId">
        <div id="pushSelectorList" class="space-y-2 max-h-60 overflow-y-auto pr-1"></div>
        <div class="modal-action border-t border-base-300 pt-4 mt-4">
            <button type="button" onclick="closeModal('pushSelectorModal')" class="btn btn-ghost btn-sm">Cancel</button>
        </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button onclick="closeModal('pushSelectorModal')">close</button></form>
</dialog>

{% include 'push_domains_modal.twig' %}
{% endblock %}
